<%#
  Portal shell: collapsible sidebar + top bar (behaviour in public/portal/shell.js, styles in shell.css).
  Locals: I (icon SVG paths), basePath.
%>
<aside class="sb" id="sb" aria-label="Main menu">
  <button type="button" class="sb-brand" aria-label="PerfX Studio — Home">
    <span class="sb-logo"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12z"/></svg></span>
    <span class="sb-brand-text"><span class="sb-brand-name">PerfX Studio</span><span class="sb-brand-sub">Performance engineering toolkit</span></span>
  </button>

  <nav class="sb-nav">
    <button type="button" class="sb-item" data-page="home" data-tab="home" style="--c:var(--c-home)">
      <span class="sb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- I.home %></svg></span>
      <span class="sb-txt"><span class="sb-label">Home</span><span class="sb-sub">Start here</span></span>
    </button>

    <div class="sb-group">Create scripts</div><div class="sb-group-line" aria-hidden="true"></div>
    <button type="button" class="sb-item" data-page="record" data-tab="recorder" style="--c:var(--c-record)">
      <span class="sb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- I.record %></svg></span>
      <span class="sb-txt"><span class="sb-label">Recorder</span><span class="sb-sub">Browser recording → script</span></span>
      <span class="sb-badge" id="sb-rec-badge" hidden>Running</span>
    </button>
    <button type="button" class="sb-item" data-page="studio" data-tab="studio" style="--c:var(--c-studio)">
      <span class="sb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- I.link %></svg></span>
      <span class="sb-txt"><span class="sb-label">Script Studio</span><span class="sb-sub">Automatic correlation</span></span>
    </button>
    <button type="button" class="sb-item" data-page="postman" data-tab="converter" style="--c:var(--c-convert)">
      <span class="sb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- I.api %></svg></span>
      <span class="sb-txt"><span class="sb-label">Postman / Bruno</span><span class="sb-sub">API collection → script</span></span>
    </button>
    <button type="button" class="sb-item" data-page="jmeter" data-tab="converter" style="--c:var(--c-jmeter)">
      <span class="sb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- I.migrate %></svg></span>
      <span class="sb-txt"><span class="sb-label">JMeter</span><span class="sb-sub">.jmx test plan → script</span></span>
    </button>

    <div class="sb-group">Analyse</div><div class="sb-group-line" aria-hidden="true"></div>
    <button type="button" class="sb-item" data-page="results" data-tab="analyser" style="--c:var(--c-results)">
      <span class="sb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- I.chart %></svg></span>
      <span class="sb-txt"><span class="sb-label">Results Analyser</span><span class="sb-sub">LRE run → reports</span></span>
    </button>

    <div class="sb-group">Learn</div><div class="sb-group-line" aria-hidden="true"></div>
    <button type="button" class="sb-item" data-page="help" data-tab="help" style="--c:var(--c-help)">
      <span class="sb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- I.book %></svg></span>
      <span class="sb-txt"><span class="sb-label">Help &amp; guides</span><span class="sb-sub">Step-by-step, glossary, FAQ</span></span>
      <span class="sb-chev" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
    </button>
    <!-- Help sections (built by portal/help.js from the Help page) — shown while Help is open -->
    <div class="sb-subnav" id="sb-help-nav" role="navigation" aria-label="Help sections" hidden></div>
  </nav>

  <div class="sb-foot">
    <div class="sb-note" title="Server status: live. Converter files are processed in memory and deleted after download; the other tools work in your browser.">
      <i class="sb-status-dot" aria-hidden="true"></i><span>Live · files never stored</span>
    </div>
    <button class="sb-item sb-collapse" type="button" aria-controls="sb" title="Collapse or expand the menu (Ctrl+B)">
      <span class="sb-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg></span>
      <span class="sb-txt"><span class="sb-label">Collapse menu</span></span>
    </button>
  </div>
</aside>
<div class="sb-scrim" aria-hidden="true"></div>

<header class="tb">
  <button class="tb-btn icon tb-menu" id="tb-menu" type="button" aria-label="Open menu">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <div class="tb-title">
    <span class="sb-ico" id="tb-ico" aria-hidden="true"></span>
    <div class="tb-title-text"><span class="tb-crumb" id="tb-crumb">PerfX Studio</span><div class="tb-name" id="tb-name" role="heading" aria-level="2">Home</div></div>
  </div>
  <div class="tb-actions">
    <button class="tb-btn tb-search" id="tb-search" type="button" title="Search tools, Help and questions (Ctrl+K)" aria-keyshortcuts="Control+K Meta+K">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <span class="tb-search-t">Search</span><kbd>Ctrl K</kbd>
    </button>
    <button class="tb-btn" id="tb-help" type="button" title="Open the Help section for this page">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6"/><path d="M12 17h.01"/></svg>
      How it works
    </button>
    <button class="tb-btn" id="btn-global-clear" type="button" onclick="globalClear()" title="Clear all inputs and reset this tool" style="display:none">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
      Clear
    </button>
    <button class="tb-btn icon tb-theme" id="tb-theme" type="button" title="Light / dark theme" aria-label="Switch between light and dark theme">
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</header>
