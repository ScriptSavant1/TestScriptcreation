<%#
  Postman / Bruno and JMeter converter panels (portal v3 design). Behaviour lives in index.ejs
  (setProto, setMode, onPick, doConvert, doConvertJmx …) and public/portal/converter.js; styles in
  public/portal/converter.css (scoped to #portal-converter).
  Every element id, handler and class the converter functions use is kept — the converter golden
  harness checks that the requests sent and the results are identical.
%>
<%
  const svg = (d, extra) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"${extra || ''}>${d}</svg>`;
  const IC = {
    upload: '<path d="M12 15V3"/><path d="m7 8 5-5 5 5"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/>',
    key: '<circle cx="8" cy="15" r="4"/><path d="m10.8 12.2 8.2-8.2M17 6l2 2M14 9l2 2"/>',
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>',
    table: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 4v16"/>',
    lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
    check: '<path d="M20 6 9 17l-5-5"/>',
    x: '<path d="M18 6 6 18M6 6l12 12"/>',
    down: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/>',
    back: '<path d="M9 14 4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-1"/>',
    search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
    gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
    chevron: '<path d="m6 9 6 6 6-6"/>',
  };
  const protoCard = (id, fn, cls, letter, name, desc, tagCls, tag) => `
    <div class="proto-card${cls}" id="${id}" onclick="${fn}" role="radio" tabindex="0">
      <div class="proto-icon">${letter}</div>
      <div>
        <div class="proto-name">${name}</div>
        <div class="proto-desc">${desc}</div>
        <span class="proto-tag ${tagCls}">${tag}</span>
      </div>
      <span class="proto-check" aria-hidden="true">${svg(IC.check)}</span>
    </div>`;
%>
<div id="portal-converter" style="display:none" class="portal-content-panel">

<!-- ── Converter Hero (shown only outside the portal shell; the shell's top bar names the page) ── -->
<header class="hero" style="text-align:center;padding:36px 0 24px">
  <div style="display:inline-flex;align-items:center;gap:8px;padding:5px 14px;border-radius:99px;margin-bottom:14px;background:var(--primary-dim);border:1px solid rgba(79,142,247,0.28);color:var(--primary);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase">
    ⚡ PerfX Studio — Converter
  </div>
  <p class="hero-sub" style="font-size:15px;margin-bottom:16px">Convert Postman/Bruno collections or JMeter scripts (.jmx) into production-ready LoadRunner VuGen scripts in seconds. Switch tabs below to select your input type.</p>
  <div class="hero-badges">
    <span class="chip">📂 Postman / Bruno</span>
    <span class="chip">♨ JMeter .jmx</span>
    <span class="chip">🟦 DevWeb JS</span>
    <span class="chip">🟧 VuGen C</span>
    <span class="chip">🔒 In-memory only</span>
  </div>
</header>

<!-- ── Tab bar (the sidebar's Postman / JMeter items do this inside the shell) ── -->
<div class="tab-bar">
  <button class="tab-btn active-bruno" id="tab-bruno" onclick="switchTab('bruno')">
    <span class="tab-icon">📂</span> Postman / Bruno
  </button>
  <button class="tab-btn" id="tab-jmx" onclick="switchTab('jmx')">
    <span class="tab-icon">♨</span> JMeter (.jmx)
  </button>
</div>

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- Panel: Postman / Bruno                                                 -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div class="card cv-panel" id="panel-bruno" style="--c:var(--c-convert)">
 <div class="cv-cols">
 <div class="cv-main">
  <p class="cv-intro">Upload a Postman or Bruno collection — and, if you have one, its environment file. You get a ready-to-run DevWeb or VuGen Web HTTP/HTML script as a ZIP, with correlation, parameters and authentication handled.</p>

  <!-- 1 · Protocol -->
  <div class="section-label"><span class="section-num">1</span>Choose Output Protocol</div>
  <div class="proto-grid" role="radiogroup" aria-label="Output protocol">
    <%- protoCard('pc-devweb', "setProto('devweb')", ' active-devweb', 'JS', 'DevWeb · JavaScript', 'Modern JS protocol for LRE. Generates <strong>main.js</strong> with per-request transactions, correlations, JWT helper &amp; full config files.', 'tag-js', 'main.js') %>
    <%- protoCard('pc-vugen', "setProto('web-http')", '', 'C', 'VuGen · Web HTTP/HTML (C)', 'Classic C-based VuGen protocol. Generates <strong>Action.c</strong> with web_custom_request, NTLM/Kerberos, jsrsasign &amp; all VuGen config.', 'tag-c', 'Action.c') %>
  </div>

  <!-- 2 · Upload -->
  <div class="section-label"><span class="section-num">2</span>Upload Files</div>
  <div class="upload-grid">
    <div class="drop-zone" id="dz-col"
         ondragover="onDrag(event,'dz-col')" ondragleave="offDrag('dz-col')"
         ondrop="onDrop(event,'dz-col','collection')">
      <input type="file" id="fi-col" accept=".json,.yml,.yaml,.bru" aria-label="Collection file (required)"
             onchange="onPick('dz-col','fi-col','lbl-col','collection')">
      <div class="dz-icon-wrap"><%- svg(IC.upload) %></div>
      <div class="dz-label">Collection File <span class="dz-required">*</span></div>
      <div class="dz-sub">Postman v2.1 JSON &nbsp;·&nbsp; Bruno JSON / YAML &nbsp;·&nbsp; .bru</div>
      <div id="lbl-col" class="dz-name"></div>
    </div>
    <div class="drop-zone" id="dz-env"
         ondragover="onDrag(event,'dz-env')" ondragleave="offDrag('dz-env')"
         ondrop="onDrop(event,'dz-env','environment')">
      <input type="file" id="fi-env" accept=".json,.bru" aria-label="Environment file (optional)"
             onchange="onPick('dz-env','fi-env','lbl-env','environment')">
      <div class="dz-icon-wrap"><%- svg(IC.key) %></div>
      <div class="dz-label">Environment File</div>
      <div class="dz-sub">Postman environment JSON &nbsp;·&nbsp; Bruno .bru vars</div>
      <span class="dz-opt">Optional — provides variable values</span>
      <div id="lbl-env" class="dz-name"></div>
    </div>
  </div>

  <!-- 2b · Client Certificates -->
  <div class="cert-zone-wrap">
    <div class="cert-zone-header">
      <span class="cert-zone-title"><%- svg(IC.shield, ' class="cz-ico"') %> Client Certificates</span>
      <span class="cert-zone-badge">Optional — mutual TLS authentication</span>
    </div>
    <div class="drop-zone dz-secondary dz-cert-full" id="dz-bru-cert"
         ondragover="onDrag(event,'dz-bru-cert')" ondragleave="offDrag('dz-bru-cert')"
         ondrop="onDropBrunoCert(event)">
      <input type="file" id="fi-bru-cert" accept=".p12,.pem,.key" multiple aria-label="Client certificate files (optional)"
             onchange="onPickBrunoCert()">
      <div class="dz-icon-wrap"><%- svg(IC.shield) %></div>
      <div class="cert-zone-body">
        <div class="dz-label">
          Drop certificate files here
          <span class="dz-or">&nbsp;or click to browse</span>
        </div>
        <div class="dz-sub">.p12 (PKCS12) &nbsp;·&nbsp; .pem (certificate) &nbsp;·&nbsp; .key (private key) &nbsp;·&nbsp; multiple files supported</div>
        <div id="bru-cert-chips" class="cert-chip-list"></div>
        <div id="bru-cert-hint" class="cert-add-hint" style="display:none">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
          Click or drag to add more certificates
        </div>
      </div>
    </div>
  </div>

  </div><!-- /.cv-main -->
 <div class="cv-side">
  <!-- 3 · Options -->
  <div class="section-label"><span class="section-num">3</span>Configure Options</div>
  <div class="options-grid">
    <div class="opt-group">
      <span class="opt-label">Script Mode</span>
      <div class="seg-btns" role="group" aria-label="Script mode">
        <button class="seg-btn active" id="m-single" onclick="setMode('single')">Single</button>
        <button class="seg-btn"        id="m-multi"  onclick="setMode('multi')">Multi-Script</button>
      </div>
    </div>
    <div class="opt-group">
      <span class="opt-label">Think Time</span>
      <div class="seg-btns" role="group" aria-label="Think time">
        <button class="seg-btn active" id="tt-1" onclick="setTT(1)">1s</button>
        <button class="seg-btn"        id="tt-2" onclick="setTT(2)">2s</button>
        <button class="seg-btn"        id="tt-3" onclick="setTT(3)">3s</button>
        <button class="seg-btn"        id="tt-5" onclick="setTT(5)">5s</button>
      </div>
    </div>
    <div class="opt-group">
      <span class="opt-label">Log Level</span>
      <div class="seg-btns" role="group" aria-label="Log level">
        <button class="seg-btn active" id="ll-info"  onclick="setLL('info')">Info</button>
        <button class="seg-btn"        id="ll-debug" onclick="setLL('debug')">Debug</button>
      </div>
    </div>
  </div>

  <div class="divider"></div>
  <div class="prog-wrap" id="prog-wrap"><div class="prog-fill" id="prog-fill"></div></div>
  <button class="btn-convert devweb" id="btn-cvt" onclick="doConvert()">
    <div class="spinner" id="spinner"></div>
    <span id="btn-lbl">Convert to DevWeb Script</span>
  </button>
  <!-- Advanced -->
  <button class="adv-toggle" id="adv-btn" onclick="toggleAdv()" aria-controls="adv-panel">
    <span class="arrow"><%- svg(IC.chevron) %></span> Advanced settings
    <small class="adv-hint">correlation · parameters · authentication · comments</small>
  </button>
  <div class="adv-panel" id="adv-panel">
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Correlation Detection</div>
        <div class="tgl-sub">Extract dynamic values from API responses — access_token, userId, sessionId, CSRF tokens</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-corr" checked aria-label="Correlation Detection"><span class="slider"></span></label>
    </div>
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Parameterization</div>
        <div class="tgl-sub">Convert static variables into CSV parameters — baseUrl, clientId, API keys</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-param" checked aria-label="Parameterization"><span class="slider"></span></label>
    </div>
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Authentication Handling</div>
        <div class="tgl-sub">OAuth2, Bearer (dynamic-aware), Basic, API Key, JWT (PS256 / RS256 / HS256), AWS Sig v4</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-auth" checked aria-label="Authentication Handling"><span class="slider"></span></label>
    </div>
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Add Code Comments</div>
        <div class="tgl-sub">Inline explanatory comments in the generated script to guide manual review</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-cmt" checked aria-label="Add Code Comments"><span class="slider"></span></label>
    </div>
  </div>

 </div><!-- /.cv-side -->
 </div><!-- /.cv-cols -->
</div>

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- Panel: JMeter                                                          -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div class="card cv-panel" id="panel-jmx" style="display:none;--c:var(--c-jmeter)">
 <div class="cv-cols">
 <div class="cv-main">
  <p class="cv-intro">Upload a JMeter test plan (.jmx), plus any CSV data files and certificates it uses. You get a DevWeb or VuGen Web HTTP/HTML script — one per thread group if you choose — and a Workload Model Excel, as a ZIP.</p>

  <!-- 1 · Protocol -->
  <div class="section-label"><span class="section-num">1</span>Choose Output Protocol</div>
  <div class="proto-grid" role="radiogroup" aria-label="Output protocol">
    <%- protoCard('jpc-devweb', "setJmxProto('devweb')", ' active-devweb', 'JS', 'DevWeb · JavaScript', 'Generates <strong>main.js</strong> with transactions, correlations, auth &amp; Workload Model Excel.', 'tag-js', 'main.js') %>
    <%- protoCard('jpc-vugen', "setJmxProto('web-http')", '', 'C', 'VuGen · Web HTTP/HTML (C)', 'Generates <strong>Action.c</strong> with web_reg_save_param, NTLM/Kerberos auth &amp; Workload Model Excel.', 'tag-c', 'Action.c') %>
  </div>

  <!-- 2 · Upload -->
  <div class="section-label"><span class="section-num">2</span>Upload JMeter Script</div>
  <div class="upload-grid cv-jmx-grid">
    <div class="drop-zone" id="dz-jmx"
         ondragover="onDrag(event,'dz-jmx')" ondragleave="offDrag('dz-jmx')"
         ondrop="onDropJmx(event)">
      <input type="file" id="fi-jmx" accept=".jmx" onchange="onPickJmx()" aria-label="JMeter script (.jmx, required)">
      <div class="dz-icon-wrap"><%- svg(IC.upload) %></div>
      <div class="dz-label">JMeter Script <span class="dz-required">*</span></div>
      <div class="dz-sub">.jmx file — JMeter Test Plan</div>
      <div id="lbl-jmx" class="dz-name"></div>
    </div>
  </div>

  <!-- Supporting files -->
  <div class="upload-grid cv-support-grid">
    <div class="drop-zone dz-secondary" id="dz-csv"
         ondragover="onDrag(event,'dz-csv')" ondragleave="offDrag('dz-csv')"
         ondrop="onDropCsv(event)">
      <input type="file" id="fi-csv" accept=".csv" multiple onchange="onPickCsv()" aria-label="CSV data files (optional)">
      <div class="dz-icon-wrap"><%- svg(IC.table) %></div>
      <div class="dz-label">CSV Data Files <span class="dz-or">(optional)</span></div>
      <div class="dz-sub">Multiple .csv files — added to output ZIP</div>
      <div id="lbl-csv" class="dz-name"></div>
    </div>
    <div class="drop-zone dz-secondary" id="dz-cert"
         ondragover="onDrag(event,'dz-cert')" ondragleave="offDrag('dz-cert')"
         ondrop="onDropCert(event)">
      <input type="file" id="fi-cert" accept=".jks,.p12,.cer,.crt,.key,.pem,.pfx" multiple onchange="onPickCert()" aria-label="Certificate files (optional)">
      <div class="dz-icon-wrap"><%- svg(IC.lock) %></div>
      <div class="dz-label">Certificate Files <span class="dz-or">(optional)</span></div>
      <div class="dz-sub">.jks .p12 .cer .crt .key .pem .pfx</div>
      <div id="lbl-cert" class="dz-name"></div>
    </div>
  </div>

  <!-- What gets generated -->
  <div class="jmx-features">
    <div class="jmx-feat-title">What gets generated</div>
    <div class="feat-item"><span class="feat-check"><%- svg(IC.check) %></span>DevWeb JS or VuGen C script per thread group</div>
    <div class="feat-item"><span class="feat-check"><%- svg(IC.check) %></span>Regex / JSON / Boundary / XPath / CSS extractors</div>
    <div class="feat-item"><span class="feat-check"><%- svg(IC.check) %></span>Global + per-request headers correctly scoped</div>
    <div class="feat-item"><span class="feat-check"><%- svg(IC.check) %></span>Loop / If / ForEach controller context preserved</div>
    <div class="feat-item"><span class="feat-check"><%- svg(IC.check) %></span>CSV parameter files + dependency report</div>
    <div class="feat-item"><span class="feat-check"><%- svg(IC.check) %></span><strong>Workload Model Excel (.xlsx)</strong></div>
  </div>

  </div><!-- /.cv-main -->
 <div class="cv-side">
  <!-- 3 · Options -->
  <div class="section-label"><span class="section-num">3</span>Configure Options</div>
  <div class="options-grid">
    <div class="opt-group">
      <span class="opt-label">Script Generation Mode</span>
      <div class="seg-btns" role="group" aria-label="Script generation mode">
        <button class="seg-btn active" id="jmode-single" onclick="setJmxMode('single')">Single Script</button>
        <button class="seg-btn"        id="jmode-multi"  onclick="setJmxMode('multi')">Per Thread Group</button>
      </div>
    </div>
    <div class="opt-group">
      <span class="opt-label">Think Time</span>
      <div class="seg-btns" role="group" aria-label="Think time">
        <button class="seg-btn active" id="jtt-1" onclick="setJmxTT(1)">1s</button>
        <button class="seg-btn"        id="jtt-2" onclick="setJmxTT(2)">2s</button>
        <button class="seg-btn"        id="jtt-3" onclick="setJmxTT(3)">3s</button>
        <button class="seg-btn"        id="jtt-5" onclick="setJmxTT(5)">5s</button>
      </div>
    </div>
    <div class="opt-group">
      <span class="opt-label">Workload Model Excel</span>
      <div class="seg-btns" role="group" aria-label="Workload Model Excel">
        <button class="seg-btn active" id="jwlm-yes" onclick="setJmxWlm(true)">Include</button>
        <button class="seg-btn"        id="jwlm-no"  onclick="setJmxWlm(false)">Skip</button>
      </div>
    </div>
  </div>

  <div class="divider"></div>
  <div class="prog-wrap" id="jprog-wrap"><div class="prog-fill" id="jprog-fill"></div></div>
  <button class="btn-convert devweb" id="btn-jmx" onclick="doConvertJmx()">
    <div class="spinner" id="jspinner"></div>
    <span id="jbtn-lbl">Convert JMeter to DevWeb Script</span>
  </button>
 </div><!-- /.cv-side -->
 </div><!-- /.cv-cols -->
</div>

<!-- ── Results ─────────────────────────────────────────────────────────── -->
<div class="result-box result-ok" id="res-ok" role="status" aria-live="polite">
  <div class="res-head">
    <div class="res-icon res-icon-ok"><%- svg(IC.check) %></div>
    <div>
      <div class="res-title">Script Generated Successfully</div>
      <div class="res-sub" id="res-sub"></div>
    </div>
  </div>
  <div class="stats-grid" id="stats-row"></div>
  <!-- Multi-script thread group list (hidden in single mode) -->
  <div id="res-tg-list" style="display:none;margin:12px 0 4px"></div>
  <!-- Dependency report (shown when CSV files are referenced) -->
  <div id="res-dep-report" style="display:none;margin:12px 0 4px"></div>
  <div class="res-actions">
    <a id="btn-dl" class="btn-dl" href="#" download><%- svg(IC.down) %> Download Script (.zip)</a>
    <button class="btn-reset" onclick="resetResult()"><%- svg(IC.back) %> Convert Another</button>
  </div>
</div>

<div class="result-box result-err" id="res-err" role="alert">
  <div class="res-head">
    <div class="res-icon res-icon-err"><%- svg(IC.x) %></div>
    <div>
      <div class="res-title">Conversion Failed</div>
      <div class="res-sub" id="err-msg"></div>
    </div>
  </div>
  <button class="btn-reset" onclick="resetResult()"><%- svg(IC.back) %> Try Again</button>
</div>

<!-- ── How it works (can be folded away — remembered) ──────────────────── -->
<details class="card standalone cv-how" id="cv-how" open>
  <summary class="section-label"><span class="cv-how-chev"><%- svg(IC.chevron) %></span>How It Works</summary>
  <div class="steps-grid">
    <div class="step">
      <div class="step-icon"><%- svg(IC.upload) %></div>
      <div class="step-ttl">Upload</div>
      <div class="step-txt">Drop your Postman, Bruno or JMeter file. Add an environment file for variable values.</div>
    </div>
    <div class="step">
      <div class="step-icon"><%- svg(IC.search) %></div>
      <div class="step-ttl">Analyze</div>
      <div class="step-txt">Detects correlations, JWT, auth, proxy, headers and classifies all variables into 3 tiers.</div>
    </div>
    <div class="step">
      <div class="step-icon"><%- svg(IC.gear) %></div>
      <div class="step-ttl">Generate</div>
      <div class="step-txt">Creates a complete LR script with all config files — per-request transactions included.</div>
    </div>
    <div class="step">
      <div class="step-icon"><%- svg(IC.down) %></div>
      <div class="step-ttl">Download</div>
      <div class="step-txt">Get a .zip. Open the .usr in VuGen or upload directly to LoadRunner Enterprise.</div>
    </div>
  </div>
  <div class="formats-bar">
    <span class="fmt-chip"><i style="--k:var(--c-convert)"></i>Postman v2.1 JSON</span>
    <span class="fmt-chip"><i style="--k:var(--c-convert)"></i>Bruno JSON / YAML / .bru</span>
    <span class="fmt-chip"><i style="--k:var(--c-jmeter)"></i>JMeter .jmx</span>
    <span class="fmt-chip"><i style="--k:#4f8ef7"></i>DevWeb JS output</span>
    <span class="fmt-chip"><i style="--k:#f0883e"></i>VuGen C output</span>
  </div>
</details>

<!-- ── Footer ──────────────────────────────────────────────────────────── -->
<footer>
  <div class="footer-links">
    <span>PerfX Studio · Performance Script Generation</span>
    <span class="footer-sep">·</span>
    <span>Files processed in-memory — nothing stored on server</span>
  </div>
</footer>

</div><!-- /#portal-converter -->
