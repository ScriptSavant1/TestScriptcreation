<%#
  Postman / Bruno and JMeter converters. The page is drawn by public/portal/converter-app.js into the two panels
  (styles: public/portal/converter.css); here are only the panels, the file inputs (they keep the chosen files while the
  page is redrawn; files dropped anywhere go to them too) and the one window the page opens.
%>
<div id="portal-converter" style="display:none" class="portal-content-panel ds-brand">
  <div class="cx-panel" id="panel-bruno"></div>
  <div class="cx-panel" id="panel-jmx" style="display:none"></div>
  <div class="cx-files" aria-hidden="true">
    <input type="file" tabindex="-1" id="fi-col" accept=".json,.yml,.yaml,.bru,.zip" aria-label="Collection file">
    <input type="file" tabindex="-1" id="fi-env" accept=".json,.bru" aria-label="Environment file">
    <input type="file" tabindex="-1" id="fi-bru-cert" accept=".p12,.pfx,.pem,.crt,.cer,.key" multiple aria-label="Client certificate files">
    <input type="file" tabindex="-1" id="fi-jmx" accept=".jmx" aria-label="JMeter test plan">
    <input type="file" tabindex="-1" id="fi-csv" accept=".csv" multiple aria-label="CSV data files">
    <input type="file" tabindex="-1" id="fi-cert" accept=".p12,.pfx,.pem,.crt,.cer,.key" multiple aria-label="Certificate files">
  </div>
  <dialog class="cx-dlg" id="cx-dlg" aria-label="Files"></dialog>
</div>
