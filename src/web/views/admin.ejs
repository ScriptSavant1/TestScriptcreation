<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PerfX Studio — Analytics</title>
<style>
/* ── Reset & tokens ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg:        #0F1117;
  --surface:   #1A1D2E;
  --surface2:  #232640;
  --border:    #2E3155;
  --blue:      #4C8EF7;
  --blue-dim:  #1E40AF;
  --green:     #22C55E;
  --red:       #EF4444;
  --amber:     #F59E0B;
  --purple:    #A78BFA;
  --text:      #E2E8F0;
  --text-dim:  #94A3B8;
  --text-faint:#475569;
  --radius:    10px;
  --shadow:    0 4px 24px rgba(0,0,0,.4);
}
body { background: var(--bg); color: var(--text); font-family: -apple-system,'Segoe UI',system-ui,sans-serif; font-size: 14px; min-height: 100vh; }

/* ── Layout ── */
.page   { max-width: 1400px; margin: 0 auto; padding: 24px 20px 60px; }
.header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 28px; flex-wrap: wrap; gap: 14px; }
.header h1 { font-size: 22px; font-weight: 700; color: #fff; }
.header h1 span { color: var(--blue); }
.header-right { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }

/* ── Period selector ── */
.period-bar { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 24px; }
.period-btn { padding: 6px 14px; border-radius: 20px; border: 1px solid var(--border); background: var(--surface); color: var(--text-dim); font-size: 13px; cursor: pointer; text-decoration: none; transition: all .15s; }
.period-btn:hover, .period-btn.active { background: var(--blue); border-color: var(--blue); color: #fff; }

/* ── Cards grid ── */
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 16px; margin-bottom: 28px; }
.card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; }
.card-label { font-size: 12px; color: var(--text-dim); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; }
.card-value { font-size: 32px; font-weight: 700; line-height: 1; margin-bottom: 4px; }
.card-sub   { font-size: 12px; color: var(--text-faint); }
.card-blue   .card-value { color: var(--blue); }
.card-green  .card-value { color: var(--green); }
.card-red    .card-value { color: var(--red); }
.card-purple .card-value { color: var(--purple); }
.card-amber  .card-value { color: var(--amber); }

/* ── Insights panel ── */
.insights { background: var(--surface); border: 1px solid var(--blue-dim); border-left: 4px solid var(--blue); border-radius: var(--radius); padding: 18px 20px; margin-bottom: 28px; }
.insights h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .07em; color: var(--blue); margin-bottom: 12px; }
.insights ul { list-style: none; display: flex; flex-direction: column; gap: 8px; }
.insights li { color: var(--text-dim); line-height: 1.6; padding-left: 16px; position: relative; }
.insights li::before { content: "→"; position: absolute; left: 0; color: var(--blue); font-weight: 700; }

/* ── Chart grid ── */
.charts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 28px; }
@media (max-width: 900px) { .charts-grid { grid-template-columns: 1fr; } }
.chart-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; }
.chart-card h3 { font-size: 13px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 16px; }
.chart-wrap { position: relative; height: 220px; }
.chart-wrap canvas { max-height: 220px; }

/* ── Full-width chart ── */
.chart-card.wide { grid-column: 1 / -1; }
.chart-card.wide .chart-wrap { height: 200px; }

/* ── Heatmap ── */
.heatmap-wrap { overflow-x: auto; }
.heatmap { border-collapse: collapse; width: 100%; }
.heatmap th { font-size: 11px; color: var(--text-faint); font-weight: 500; padding: 4px 6px; text-align: center; }
.heatmap td { width: 28px; height: 28px; border-radius: 4px; text-align: center; font-size: 11px; color: transparent; transition: color .1s; }
.heatmap td:hover { color: #fff; }
.hm0  { background: var(--surface2); }
.hm1  { background: #1e3a5f; }
.hm2  { background: #1d4ed8; }
.hm3  { background: #2563eb; }
.hm4  { background: #3b82f6; }
.hm5  { background: #60a5fa; }

/* ── Tables ── */
.section { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 20px; overflow: hidden; }
.section-header { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid var(--border); }
.section-header h3 { font-size: 14px; font-weight: 600; }
.section-header .count { font-size: 12px; color: var(--text-faint); }
table { width: 100%; border-collapse: collapse; }
thead th { padding: 10px 16px; text-align: left; font-size: 12px; font-weight: 600; color: var(--text-faint); text-transform: uppercase; letter-spacing: .05em; background: var(--surface2); border-bottom: 1px solid var(--border); white-space: nowrap; }
tbody tr { border-bottom: 1px solid var(--border); transition: background .12s; }
tbody tr:last-child { border-bottom: none; }
tbody tr:hover { background: var(--surface2); }
tbody td { padding: 10px 16px; color: var(--text); font-size: 13px; }
td.mono { font-family: 'Cascadia Code','Consolas',monospace; font-size: 12px; color: var(--text-dim); }
.overflow-x { overflow-x: auto; }

/* ── Badges ── */
.badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; }
.badge-green  { background: rgba(34,197,94,.15);  color: var(--green); }
.badge-red    { background: rgba(239,68,68,.15);   color: var(--red); }
.badge-amber  { background: rgba(245,158,11,.15);  color: var(--amber); }
.badge-blue   { background: rgba(76,142,247,.15);  color: var(--blue); }
.badge-purple { background: rgba(167,139,250,.15); color: var(--purple); }

/* ── Progress bar ── */
.progress { background: var(--surface2); border-radius: 4px; height: 6px; overflow: hidden; width: 100px; display: inline-block; vertical-align: middle; }
.progress-fill { height: 100%; border-radius: 4px; background: var(--blue); }

/* ── Event log filters ── */
.filters { display: flex; gap: 10px; flex-wrap: wrap; padding: 14px 20px; border-bottom: 1px solid var(--border); background: var(--surface2); }
.filters select, .filters input { background: var(--bg); border: 1px solid var(--border); color: var(--text); border-radius: 6px; padding: 6px 10px; font-size: 13px; }
.filters select:focus, .filters input:focus { outline: none; border-color: var(--blue); }
.btn { padding: 7px 16px; border-radius: 7px; border: none; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; transition: opacity .15s; }
.btn:hover { opacity: .85; }
.btn-primary { background: var(--blue); color: #fff; }
.btn-ghost   { background: var(--surface2); color: var(--text-dim); border: 1px solid var(--border); }
.btn-green   { background: var(--green); color: #fff; }
.btn-purple  { background: var(--purple); color: #fff; }
.btn-amber   { background: var(--amber); color: #000; }

/* ── Pagination ── */
.pagination { display: flex; align-items: center; gap: 10px; padding: 14px 20px; border-top: 1px solid var(--border); }
.pagination span { color: var(--text-faint); font-size: 13px; }

/* ── Print ── */
@media print {
  body { background: #fff; color: #000; }
  .no-print, .filters, .period-bar, .header-right, .pagination { display: none !important; }
  .card { border: 1px solid #ddd; }
  .surface { background: #f8f8f8; }
  canvas { max-width: 100%; }
}
</style>
</head>
<body>
<div class="page">

  <!-- Header -->
  <div class="header">
    <h1>PerfX <span>Studio</span> — Usage Analytics</h1>
    <div class="header-right no-print">
      <a href="/admin/download/csv?period=<%=preset%>&from=<%=from||''%>&to=<%=to||''%>&token=<%=adminToken%>" class="btn btn-ghost">⬇ CSV</a>
      <a href="/admin/download/xlsx?period=<%=preset%>&from=<%=from||''%>&to=<%=to||''%>&token=<%=adminToken%>" class="btn btn-green">⬇ Excel</a>
      <a href="/admin/download/docx?period=<%=preset%>&from=<%=from||''%>&to=<%=to||''%>&token=<%=adminToken%>" class="btn btn-purple">⬇ Word</a>
      <button class="btn btn-amber no-print" onclick="window.print()">🖨 Print / PDF</button>
    </div>
  </div>

  <!-- Period selector -->
  <div class="period-bar no-print">
    <% [['7d','Last 7 days'],['30d','Last 30 days'],['90d','Last 90 days'],['mtd','This month'],['all','All time']].forEach(function(p){ %>
    <a href="/admin?period=<%=p[0]%>&token=<%=adminToken%>" class="period-btn <%=preset===p[0]?'active':''%>"><%=p[1]%></a>
    <% }) %>
    <span style="color:var(--text-faint);font-size:12px;align-self:center;">
      <% if(from && to){ %> <%=from%> → <%=to%> <% } %>
    </span>
  </div>

  <!-- Summary cards -->
  <div class="cards">
    <div class="card card-blue">
      <div class="card-label">Total Conversions</div>
      <div class="card-value"><%=stats.total.toLocaleString()%></div>
      <div class="card-sub">across all tools</div>
    </div>
    <div class="card card-green">
      <div class="card-label">Success Rate</div>
      <div class="card-value"><%=stats.successRate%>%</div>
      <div class="card-sub"><%=stats.successCount.toLocaleString()%> succeeded</div>
    </div>
    <div class="card card-red">
      <div class="card-label">Failures</div>
      <div class="card-value"><%=stats.failCount + stats.timeoutCount%></div>
      <div class="card-sub"><%=stats.failCount%> failed · <%=stats.timeoutCount%> timeout</div>
    </div>
    <div class="card card-purple">
      <div class="card-label">Avg Duration</div>
      <div class="card-value"><%=stats.avgDurationLabel%></div>
      <div class="card-sub">per conversion</div>
    </div>
    <div class="card card-amber">
      <div class="card-label">Active Machines</div>
      <div class="card-value"><%=stats.uniqueHosts%></div>
      <div class="card-sub"><%=stats.uniqueDevices%> unique browser profiles</div>
    </div>
  </div>

  <!-- Auto-generated insights -->
  <% if(stats.insights && stats.insights.length){ %>
  <div class="insights">
    <h3>Auto-Generated Insights</h3>
    <ul>
      <% stats.insights.forEach(function(ins){ %>
      <li><%=ins%></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <!-- Charts grid -->
  <div class="charts-grid">

    <!-- Tool usage doughnut -->
    <div class="chart-card">
      <h3>Tool Usage</h3>
      <div class="chart-wrap">
        <canvas id="chartTool"></canvas>
      </div>
    </div>

    <!-- Protocol split bar -->
    <div class="chart-card">
      <h3>Protocol Split</h3>
      <div class="chart-wrap">
        <canvas id="chartProto"></canvas>
      </div>
    </div>

    <!-- Daily trend — full width -->
    <div class="chart-card wide">
      <h3>Conversions per Day</h3>
      <div class="chart-wrap">
        <canvas id="chartTrend"></canvas>
      </div>
    </div>

  </div>

  <!-- Peak hours heatmap -->
  <div class="section" style="margin-bottom:28px">
    <div class="section-header">
      <h3>Peak Usage Heatmap <span style="font-size:12px;color:var(--text-faint);font-weight:400;">— hour of day × day of week</span></h3>
    </div>
    <div style="padding:16px 20px;overflow-x:auto;">
      <table class="heatmap">
        <thead>
          <tr>
            <th style="text-align:left">Hour</th>
            <th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th>
          </tr>
        </thead>
        <tbody>
          <% var hm = stats.heatmap; %>
          <% for(var h=0; h<24; h++){ %>
          <tr>
            <td style="color:var(--text-faint);font-size:11px;padding:2px 8px;"><%=String(h).padStart(2,'0')%>:00</td>
            <% for(var d=0; d<7; d++){ var v=hm[h][d]; var cls=v===0?'hm0':v<=2?'hm1':v<=5?'hm2':v<=10?'hm3':v<=20?'hm4':'hm5'; %>
            <td class="<%=cls%>" title="<%=v%> conversions"><%=v||''%></td>
            <% } %>
          </tr>
          <% } %>
        </tbody>
      </table>
      <div style="margin-top:10px;display:flex;gap:8px;align-items:center;">
        <span style="font-size:11px;color:var(--text-faint)">Low</span>
        <span style="width:14px;height:14px;border-radius:3px;background:var(--surface2);display:inline-block"></span>
        <span style="width:14px;height:14px;border-radius:3px;background:#1e3a5f;display:inline-block"></span>
        <span style="width:14px;height:14px;border-radius:3px;background:#2563eb;display:inline-block"></span>
        <span style="width:14px;height:14px;border-radius:3px;background:#60a5fa;display:inline-block"></span>
        <span style="font-size:11px;color:var(--text-faint)">High</span>
      </div>
    </div>
  </div>

  <!-- Top machines -->
  <div class="section">
    <div class="section-header">
      <h3>Most Active Machines</h3>
      <span class="count">Top <%=stats.machineRows.length%></span>
    </div>
    <div class="overflow-x">
      <table>
        <thead><tr>
          <th>Machine / Hostname</th>
          <th>IP Address</th>
          <th>Conversions</th>
          <th>Share</th>
          <th>Success Rate</th>
          <th>Last Seen</th>
        </tr></thead>
        <tbody>
          <% stats.machineRows.forEach(function(m){ %>
          <tr>
            <td style="font-weight:600"><%=m.machine%></td>
            <td class="mono"><%=m.ip_address||'—'%></td>
            <td><%=m.count.toLocaleString()%></td>
            <td>
              <div class="progress"><div class="progress-fill" style="width:<%=stats.total>0?Math.round(m.count/stats.total*100):0%>%"></div></div>
              <span style="margin-left:8px;font-size:12px;color:var(--text-faint)"><%=stats.total>0?Math.round(m.count/stats.total*100):0%>%</span>
            </td>
            <td><span class="badge <%=m.success_rate>=95?'badge-green':m.success_rate>=80?'badge-amber':'badge-red'%>"><%=m.success_rate%>%</span></td>
            <td class="mono" style="font-size:12px"><%=m.last_seen||'—'%></td>
          </tr>
          <% }) %>
          <% if(!stats.machineRows.length){ %><tr><td colspan="6" style="text-align:center;color:var(--text-faint);padding:24px">No data yet</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Top files -->
  <div class="section">
    <div class="section-header">
      <h3>Most Converted Files</h3>
      <span class="count">Top <%=stats.fileRows.length%></span>
    </div>
    <div class="overflow-x">
      <table>
        <thead><tr>
          <th>Filename</th>
          <th>Type</th>
          <th>Times Converted</th>
          <th>Avg Size</th>
          <th>Avg Duration</th>
        </tr></thead>
        <tbody>
          <% stats.fileRows.forEach(function(f){ %>
          <tr>
            <td style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="<%=f.filename%>"><%=f.filename%></td>
            <td><span class="badge badge-blue"><%=f.ext||'?'%></span></td>
            <td><%=f.count.toLocaleString()%></td>
            <td class="mono"><%=f.avg_size_label%></td>
            <td class="mono"><%=f.avg_duration_s?f.avg_duration_s+'s':'—'%></td>
          </tr>
          <% }) %>
          <% if(!stats.fileRows.length){ %><tr><td colspan="5" style="text-align:center;color:var(--text-faint);padding:24px">No data yet</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Event log -->
  <div class="section">
    <div class="section-header">
      <h3>Event Log</h3>
      <span class="count" id="evtCount">Loading…</span>
    </div>
    <div class="filters no-print">
      <select id="fTool" onchange="loadEvents()">
        <option value="">All tools</option>
        <option value="converter">Converter</option>
        <option value="jmx">JMeter</option>
        <option value="recorder">Recorder</option>
        <option value="studio">Studio</option>
      </select>
      <select id="fResult" onchange="loadEvents()">
        <option value="">All results</option>
        <option value="success">Success</option>
        <option value="failed">Failed</option>
        <option value="timeout">Timeout</option>
      </select>
      <input id="fSearch" type="text" placeholder="Search hostname / IP…" oninput="debounceLoad()" style="min-width:180px">
      <input id="fFrom" type="date" value="<%=from||''%>" onchange="loadEvents()">
      <input id="fTo"   type="date" value="<%=to||''%>"   onchange="loadEvents()">
      <button class="btn btn-ghost" onclick="document.getElementById('fSearch').value='';document.getElementById('fTool').value='';document.getElementById('fResult').value='';loadEvents()">Clear</button>
    </div>
    <div class="overflow-x">
      <table>
        <thead><tr>
          <th>Time</th>
          <th>Machine</th>
          <th>IP</th>
          <th>Browser / OS</th>
          <th>Tool</th>
          <th>Protocol</th>
          <th>File</th>
          <th>Size</th>
          <th>Requests</th>
          <th>Duration</th>
          <th>Result</th>
        </tr></thead>
        <tbody id="evtBody">
          <tr><td colspan="11" style="text-align:center;color:var(--text-faint);padding:24px">Loading…</td></tr>
        </tbody>
      </table>
    </div>
    <div class="pagination">
      <button class="btn btn-ghost" id="btnPrev" onclick="prevPage()" disabled>← Prev</button>
      <span id="pageInfo">Page 1</span>
      <button class="btn btn-ghost" id="btnNext" onclick="nextPage()">Next →</button>
    </div>
  </div>

</div><!-- /page -->

<script src="/admin/vendor/chart.js"></script>
<script>
var ADMIN_TOKEN = "<%=adminToken%>";
var evtOffset   = 0;
var evtTotal    = 0;
var PAGE_SIZE   = 50;
var _debTimer   = null;

// ── Charts ────────────────────────────────────────────────────────────────────
var COLORS = ['#4C8EF7','#22C55E','#A78BFA','#F59E0B','#EF4444','#06B6D4','#F97316'];

var toolData  = <%- JSON.stringify(stats.toolRows)  %>;
var protoData = <%- JSON.stringify(stats.protoRows) %>;
var trendData = <%- JSON.stringify(stats.dailyTrend) %>;

// Doughnut — tool usage
new Chart(document.getElementById('chartTool'), {
  type: 'doughnut',
  data: {
    labels:   toolData.map(function(t){ return t.label; }),
    datasets: [{ data: toolData.map(function(t){ return t.count; }), backgroundColor: COLORS, borderColor: '#1A1D2E', borderWidth: 3, hoverOffset: 6 }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: {
      legend: { position: 'right', labels: { color: '#94A3B8', font: { size: 12 }, padding: 14 } },
      tooltip: { callbacks: { label: function(ctx){ return ' ' + ctx.label + ': ' + ctx.raw + ' (' + toolData[ctx.dataIndex].pct + '%)'; } } }
    },
    cutout: '65%'
  }
});

// Bar — protocol split
new Chart(document.getElementById('chartProto'), {
  type: 'bar',
  data: {
    labels:   protoData.map(function(p){ return p.label; }),
    datasets: [{ label: 'Conversions', data: protoData.map(function(p){ return p.count; }), backgroundColor: ['#4C8EF7','#A78BFA','#22C55E'], borderRadius: 6, borderSkipped: false }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { color: '#2E3155' }, ticks: { color: '#94A3B8' } },
      y: { grid: { color: '#2E3155' }, ticks: { color: '#94A3B8' }, beginAtZero: true }
    }
  }
});

// Line — daily trend
if (trendData.length > 0) {
  new Chart(document.getElementById('chartTrend'), {
    type: 'line',
    data: {
      labels: trendData.map(function(d){ return d.day; }),
      datasets: [
        { label: 'Total', data: trendData.map(function(d){ return d.n; }),
          borderColor: '#4C8EF7', backgroundColor: 'rgba(76,142,247,.12)',
          fill: true, tension: 0.35, pointRadius: trendData.length > 30 ? 0 : 4,
          pointHoverRadius: 6, borderWidth: 2 },
        { label: 'Successful', data: trendData.map(function(d){ return d.success_count; }),
          borderColor: '#22C55E', backgroundColor: 'transparent',
          fill: false, tension: 0.35, pointRadius: 0, borderWidth: 1.5, borderDash: [4,4] }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: { legend: { labels: { color: '#94A3B8', font: { size: 12 } } } },
      scales: {
        x: { grid: { color: '#2E3155' }, ticks: { color: '#94A3B8', maxTicksLimit: 15 } },
        y: { grid: { color: '#2E3155' }, ticks: { color: '#94A3B8' }, beginAtZero: true }
      }
    }
  });
}

// ── Event log ─────────────────────────────────────────────────────────────────
var TOOL_LABELS = { converter: 'Converter', jmx: 'JMeter', recorder: 'Recorder', studio: 'Studio' };
var BADGE = { success: 'badge-green', failed: 'badge-red', timeout: 'badge-amber' };

function fmtSize(kb){ if(!kb) return '—'; if(kb<1024) return kb+'KB'; return (kb/1024).toFixed(1)+'MB'; }
function fmtDur(ms) { if(!ms) return '—'; if(ms<1000) return ms+'ms'; return (ms/1000).toFixed(1)+'s'; }
function escHtml(s)  { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function buildUrl(extra) {
  var base = '/admin/api/events?token=' + encodeURIComponent(ADMIN_TOKEN);
  var tool   = document.getElementById('fTool').value;
  var result = document.getElementById('fResult').value;
  var search = document.getElementById('fSearch').value;
  var from   = document.getElementById('fFrom').value;
  var to     = document.getElementById('fTo').value;
  if(tool)   base += '&tool='   + encodeURIComponent(tool);
  if(result) base += '&result=' + encodeURIComponent(result);
  if(search) base += '&search=' + encodeURIComponent(search);
  if(from)   base += '&from='   + encodeURIComponent(from);
  if(to)     base += '&to='     + encodeURIComponent(to);
  return base + '&limit=' + PAGE_SIZE + '&offset=' + evtOffset + (extra||'');
}

function loadEvents() {
  evtOffset = 0;
  fetchEvents();
}

function debounceLoad() {
  clearTimeout(_debTimer);
  _debTimer = setTimeout(loadEvents, 350);
}

function prevPage() { evtOffset = Math.max(0, evtOffset - PAGE_SIZE); fetchEvents(); }
function nextPage() { evtOffset += PAGE_SIZE; fetchEvents(); }

function fetchEvents() {
  fetch(buildUrl())
    .then(function(r){ return r.json(); })
    .then(function(data){
      evtTotal = data.total;
      var rows = data.rows || [];
      document.getElementById('evtCount').textContent = evtTotal.toLocaleString() + ' events';

      var page  = Math.floor(evtOffset / PAGE_SIZE) + 1;
      var pages = Math.ceil(evtTotal / PAGE_SIZE) || 1;
      document.getElementById('pageInfo').textContent = 'Page ' + page + ' of ' + pages;
      document.getElementById('btnPrev').disabled = evtOffset <= 0;
      document.getElementById('btnNext').disabled = evtOffset + PAGE_SIZE >= evtTotal;

      if (!rows.length) {
        document.getElementById('evtBody').innerHTML = '<tr><td colspan="11" style="text-align:center;color:var(--text-faint);padding:24px">No events match the current filter</td></tr>';
        return;
      }

      var html = '';
      rows.forEach(function(r) {
        var ts   = r.started_at ? r.started_at.slice(0,16).replace('T',' ') : '—';
        var host = escHtml(r.hostname || r.ip_address || '—');
        var ip   = escHtml(r.ip_address || '—');
        var ua   = escHtml([r.browser, r.os].filter(Boolean).join(' / ') || '—');
        var tool = escHtml(TOOL_LABELS[r.tool] || r.tool || '—');
        var proto= escHtml(r.protocol || '—');
        var file = r.filename ? '<span title="' + escHtml(r.filename) + '">' + escHtml(r.filename.slice(-30)) + '</span>' : '—';
        var badge= '<span class="badge ' + (BADGE[r.result]||'badge-blue') + '">' + escHtml(r.result) + '</span>';
        var err  = r.error_code ? '<br><span style="font-size:11px;color:var(--text-faint)">' + escHtml(r.error_code) + '</span>' : '';
        html += '<tr>'
          + '<td class="mono" style="font-size:12px;white-space:nowrap">' + ts + '</td>'
          + '<td style="font-weight:600">' + host + '</td>'
          + '<td class="mono">' + ip + '</td>'
          + '<td style="font-size:12px;color:var(--text-dim)">' + ua + '</td>'
          + '<td><span class="badge badge-blue">' + tool + '</span></td>'
          + '<td class="mono">' + proto + '</td>'
          + '<td style="max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">' + file + '</td>'
          + '<td class="mono">' + fmtSize(r.file_size_kb) + '</td>'
          + '<td class="mono">' + (r.request_count||'—') + '</td>'
          + '<td class="mono">' + fmtDur(r.duration_ms) + '</td>'
          + '<td>' + badge + err + '</td>'
          + '</tr>';
      });
      document.getElementById('evtBody').innerHTML = html;
    })
    .catch(function(){ document.getElementById('evtBody').innerHTML = '<tr><td colspan="11" style="text-align:center;color:var(--red);padding:24px">Failed to load events</td></tr>'; });
}

// Initial load
loadEvents();
</script>
</body>
</html>
