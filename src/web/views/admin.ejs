<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PerfX Studio — Usage Analytics</title>
<style>
/* ── Reset & design tokens ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --bg:         #0A0D14;
  --surface:    #141721;
  --surface2:   #1C2030;
  --surface3:   #242840;
  --border:     #252A40;
  --border2:    #2E3560;
  --blue:       #3B82F6;
  --blue-light: #60A5FA;
  --blue-glow:  rgba(59,130,246,.18);
  --green:      #10B981;
  --green-glow: rgba(16,185,129,.15);
  --red:        #EF4444;
  --red-glow:   rgba(239,68,68,.15);
  --amber:      #F59E0B;
  --amber-glow: rgba(245,158,11,.15);
  --purple:     #8B5CF6;
  --purple-glow:rgba(139,92,246,.15);
  --cyan:       #06B6D4;
  --text:       #E2E8F0;
  --text-dim:   #8B95B0;
  --text-faint: #3D4563;
  --radius:     12px;
  --radius-sm:  8px;
  --mono: 'Cascadia Code','Consolas','JetBrains Mono','Courier New',monospace;
  --sans: -apple-system,'Segoe UI',system-ui,sans-serif;
}
html { color-scheme: dark; }
body { background: var(--bg); color: var(--text); font-family: var(--sans); font-size: 14px; min-height: 100vh; line-height: 1.5; }

/* ── Page shell ── */
.page { max-width: 1440px; margin: 0 auto; padding: 0 24px 80px; }

/* ── Topbar ── */
.topbar {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 0 0; margin-bottom: 28px; flex-wrap: wrap; gap: 14px;
  border-bottom: 1px solid var(--border); padding-bottom: 20px;
}
.topbar-brand { display: flex; align-items: center; gap: 12px; }
.topbar-logo {
  width: 38px; height: 38px; border-radius: 10px;
  background: linear-gradient(135deg, #1D4ED8, #7C3AED);
  display: flex; align-items: center; justify-content: center;
  font-size: 18px; flex-shrink: 0; box-shadow: 0 0 24px rgba(59,130,246,.35);
}
.topbar-title { font-size: 20px; font-weight: 700; color: #fff; letter-spacing: -.02em; }
.topbar-title span { color: var(--blue-light); }
.topbar-sub { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
.topbar-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }

/* ── Period bar ── */
.period-bar { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; margin-bottom: 28px; }
.period-btn {
  padding: 6px 16px; border-radius: 20px; border: 1px solid var(--border2);
  background: var(--surface); color: var(--text-dim); font-size: 12px; font-weight: 500;
  cursor: pointer; text-decoration: none; transition: all .15s; white-space: nowrap;
}
.period-btn:hover { border-color: var(--blue); color: var(--blue-light); }
.period-btn.active { background: var(--blue); border-color: var(--blue); color: #fff; font-weight: 600; box-shadow: 0 0 16px rgba(59,130,246,.4); }
.period-range { font-size: 12px; color: var(--text-dim); margin-left: 8px; }

/* ── KPI cards ── */
.kpi-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 28px; }
@media (max-width: 1100px) { .kpi-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 700px)  { .kpi-grid { grid-template-columns: repeat(2, 1fr); } }

.kpi {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 20px; position: relative; overflow: hidden;
  transition: border-color .2s;
}
.kpi:hover { border-color: var(--border2); }
.kpi-icon {
  width: 36px; height: 36px; border-radius: 9px; display: flex;
  align-items: center; justify-content: center; margin-bottom: 14px; font-size: 17px;
}
.kpi-icon-blue   { background: var(--blue-glow);   color: var(--blue); }
.kpi-icon-green  { background: var(--green-glow);  color: var(--green); }
.kpi-icon-red    { background: var(--red-glow);    color: var(--red); }
.kpi-icon-purple { background: var(--purple-glow); color: var(--purple); }
.kpi-icon-amber  { background: var(--amber-glow);  color: var(--amber); }
.kpi-label { font-size: 11px; font-weight: 600; color: var(--text-dim); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 6px; }
.kpi-value { font-size: 34px; font-weight: 800; line-height: 1; letter-spacing: -.03em; font-variant-numeric: tabular-nums; margin-bottom: 6px; }
.kpi-value.blue   { color: var(--blue-light); }
.kpi-value.green  { color: var(--green); }
.kpi-value.red    { color: var(--red); }
.kpi-value.purple { color: var(--purple); }
.kpi-value.amber  { color: var(--amber); }
.kpi-sub { font-size: 12px; color: var(--text-faint); }
.kpi-accent {
  position: absolute; bottom: 0; left: 0; right: 0; height: 3px;
}
.kpi-accent.blue   { background: linear-gradient(90deg, var(--blue),   transparent); }
.kpi-accent.green  { background: linear-gradient(90deg, var(--green),  transparent); }
.kpi-accent.red    { background: linear-gradient(90deg, var(--red),    transparent); }
.kpi-accent.purple { background: linear-gradient(90deg, var(--purple), transparent); }
.kpi-accent.amber  { background: linear-gradient(90deg, var(--amber),  transparent); }

/* ── Insights ── */
.insights-panel {
  background: linear-gradient(135deg, rgba(59,130,246,.06), rgba(139,92,246,.06));
  border: 1px solid rgba(59,130,246,.25); border-radius: var(--radius);
  padding: 20px 24px; margin-bottom: 28px;
}
.insights-head { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
.insights-head svg { flex-shrink: 0; }
.insights-head h3 { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: var(--blue-light); }
.insights-list { list-style: none; display: flex; flex-direction: column; gap: 9px; }
.insights-list li {
  display: flex; gap: 10px; font-size: 13px; color: var(--text-dim); line-height: 1.55;
}
.insights-list li::before { content: "→"; color: var(--blue); font-weight: 700; flex-shrink: 0; margin-top: 1px; }

/* ── Section card ── */
.section {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); margin-bottom: 20px; overflow: hidden;
}
.section-head {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16px 20px; border-bottom: 1px solid var(--border);
}
.section-head h3 { font-size: 14px; font-weight: 600; color: var(--text); }
.section-badge { font-size: 11px; color: var(--text-dim); background: var(--surface2); padding: 3px 10px; border-radius: 20px; border: 1px solid var(--border); }

/* ── Charts ── */
.charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
.charts-row.triple { grid-template-columns: 1fr 1fr 1fr; }
@media (max-width: 900px) { .charts-row, .charts-row.triple { grid-template-columns: 1fr; } }
.chart-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius); padding: 20px;
}
.chart-card.full { grid-column: 1 / -1; }
.chart-card h3 { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: var(--text-dim); margin-bottom: 18px; }
.chart-wrap { position: relative; }
.chart-wrap-sm  { height: 230px; }
.chart-wrap-md  { height: 260px; }
.chart-wrap-lg  { height: 200px; }
.chart-wrap canvas { max-height: 100%; }

/* ── Tool breakdown bar ── */
.tool-bars { display: flex; flex-direction: column; gap: 10px; padding: 4px 0; }
.tool-bar-row { display: flex; align-items: center; gap: 10px; }
.tool-bar-label { font-size: 12px; font-weight: 600; width: 90px; flex-shrink: 0; color: var(--text-dim); }
.tool-bar-track { flex: 1; background: var(--surface2); border-radius: 4px; height: 8px; overflow: hidden; }
.tool-bar-fill  { height: 100%; border-radius: 4px; transition: width .6s ease; }
.tool-bar-count { font-size: 12px; color: var(--text-dim); width: 42px; text-align: right; font-variant-numeric: tabular-nums; flex-shrink: 0; }
.tool-bar-pct   { font-size: 11px; color: var(--text-faint); width: 32px; text-align: right; flex-shrink: 0; }

/* ── Heatmap ── */
.heatmap-wrap { overflow-x: auto; padding: 16px 20px; }
.heatmap { border-collapse: collapse; min-width: 520px; }
.heatmap th { font-size: 11px; color: var(--text-dim); font-weight: 600; padding: 4px 5px; text-align: center; letter-spacing: .04em; }
.heatmap th.row-label { text-align: left; width: 44px; padding-right: 12px; }
.heatmap td { width: 30px; height: 24px; border-radius: 3px; cursor: default; transition: opacity .1s; }
.heatmap td:hover { opacity: .75; }
.hm0 { background: var(--surface2); }
.hm1 { background: rgba(59,130,246,.2); }
.hm2 { background: rgba(59,130,246,.42); }
.hm3 { background: rgba(59,130,246,.62); }
.hm4 { background: rgba(59,130,246,.80); }
.hm5 { background: #3B82F6; }
.hm-legend { display: flex; gap: 6px; align-items: center; margin-top: 12px; }
.hm-legend-box { width: 16px; height: 16px; border-radius: 3px; display: inline-block; }
.hm-legend span { font-size: 11px; color: var(--text-faint); }

/* ── Tables ── */
.overflow-x { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
thead th {
  padding: 10px 16px; text-align: left; font-size: 11px; font-weight: 700;
  color: var(--text-faint); text-transform: uppercase; letter-spacing: .07em;
  background: var(--surface2); border-bottom: 1px solid var(--border); white-space: nowrap;
}
tbody tr { border-bottom: 1px solid var(--border); transition: background .1s; }
tbody tr:last-child { border-bottom: none; }
tbody tr:hover { background: rgba(255,255,255,.025); }
tbody td { padding: 11px 16px; font-size: 13px; }
td.mono { font-family: var(--mono); font-size: 12px; color: var(--text-dim); }
.td-name { font-weight: 600; max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.td-file { max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-dim); }

/* ── Progress bar ── */
.prog-wrap { display: flex; align-items: center; gap: 8px; }
.prog { background: var(--surface2); border-radius: 3px; height: 5px; overflow: hidden; width: 80px; flex-shrink: 0; }
.prog-fill { height: 100%; border-radius: 3px; background: var(--blue); }
.prog-pct { font-size: 11px; color: var(--text-dim); min-width: 32px; font-variant-numeric: tabular-nums; }

/* ── Badges ── */
.badge { display: inline-block; padding: 3px 9px; border-radius: 10px; font-size: 11px; font-weight: 700; letter-spacing: .03em; }
.badge-green  { background: var(--green-glow);  color: var(--green); }
.badge-red    { background: var(--red-glow);    color: var(--red); }
.badge-amber  { background: var(--amber-glow);  color: var(--amber); }
.badge-blue   { background: var(--blue-glow);   color: var(--blue-light); }
.badge-purple { background: var(--purple-glow); color: var(--purple); }
.badge-gray   { background: var(--surface2); color: var(--text-dim); }

/* ── Buttons ── */
.btn {
  padding: 8px 16px; border-radius: var(--radius-sm); border: none; font-size: 13px;
  font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
  text-decoration: none; transition: opacity .15s, transform .1s; white-space: nowrap;
}
.btn:active { transform: translateY(1px); }
.btn:hover { opacity: .88; }
.btn-primary { background: var(--blue);   color: #fff; }
.btn-green   { background: var(--green);  color: #fff; }
.btn-purple  { background: var(--purple); color: #fff; }
.btn-amber   { background: var(--amber);  color: #000; }
.btn-ghost   { background: var(--surface2); color: var(--text-dim); border: 1px solid var(--border2); }

/* ── Filters ── */
.filters {
  display: flex; gap: 8px; flex-wrap: wrap;
  padding: 14px 16px; border-bottom: 1px solid var(--border); background: var(--surface2);
}
.filters select, .filters input {
  background: var(--surface); border: 1px solid var(--border2); color: var(--text);
  border-radius: var(--radius-sm); padding: 7px 10px; font-size: 12px; outline: none;
}
.filters select:focus, .filters input:focus { border-color: var(--blue); }
.filters input[type=text] { min-width: 160px; }

/* ── Pagination ── */
.pagination {
  display: flex; align-items: center; gap: 10px; padding: 12px 16px;
  border-top: 1px solid var(--border); background: var(--surface2);
}
.pagination span { font-size: 12px; color: var(--text-dim); }
.pg-info { flex: 1; text-align: center; }

/* ── Empty state ── */
.empty-state { padding: 48px 20px; text-align: center; }
.empty-state-icon { font-size: 36px; margin-bottom: 12px; opacity: .4; }
.empty-state p { color: var(--text-dim); font-size: 13px; }

/* ── Print ── */
@media print {
  @page { margin: 18mm 14mm; }
  * { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  body { background: #fff !important; color: #111 !important; font-size: 11pt; }
  .no-print, .topbar-actions, .period-bar, .filters, .pagination { display: none !important; }
  .page { padding: 0; max-width: 100%; }
  .topbar { border-bottom: 2px solid #111; margin-bottom: 16pt; padding-bottom: 12pt; }
  .topbar-title { font-size: 18pt; color: #111 !important; }
  .topbar-title span { color: #1D4ED8 !important; }
  .topbar-sub { color: #555 !important; }
  .topbar-logo { background: #1D4ED8 !important; }
  :root {
    --bg: #fff; --surface: #fff; --surface2: #f5f5f5; --border: #ddd; --text: #111;
    --text-dim: #444; --text-faint: #888; --blue-light: #1D4ED8;
    --blue-glow: rgba(29,78,216,.08); --green-glow: rgba(16,185,129,.08);
    --red-glow: rgba(239,68,68,.08); --amber-glow: rgba(245,158,11,.08); --purple-glow: rgba(139,92,246,.08);
  }
  .kpi { border: 1px solid #ddd !important; break-inside: avoid; }
  .kpi-accent { display: none; }
  .section, .chart-card { border: 1px solid #ddd !important; break-inside: avoid; }
  .charts-row { grid-template-columns: 1fr 1fr !important; }
  canvas { max-width: 100%; }
  .insights-panel { border: 1px solid #1D4ED8 !important; background: rgba(29,78,216,.04) !important; }
  .insights-list li { color: #333 !important; }
  .badge-green  { background: #dcfce7 !important; color: #15803d !important; }
  .badge-red    { background: #fee2e2 !important; color: #b91c1c !important; }
  .badge-blue   { background: #dbeafe !important; color: #1d4ed8 !important; }
  .badge-amber  { background: #fef3c7 !important; color: #92400e !important; }
  .badge-gray   { background: #f3f4f6 !important; color: #374151 !important; }
  thead th { background: #f5f5f5 !important; color: #555 !important; }
  tbody tr:hover { background: transparent !important; }
  .print-break { page-break-before: always; }
}
</style>
</head>
<body>
<div class="page">

  <!-- Topbar -->
  <div class="topbar">
    <div class="topbar-brand">
      <div class="topbar-logo">📊</div>
      <div>
        <div class="topbar-title">PerfX <span>Studio</span></div>
        <div class="topbar-sub">Usage Analytics &amp; Reports</div>
      </div>
    </div>
    <div class="topbar-actions no-print">
      <a href="/admin/download/csv?period=<%=preset%>&from=<%=from||''%>&to=<%=to||''%>&token=<%=adminToken%>" class="btn btn-ghost">⬇ CSV</a>
      <a href="/admin/download/xlsx?period=<%=preset%>&from=<%=from||''%>&to=<%=to||''%>&token=<%=adminToken%>" class="btn btn-green">⬇ Excel</a>
      <a href="/admin/download/docx?period=<%=preset%>&from=<%=from||''%>&to=<%=to||''%>&token=<%=adminToken%>" class="btn btn-purple">⬇ Word</a>
      <button class="btn btn-amber no-print" onclick="window.print()">🖨 Print / PDF</button>
    </div>
  </div>

  <!-- Period selector -->
  <div class="period-bar no-print">
    <% [['7d','Last 7 days'],['30d','Last 30 days'],['90d','Last 90 days'],['mtd','This month'],['all','All time']].forEach(function(p){ %>
    <a href="/admin?period=<%=p[0]%>&token=<%=adminToken%>" class="period-btn <%=preset===p[0]?'active':''%>"><%=p[1]%></a>
    <% }) %>
    <% if(from && to){ %><span class="period-range"><%=from%> → <%=to%></span><% } %>
  </div>

  <!-- KPI cards -->
  <div class="kpi-grid">
    <div class="kpi">
      <div class="kpi-icon kpi-icon-blue">🔄</div>
      <div class="kpi-label">Total Conversions</div>
      <div class="kpi-value blue"><%=stats.total.toLocaleString()%></div>
      <div class="kpi-sub">all tools combined</div>
      <div class="kpi-accent blue"></div>
    </div>
    <div class="kpi">
      <div class="kpi-icon kpi-icon-green">✓</div>
      <div class="kpi-label">Success Rate</div>
      <div class="kpi-value green"><%=stats.successRate%>%</div>
      <div class="kpi-sub"><%=stats.successCount.toLocaleString()%> succeeded</div>
      <div class="kpi-accent green"></div>
    </div>
    <div class="kpi">
      <div class="kpi-icon kpi-icon-red">✕</div>
      <div class="kpi-label">Failures</div>
      <div class="kpi-value red"><%=stats.failCount + stats.timeoutCount%></div>
      <div class="kpi-sub"><%=stats.failCount%> failed · <%=stats.timeoutCount%> timeout</div>
      <div class="kpi-accent red"></div>
    </div>
    <div class="kpi">
      <div class="kpi-icon kpi-icon-purple">⏱</div>
      <div class="kpi-label">Avg Duration</div>
      <div class="kpi-value purple"><%=stats.avgDurationLabel%></div>
      <div class="kpi-sub">per conversion</div>
      <div class="kpi-accent purple"></div>
    </div>
    <div class="kpi">
      <div class="kpi-icon kpi-icon-amber">🖥</div>
      <div class="kpi-label">Active Machines</div>
      <div class="kpi-value amber"><%=stats.uniqueHosts%></div>
      <div class="kpi-sub"><%=stats.uniqueDevices%> browser profiles</div>
      <div class="kpi-accent amber"></div>
    </div>
  </div>

  <!-- Auto-insights panel -->
  <% if(stats.insights && stats.insights.length){ %>
  <div class="insights-panel">
    <div class="insights-head">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24"><path fill="#60A5FA" d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
      <h3>AI-Generated Insights</h3>
    </div>
    <ul class="insights-list">
      <% stats.insights.forEach(function(ins){ %>
      <li><%=ins%></li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <!-- Charts row 1: tool doughnut + protocol bar + success trend -->
  <div class="charts-row triple">

    <div class="chart-card">
      <h3>Tool Usage</h3>
      <div class="chart-wrap chart-wrap-sm">
        <canvas id="chartTool"></canvas>
      </div>
    </div>

    <div class="chart-card">
      <h3>Protocol Split</h3>
      <div class="chart-wrap chart-wrap-sm">
        <canvas id="chartProto"></canvas>
      </div>
      <!-- Tool breakdown bars (fallback if no data) -->
      <% if(!stats.protoRows || !stats.protoRows.length){ %>
      <div class="empty-state" style="padding:24px">
        <div class="empty-state-icon">📊</div>
        <p>No data yet</p>
      </div>
      <% } %>
    </div>

    <div class="chart-card">
      <h3>Result Distribution</h3>
      <div class="chart-wrap chart-wrap-sm">
        <canvas id="chartResult"></canvas>
      </div>
    </div>

  </div>

  <!-- Charts row 2: daily trend full width -->
  <div class="charts-row">
    <div class="chart-card full">
      <h3>Daily Activity Trend</h3>
      <div class="chart-wrap chart-wrap-md">
        <canvas id="chartTrend"></canvas>
      </div>
      <% if(!stats.dailyTrend || !stats.dailyTrend.length){ %>
      <div class="empty-state">
        <div class="empty-state-icon">📈</div>
        <p>No trend data for this period. Use the tool and refresh.</p>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Peak hours heatmap -->
  <div class="section" style="margin-bottom:20px">
    <div class="section-head">
      <h3>Peak Usage Heatmap</h3>
      <span class="section-badge">hour of day × day of week</span>
    </div>
    <div class="heatmap-wrap">
      <table class="heatmap">
        <thead>
          <tr>
            <th class="row-label">Hour</th>
            <th>Sun</th><th>Mon</th><th>Tue</th><th>Wed</th><th>Thu</th><th>Fri</th><th>Sat</th>
          </tr>
        </thead>
        <tbody>
          <% var hm = stats.heatmap; %>
          <% for(var h=0; h<24; h++){ %>
          <tr>
            <td style="font-family:var(--mono);font-size:10px;color:var(--text-faint);padding:2px 8px 2px 0;white-space:nowrap"><%=String(h).padStart(2,'0')%>:00</td>
            <% for(var d=0; d<7; d++){ var v=hm[h][d]; var cls=v===0?'hm0':v<=1?'hm1':v<=4?'hm2':v<=9?'hm3':v<=19?'hm4':'hm5'; %>
            <td class="<%=cls%>" title="<%=v%> at <%=String(h).padStart(2,'0')%>:00 <%=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d]%>"></td>
            <% } %>
          </tr>
          <% } %>
        </tbody>
      </table>
      <div class="hm-legend">
        <span>Low</span>
        <span class="hm-legend-box hm0"></span>
        <span class="hm-legend-box hm1"></span>
        <span class="hm-legend-box hm2"></span>
        <span class="hm-legend-box hm3"></span>
        <span class="hm-legend-box hm4"></span>
        <span class="hm-legend-box hm5"></span>
        <span>High</span>
      </div>
    </div>
  </div>

  <!-- Most active machines -->
  <div class="section">
    <div class="section-head">
      <h3>Most Active Machines</h3>
      <span class="section-badge">Top <%=stats.machineRows.length%></span>
    </div>
    <div class="overflow-x">
      <table>
        <thead><tr>
          <th>#</th>
          <th>Machine / Hostname</th>
          <th>IP Address</th>
          <th>Conversions</th>
          <th>Share of Total</th>
          <th>Success Rate</th>
          <th>Last Seen</th>
        </tr></thead>
        <tbody>
          <% stats.machineRows.forEach(function(m, i){ %>
          <tr>
            <td class="mono" style="color:var(--text-faint);width:36px"><%=i+1%></td>
            <td><span class="td-name"><%=m.machine%></span></td>
            <td class="mono"><%=m.ip_address||'—'%></td>
            <td style="font-variant-numeric:tabular-nums;font-weight:600"><%=m.count.toLocaleString()%></td>
            <td>
              <div class="prog-wrap">
                <div class="prog"><div class="prog-fill" style="width:<%=stats.total>0?Math.round(m.count/stats.total*100):0%>%"></div></div>
                <span class="prog-pct"><%=stats.total>0?Math.round(m.count/stats.total*100):0%>%</span>
              </div>
            </td>
            <td>
              <span class="badge <%=m.success_rate>=95?'badge-green':m.success_rate>=75?'badge-amber':'badge-red'%>"><%=m.success_rate%>%</span>
            </td>
            <td class="mono" style="font-size:12px;white-space:nowrap"><%=m.last_seen||'—'%></td>
          </tr>
          <% }) %>
          <% if(!stats.machineRows.length){ %>
          <tr><td colspan="7" class="empty-state"><div class="empty-state-icon">🖥</div><p>No machine data yet</p></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Most converted files -->
  <div class="section">
    <div class="section-head">
      <h3>Most Converted Files</h3>
      <span class="section-badge">Top <%=stats.fileRows.length%></span>
    </div>
    <div class="overflow-x">
      <table>
        <thead><tr>
          <th>#</th>
          <th>Filename</th>
          <th>Format</th>
          <th>Conversions</th>
          <th>Avg Size</th>
          <th>Avg Duration</th>
        </tr></thead>
        <tbody>
          <% stats.fileRows.forEach(function(f, i){ %>
          <tr>
            <td class="mono" style="color:var(--text-faint);width:36px"><%=i+1%></td>
            <td class="td-file" title="<%=f.filename%>"><%=f.filename%></td>
            <td><span class="badge badge-blue"><%=f.ext||'?'%></span></td>
            <td style="font-variant-numeric:tabular-nums;font-weight:600"><%=f.count.toLocaleString()%></td>
            <td class="mono"><%=f.avg_size_label%></td>
            <td class="mono"><%=f.avg_duration_s ? f.avg_duration_s+'s' : '—'%></td>
          </tr>
          <% }) %>
          <% if(!stats.fileRows.length){ %>
          <tr><td colspan="6" class="empty-state"><div class="empty-state-icon">📄</div><p>No file data yet</p></td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Event log -->
  <div class="section">
    <div class="section-head">
      <h3>Event Log</h3>
      <span class="section-badge no-print" id="evtCount">Loading…</span>
    </div>
    <div class="filters no-print">
      <select id="fTool" onchange="loadEvents()">
        <option value="">All tools</option>
        <option value="converter">Converter</option>
        <option value="jmx">JMeter</option>
        <option value="recorder">Recorder</option>
        <option value="studio">Studio</option>
      </select>
      <select id="fResult" onchange="loadEvents()">
        <option value="">All results</option>
        <option value="success">Success</option>
        <option value="failed">Failed</option>
        <option value="timeout">Timeout</option>
      </select>
      <input id="fSearch" type="text" placeholder="Search hostname / IP / file…" oninput="debounceLoad()" style="min-width:200px">
      <input id="fFrom" type="date" value="<%=from||''%>" onchange="loadEvents()">
      <input id="fTo"   type="date" value="<%=to||''%>"   onchange="loadEvents()">
      <button class="btn btn-ghost" onclick="clearFilters()">Clear</button>
      <button class="btn btn-ghost" onclick="loadEvents()" style="margin-left:auto">↻ Refresh</button>
    </div>
    <div class="overflow-x">
      <table>
        <thead><tr>
          <th>Timestamp</th>
          <th>Machine</th>
          <th>IP</th>
          <th>Browser / OS</th>
          <th>Tool</th>
          <th>Protocol</th>
          <th>File</th>
          <th>Size</th>
          <th>Requests</th>
          <th>Correlations</th>
          <th>Duration</th>
          <th>Result</th>
        </tr></thead>
        <tbody id="evtBody">
          <tr><td colspan="12" class="empty-state"><p>Loading…</p></td></tr>
        </tbody>
      </table>
    </div>
    <div class="pagination no-print">
      <button class="btn btn-ghost" id="btnPrev" onclick="prevPage()" disabled>← Prev</button>
      <span class="pg-info" id="pageInfo">Page 1</span>
      <button class="btn btn-ghost" id="btnNext" onclick="nextPage()">Next →</button>
    </div>
  </div>

</div><!-- /page -->

<script src="/admin/vendor/chart.js"></script>
<script>
var ADMIN_TOKEN = "<%=adminToken%>";
var evtOffset = 0, evtTotal = 0, PAGE_SIZE = 50, _debTimer = null;

// ── Chart data from server ────────────────────────────────────────────────────
var toolData  = <%- JSON.stringify(stats.toolRows)   %>;
var protoData = <%- JSON.stringify(stats.protoRows)  %>;
var trendData = <%- JSON.stringify(stats.dailyTrend) %>;
var TOTAL     = <%- stats.total %>;
var SUCCESS   = <%- stats.successCount %>;
var FAIL      = <%- stats.failCount %>;
var TIMEOUT   = <%- stats.timeoutCount %>;

// ── Chart defaults (guard in case Chart.js fails to load) ────────────────────
if (typeof Chart === 'undefined') {
  console.warn('Chart.js not loaded — charts will not render');
} else {
Chart.defaults.color = '#8B95B0';
Chart.defaults.font.family = "-apple-system,'Segoe UI',system-ui,sans-serif";
Chart.defaults.font.size = 12;

var BLUE   = '#3B82F6', GREEN  = '#10B981', RED  = '#EF4444',
    AMBER  = '#F59E0B', PURPLE = '#8B5CF6', CYAN = '#06B6D4';
var TOOL_COLORS = [BLUE, PURPLE, GREEN, AMBER, RED, CYAN, '#EC4899'];

// ── Doughnut: tool usage ──────────────────────────────────────────────────────
if (toolData.length) {
  new Chart(document.getElementById('chartTool'), {
    type: 'doughnut',
    data: {
      labels: toolData.map(function(t){ return t.label; }),
      datasets: [{
        data: toolData.map(function(t){ return t.count; }),
        backgroundColor: TOOL_COLORS,
        borderColor: '#141721', borderWidth: 3, hoverOffset: 8
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { position: 'right', labels: { color: '#8B95B0', padding: 14, font: { size: 12 } } },
        tooltip: { callbacks: { label: function(ctx){ return '  ' + ctx.label + ': ' + ctx.raw + ' (' + toolData[ctx.dataIndex].pct + '%)'; } } }
      },
      cutout: '68%'
    }
  });
} else {
  document.getElementById('chartTool').closest('.chart-card').innerHTML = '<h3>Tool Usage</h3><div class="empty-state"><div class="empty-state-icon">🔄</div><p>No data yet</p></div>';
}

// ── Bar: protocol split ───────────────────────────────────────────────────────
if (protoData.length) {
  new Chart(document.getElementById('chartProto'), {
    type: 'bar',
    data: {
      labels: protoData.map(function(p){ return p.label; }),
      datasets: [{
        data: protoData.map(function(p){ return p.count; }),
        backgroundColor: [BLUE, PURPLE, GREEN, AMBER, RED],
        borderRadius: 6, borderSkipped: false
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: { legend: { display: false } },
      scales: {
        x: { grid: { color: 'rgba(255,255,255,.05)' }, ticks: { color: '#8B95B0' } },
        y: { grid: { color: 'rgba(255,255,255,.05)' }, ticks: { color: '#8B95B0' }, beginAtZero: true }
      }
    }
  });
}

// ── Doughnut: result distribution ────────────────────────────────────────────
(function() {
  var hasResult = TOTAL > 0;
  if (!hasResult) {
    document.getElementById('chartResult').closest('.chart-card').innerHTML = '<h3>Result Distribution</h3><div class="empty-state"><div class="empty-state-icon">✓</div><p>No data yet</p></div>';
    return;
  }
  var rLabels = ['Success','Failed','Timeout'];
  var rData   = [SUCCESS, FAIL, TIMEOUT].filter(function(_,i){ return [SUCCESS,FAIL,TIMEOUT][i] > 0; });
  var rColors = [GREEN, RED, AMBER];
  var filtIdx = [SUCCESS,FAIL,TIMEOUT].map(function(v,i){ return v>0?i:-1; }).filter(function(i){ return i>=0; });
  new Chart(document.getElementById('chartResult'), {
    type: 'doughnut',
    data: {
      labels: filtIdx.map(function(i){ return rLabels[i]; }),
      datasets: [{
        data: rData,
        backgroundColor: filtIdx.map(function(i){ return rColors[i]; }),
        borderColor: '#141721', borderWidth: 3, hoverOffset: 8
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      plugins: {
        legend: { position: 'right', labels: { color: '#8B95B0', padding: 14, font: { size: 12 } } }
      },
      cutout: '68%'
    }
  });
}());

// ── Line: daily trend ─────────────────────────────────────────────────────────
if (trendData.length) {
  new Chart(document.getElementById('chartTrend'), {
    type: 'line',
    data: {
      labels: trendData.map(function(d){ return d.day; }),
      datasets: [
        {
          label: 'Total', data: trendData.map(function(d){ return d.n; }),
          borderColor: BLUE,
          backgroundColor: function(ctx) {
            var g = ctx.chart.ctx.createLinearGradient(0,0,0,200);
            g.addColorStop(0, 'rgba(59,130,246,.25)');
            g.addColorStop(1, 'rgba(59,130,246,0)');
            return g;
          },
          fill: true, tension: 0.4,
          pointRadius: trendData.length > 30 ? 0 : 4,
          pointHoverRadius: 6, borderWidth: 2.5
        },
        {
          label: 'Successful', data: trendData.map(function(d){ return d.success_count; }),
          borderColor: GREEN, backgroundColor: 'transparent',
          fill: false, tension: 0.4,
          pointRadius: 0, pointHoverRadius: 5,
          borderWidth: 1.5, borderDash: [5, 4]
        }
      ]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: { legend: { labels: { color: '#8B95B0', usePointStyle: true, padding: 18 } } },
      scales: {
        x: { grid: { color: 'rgba(255,255,255,.04)' }, ticks: { color: '#8B95B0', maxTicksLimit: 12 } },
        y: { grid: { color: 'rgba(255,255,255,.04)' }, ticks: { color: '#8B95B0' }, beginAtZero: true }
      }
    }
  });
}

} // end Chart.js guard

// ── Event log ─────────────────────────────────────────────────────────────────
var TOOL_LABELS = { converter: 'Converter', jmx: 'JMeter', recorder: 'Recorder', studio: 'Studio' };
var TOOL_BADGE  = { converter: 'badge-blue', jmx: 'badge-amber', recorder: 'badge-purple', studio: 'badge-green' };
var RESULT_BADGE = { success: 'badge-green', failed: 'badge-red', timeout: 'badge-amber' };

function fmtSize(kb) { if(!kb) return '—'; return kb < 1024 ? kb+'KB' : (kb/1024).toFixed(1)+'MB'; }
function fmtDur(ms)  { if(!ms) return '—'; return ms < 1000 ? ms+'ms' : (ms/1000).toFixed(1)+'s'; }
function fmtCorr(found, accepted) {
  if (!found && !accepted) return '—';
  if (accepted != null && found != null) return accepted + ' / ' + found;
  return (accepted || found || 0).toString();
}
function escHtml(s)  { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function clearFilters() {
  document.getElementById('fSearch').value = '';
  document.getElementById('fTool').value   = '';
  document.getElementById('fResult').value = '';
  loadEvents();
}

function buildUrl() {
  var base = '/admin/api/events?token=' + encodeURIComponent(ADMIN_TOKEN);
  var tool   = document.getElementById('fTool').value;
  var result = document.getElementById('fResult').value;
  var search = document.getElementById('fSearch').value;
  var from   = document.getElementById('fFrom').value;
  var to     = document.getElementById('fTo').value;
  if (tool)   base += '&tool='   + encodeURIComponent(tool);
  if (result) base += '&result=' + encodeURIComponent(result);
  if (search) base += '&search=' + encodeURIComponent(search);
  if (from)   base += '&from='   + encodeURIComponent(from);
  if (to)     base += '&to='     + encodeURIComponent(to);
  return base + '&limit=' + PAGE_SIZE + '&offset=' + evtOffset;
}

function loadEvents()   { evtOffset = 0; fetchEvents(); }
function debounceLoad() { clearTimeout(_debTimer); _debTimer = setTimeout(loadEvents, 350); }
function prevPage()     { evtOffset = Math.max(0, evtOffset - PAGE_SIZE); fetchEvents(); }
function nextPage()     { evtOffset += PAGE_SIZE; fetchEvents(); }

function fetchEvents() {
  fetch(buildUrl())
    .then(function(r){ return r.json(); })
    .then(function(data){
      evtTotal = data.total;
      var rows = data.rows || [];
      document.getElementById('evtCount').textContent = evtTotal.toLocaleString() + ' events';

      var page  = Math.floor(evtOffset / PAGE_SIZE) + 1;
      var pages = Math.ceil(evtTotal / PAGE_SIZE) || 1;
      document.getElementById('pageInfo').textContent = 'Page ' + page + ' of ' + pages;
      document.getElementById('btnPrev').disabled = evtOffset <= 0;
      document.getElementById('btnNext').disabled = evtOffset + PAGE_SIZE >= evtTotal;

      if (!rows.length) {
        document.getElementById('evtBody').innerHTML = '<tr><td colspan="12" class="empty-state"><div class="empty-state-icon">🔍</div><p>No events match the current filter</p></td></tr>';
        return;
      }

      var html = '';
      rows.forEach(function(r) {
        var ts     = r.started_at ? r.started_at.slice(0,16).replace('T',' ') : '—';
        var host   = escHtml(r.hostname || r.ip_address || '—');
        var ip     = escHtml(r.ip_address || '—');
        var ua     = escHtml([r.browser, r.os].filter(Boolean).join(' / ') || '—');
        var tool   = TOOL_LABELS[r.tool] || r.tool || '—';
        var tbadge = TOOL_BADGE[r.tool] || 'badge-gray';
        var proto  = escHtml(r.protocol || '—');
        var fname  = r.filename ? '<span title="' + escHtml(r.filename) + '" style="font-family:var(--mono);font-size:11px">' + escHtml(r.filename.length > 28 ? '…' + r.filename.slice(-26) : r.filename) + '</span>' : '—';
        var corr   = fmtCorr(r.correlations_found, r.correlations_accepted);
        var rbadge = RESULT_BADGE[r.result] || 'badge-gray';
        var err    = r.error_code ? '<br><span style="font-size:10px;color:var(--text-faint)">' + escHtml(r.error_code) + '</span>' : '';
        html += '<tr>'
          + '<td class="mono" style="font-size:11px;white-space:nowrap;color:var(--text-dim)">' + ts + '</td>'
          + '<td><span style="font-weight:600;font-size:12px">' + host + '</span></td>'
          + '<td class="mono" style="font-size:11px">' + ip + '</td>'
          + '<td style="font-size:11px;color:var(--text-dim);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + ua + '">' + ua + '</td>'
          + '<td><span class="badge ' + tbadge + '">' + escHtml(tool) + '</span></td>'
          + '<td class="mono" style="font-size:11px">' + proto + '</td>'
          + '<td>' + fname + '</td>'
          + '<td class="mono" style="font-size:11px">' + fmtSize(r.file_size_kb) + '</td>'
          + '<td class="mono" style="font-size:11px">' + (r.request_count != null ? r.request_count.toLocaleString() : '—') + '</td>'
          + '<td class="mono" style="font-size:11px">' + corr + '</td>'
          + '<td class="mono" style="font-size:11px">' + fmtDur(r.duration_ms) + '</td>'
          + '<td><span class="badge ' + rbadge + '">' + escHtml(r.result || '—') + '</span>' + err + '</td>'
          + '</tr>';
      });
      document.getElementById('evtBody').innerHTML = html;
    })
    .catch(function(){
      document.getElementById('evtBody').innerHTML = '<tr><td colspan="12" class="empty-state"><div class="empty-state-icon">⚠</div><p>Failed to load events</p></td></tr>';
    });
}

loadEvents();
</script>
</body>
</html>
