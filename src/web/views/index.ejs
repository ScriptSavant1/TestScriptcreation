<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- Panel: Postman / Bruno                                                 -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div class="card" id="panel-bruno">

  <!-- 1 · Protocol -->
  <div class="section-label"><span class="section-num">1</span>Choose Output Protocol</div>
  <div class="proto-grid">
    <div class="proto-card active-devweb" id="pc-devweb" onclick="setProto('devweb')">
      <div class="proto-icon proto-icon-blue">🟦</div>
      <div>
        <div class="proto-name">DevWeb · JavaScript</div>
        <div class="proto-desc">Modern JS protocol for LRE. Generates <strong>main.js</strong> with per-request transactions, correlations, JWT helper &amp; full config files.</div>
        <span class="proto-tag tag-js">⚡ main.js</span>
      </div>
    </div>
    <div class="proto-card" id="pc-vugen" onclick="setProto('web-http')">
      <div class="proto-icon proto-icon-orange">🟧</div>
      <div>
        <div class="proto-name">VuGen · Web HTTP/HTML (C)</div>
        <div class="proto-desc">Classic C-based VuGen protocol. Generates <strong>Action.c</strong> with web_custom_request, NTLM/Kerberos, jsrsasign &amp; all VuGen config.</div>
        <span class="proto-tag tag-c">⚙ Action.c</span>
      </div>
    </div>
  </div>

  <!-- 2 · Upload -->
  <div class="section-label"><span class="section-num">2</span>Upload Files</div>
  <div class="upload-grid">
    <div class="drop-zone" id="dz-col"
         ondragover="onDrag(event,'dz-col')" ondragleave="offDrag('dz-col')"
         ondrop="onDrop(event,'dz-col','collection')">
      <input type="file" id="fi-col" accept=".json,.yml,.yaml,.bru"
             onchange="onPick('dz-col','fi-col','lbl-col','collection')">
      <div class="dz-icon-wrap">📂</div>
      <div class="dz-label">Collection File <span class="dz-required">*</span></div>
      <div class="dz-sub">Postman v2.1 JSON &nbsp;·&nbsp; Bruno JSON / YAML &nbsp;·&nbsp; .bru</div>
      <div id="lbl-col" class="dz-name"></div>
    </div>
    <div class="drop-zone" id="dz-env"
         ondragover="onDrag(event,'dz-env')" ondragleave="offDrag('dz-env')"
         ondrop="onDrop(event,'dz-env','environment')">
      <input type="file" id="fi-env" accept=".json,.bru"
             onchange="onPick('dz-env','fi-env','lbl-env','environment')">
      <div class="dz-icon-wrap">🔑</div>
      <div class="dz-label">Environment File</div>
      <div class="dz-sub">Postman environment JSON &nbsp;·&nbsp; Bruno .bru vars</div>
      <span class="dz-opt">Optional — provides variable values</span>
      <div id="lbl-env" class="dz-name"></div>
    </div>
  </div>

  <!-- 2b · Client Certificates -->
  <div class="cert-zone-wrap">
    <div class="cert-zone-header">
      <span class="cert-zone-title">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--text-3)"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Client Certificates
      </span>
      <span class="cert-zone-badge">Optional — mutual TLS authentication</span>
    </div>
    <div class="drop-zone dz-secondary dz-cert-full" id="dz-bru-cert"
         ondragover="onDrag(event,'dz-bru-cert')" ondragleave="offDrag('dz-bru-cert')"
         ondrop="onDropBrunoCert(event)">
      <input type="file" id="fi-bru-cert" accept=".p12,.pem,.key" multiple
             onchange="onPickBrunoCert()">
      <div class="dz-icon-wrap">🛡️</div>
      <div class="cert-zone-body">
        <div class="dz-label">
          Drop certificate files here
          <span style="font-weight:400;color:var(--text-3);font-size:11px">&nbsp;or click to browse</span>
        </div>
        <div class="dz-sub">.p12 (PKCS12) &nbsp;·&nbsp; .pem (certificate) &nbsp;·&nbsp; .key (private key) &nbsp;·&nbsp; multiple files supported</div>
        <div id="bru-cert-chips" class="cert-chip-list"></div>
        <div id="bru-cert-hint" class="cert-add-hint" style="display:none">
