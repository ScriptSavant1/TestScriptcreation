/* ── Contents dropdown — replaces overflow pill row; scales to any # of sections ── */
.help-toc-bar { display: flex; align-items: center; gap: 8px; min-width: 0; }
.help-toc-trigger-wrap { position: relative; flex-shrink: 0; }
.help-toc-btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 12px 5px 10px; border-radius: 99px;
  background: var(--surface); border: 1px solid var(--glass-border);
  color: var(--text-2); cursor: pointer; font-size: 12px; font-weight: 600;
  white-space: nowrap; transition: background 0.15s, color 0.15s, border-color 0.15s;
}
.help-toc-btn:hover { background: var(--surface2); color: var(--text); border-color: rgba(79,142,247,0.25); }
.help-toc-btn:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
.help-toc-btn.open { background: var(--primary-dim); color: var(--primary); border-color: rgba(79,142,247,0.40); }
.htoc-list-icon { width: 14px; height: 14px; flex-shrink: 0; opacity: 0.7; }
.htoc-chevron { width: 13px; height: 13px; flex-shrink: 0; transition: transform 0.22s cubic-bezier(0.4,0,0.2,1); }
.help-toc-btn.open .htoc-chevron { transform: rotate(180deg); }
.help-toc-sep { color: var(--text-3); font-size: 14px; flex-shrink: 0; line-height: 1; }
.help-toc-cur-label { font-size: 12px; color: var(--text-2); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
/* Dropdown panel */
.help-toc-panel {
  position: absolute; top: calc(100% + 8px); left: 0;
  width: 500px; max-width: calc(100vw - 32px);
