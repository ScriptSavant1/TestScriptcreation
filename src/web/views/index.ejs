      <span class="opt-label">Log Level</span>
      <div class="seg-btns">
        <button class="seg-btn active" id="ll-info"  onclick="setLL('info')">Info</button>
        <button class="seg-btn"        id="ll-debug" onclick="setLL('debug')">Debug</button>
      </div>
    </div>
  </div>

  <!-- Advanced -->
  <button class="adv-toggle" id="adv-btn" onclick="toggleAdv()">
    <span class="arrow">▶</span> Advanced settings
  </button>
  <div class="adv-panel" id="adv-panel">
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Correlation Detection</div>
        <div class="tgl-sub">Extract dynamic values from API responses — access_token, userId, sessionId, CSRF tokens</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-corr" checked><span class="slider"></span></label>
    </div>
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Parameterization</div>
        <div class="tgl-sub">Convert static variables into CSV parameters — baseUrl, clientId, API keys</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-param" checked><span class="slider"></span></label>
    </div>
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Authentication Handling</div>
        <div class="tgl-sub">OAuth2, Bearer (dynamic-aware), Basic, API Key, JWT (PS256 / RS256 / HS256), AWS Sig v4</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-auth" checked><span class="slider"></span></label>
    </div>
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Add Code Comments</div>
        <div class="tgl-sub">Inline explanatory comments in the generated script to guide manual review</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-cmt" checked><span class="slider"></span></label>
    </div>
  </div>

  <div class="divider"></div>
  <div class="prog-wrap" id="prog-wrap"><div class="prog-fill" id="prog-fill"></div></div>
