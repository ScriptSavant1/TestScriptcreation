<!-- ══════════════════════════════════════════════════════════════════════ -->
<script>
/* ── Theme toggle ────────────────────────────────────────────────────────── */
function toggleTheme() {
  const html = document.documentElement;
  const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  localStorage.setItem('lr-theme', next);
  // Sync theme to any loaded iframe tools
  ['recorder','studio'].forEach(function(t) {
    const f = document.getElementById('iframe-' + t);
    if (f && f.contentWindow && f.contentWindow.lreSetTheme) {
      f.contentWindow.lreSetTheme(next);
    }
  });
}

/* ── State ──────────────────────────────────────────────────────────────── */
const S  = { proto:'devweb', mode:'single', tt:1, ll:'info' };
const F  = { collection:null, environment:null, certFiles:[] };
const JX = { proto:'devweb', mode:'single', tt:1, wlm:true, file:null, csvFiles:[], certFiles:[] };

/* ── Feature Flags ──────────────────────────────────────────────────────────
 * To disable a tool/tab: set enabled: false.
 * The tool's HTML and code are fully preserved — only the UI entry point is
 * hidden. Re-enable at any time by setting enabled: true.
 * ────────────────────────────────────────────────────────────────────────── */
// — Base path detection ————————————————————————————————————
  // Under IIS virtual dir 'converter', browser URL is /converter → base = '/converter'.
  // Standalone (localhost:3000/converter), base = '/converter'.
  // Standalone root (/), base = ''.
  const BASE_PATH = (function() {
    const p = window.location.pathname.replace(/\/+$/, '');
    if (p === '' || p === '/') return '';
    return p; // e.g. '/converter'
  })();

const PORTAL_CONFIG = {
  tabs: {
    home:      { enabled: true  },
    converter: { enabled: true  },
    recorder:  { enabled: true  },
    studio:    { enabled: true  },
    help:      { enabled: true  }
  },
  iframes: { recorder: BASE_PATH + '/recorder', studio: BASE_PATH + '/studio' }
};

/* ── Portal tab switching ───────────────────────────────────────────────── */
const PORTAL_PANELS = Object.keys(PORTAL_CONFIG.tabs);
let   _iframeLoaded = {};
let   _activeTab    = 'home';

function switchPortalTab(tab) {
  if (!PORTAL_CONFIG.tabs[tab]?.enabled) return; // guard: disabled tab

  _activeTab = tab;

  // Show/hide the global Clear button — only on tool tabs
  const clearBtn = document.getElementById('btn-global-clear');
  if (clearBtn) clearBtn.style.display = ['converter','recorder','studio'].includes(tab) ? 'flex' : 'none';

  // Update tab button active state
  PORTAL_PANELS.forEach(t => {
    const btn = document.getElementById('ptab-' + t);
    if (btn) btn.className = 'ptab' + (t === tab ? ' ptab-active' : '');
  });

  // Show/hide panels
  PORTAL_PANELS.forEach(t => {
    const panel = document.getElementById('portal-' + t);
    if (panel) panel.style.display = (t === tab) ? 'flex' : 'none';
  });

  // Lazy-load iframes on first visit, then init portal theme
  if (PORTAL_CONFIG.iframes[tab] && !_iframeLoaded[tab]) {
    _iframeLoaded[tab] = true;
    const iframeEl = document.getElementById('iframe-' + tab);
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    iframeEl.onload = function() {
      if (iframeEl.contentWindow && iframeEl.contentWindow.lrePortalInit) {
        iframeEl.contentWindow.lrePortalInit(currentTheme);
      }
    };
    iframeEl.src = PORTAL_CONFIG.iframes[tab];
  }

  window.scrollTo({ top: 0, behavior: 'smooth' });
}

/* ── Global Clear ───────────────────────────────────────────────────────── */
function globalClear() {
  if (_activeTab === 'converter') {
    _clearConverter();
  } else if (_activeTab === 'recorder' || _activeTab === 'studio') {
    _clearIframeTool(_activeTab);
  }
}

function _clearConverter() {
  // Reset file state objects
  F.collection = null; F.environment = null; F.certFiles = [];
  JX.file = null; JX.csvFiles = []; JX.certFiles = [];

  // Clear Bruno/Postman collection + environment drop zones
  ['dz-col','dz-env'].forEach(function(id) {
    const dz = document.getElementById(id); if (!dz) return;
    dz.classList.remove('loaded');
    const x = dz.querySelector('.dz-clear'); if (x) x.remove();
  });
  const lblCol = document.getElementById('lbl-col'); if (lblCol) lblCol.textContent = '';
  const lblEnv = document.getElementById('lbl-env'); if (lblEnv) lblEnv.textContent = '';

  // Clear cert chips (Bruno panel)
  const chips = document.getElementById('bru-cert-chips'); if (chips) chips.innerHTML = '';
  const hint  = document.getElementById('bru-cert-hint');  if (hint)  hint.style.display = 'none';

  // Clear JMX file drop zone
  const dzJmx = document.getElementById('dz-jmx');
  if (dzJmx) {
    dzJmx.classList.remove('loaded');
    const x = dzJmx.querySelector('.dz-clear'); if (x) x.remove();
    const lbl = document.getElementById('lbl-jmx'); if (lbl) lbl.textContent = '';
  }

  // Clear JMX supporting files (CSV, cert)
  ['dz-csv','dz-cert'].forEach(function(id) {
    const dz = document.getElementById(id); if (!dz) return;
    dz.classList.remove('loaded');
    const x = dz.querySelector('.dz-clear'); if (x) x.remove();
  });
  const lblCsv  = document.getElementById('lbl-csv');  if (lblCsv)  lblCsv.textContent  = '';
  const lblCert = document.getElementById('lbl-cert'); if (lblCert) lblCert.textContent = '';

  // Reset all file input elements so the same file can be re-selected
  ['fi-col','fi-env','fi-bru-cert','fi-jmx','fi-csv','fi-cert'].forEach(function(id) {
    const el = document.getElementById(id); if (el) el.value = '';
  });

  // Hide results + reset convert buttons
  hideResults();
  resetBtn();
  resetJmxBtn();
}

function _clearIframeTool(toolName) {
  const iframeEl = document.getElementById('iframe-' + toolName);
  if (!iframeEl) return;
  const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
  iframeEl.onload = function() {
    if (iframeEl.contentWindow && iframeEl.contentWindow.lrePortalInit) {
      iframeEl.contentWindow.lrePortalInit(currentTheme);
    }
    _iframeLoaded[toolName] = true;
  };
  // Reload the iframe — definitive reset of all client-side state
  iframeEl.src = PORTAL_CONFIG.iframes[toolName];
  _iframeLoaded[toolName] = true; // prevent duplicate load on next tab switch
}

// Initialise: apply feature flags, then show home
(function initPortal() {
  PORTAL_PANELS.forEach(t => {
    const enabled = PORTAL_CONFIG.tabs[t].enabled;
    // Hide tab nav button for disabled tools
    const btn = document.getElementById('ptab-' + t);
    if (btn) btn.style.display = enabled ? '' : 'none';
    // Hide home-page tool card for disabled tools (cards use id="tc-{tab}")
    const card = document.getElementById('tc-' + t);
    if (card) card.style.display = enabled ? '' : 'none';
    // Hide all panels — switchPortalTab('home') will reveal home
    const panel = document.getElementById('portal-' + t);
    if (panel && t !== 'home') panel.style.display = 'none';
  });
  switchPortalTab('home');
})();

/* ── Open specific converter sub-tab from home cards ────────────────────── */
function openConverterTab(subTab) {
