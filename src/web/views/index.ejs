<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- PORTAL: HOME PANEL                                                     -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div id="portal-home">

  <!-- Hero -->
  <header class="home-hero">
    <div class="home-hero-badge">⚡ PerfX Studio — LoadRunner Script Generation Platform</div>
    <h1>PerfX Studio</h1>
    <p class="home-hero-sub">Four tools that generate production-ready LoadRunner VuGen scripts from any starting point — API collections, JMeter scripts, or browser recordings. Automatic correlation, authentication, and parameterization included.</p>
    <div class="hero-badges">
      <span class="chip">📂 Postman · Bruno</span>
      <span class="chip">♨ JMeter .jmx</span>
      <span class="chip">🎙 HAR Recording</span>
      <span class="chip">🟦 DevWeb JS</span>
      <span class="chip">🟧 VuGen C</span>
      <span class="chip">🔒 In-memory only</span>
    </div>
  </header>

  <!-- Tool Cards (2×2 grid) -->
  <div class="tool-cards">

    <!-- Card 1: Postman / Bruno Converter -->
    <div class="tool-card tc-blue" id="tc-converter" role="button" tabindex="0"
         onclick="openConverterTab('bruno')"
         onkeydown="if(event.key==='Enter'||event.key===' ')openConverterTab('bruno')">
      <div class="tc-icon tc-icon-blue">📂</div>
      <span class="tc-tag tc-tag-blue">Postman · Bruno → VuGen</span>
      <div class="tc-title">Postman / Bruno Converter</div>
      <div class="tc-desc">Convert Postman or Bruno API collections into VuGen scripts. Upload your collection and an optional environment file — get a fully scripted, ready-to-run VuGen project in seconds.</div>
      <ul class="tc-features">
        <li>Postman v2.1 JSON, Bruno JSON / YAML / .bru</li>
        <li>Output: DevWeb (JavaScript) or Web HTTP/HTML (C)</li>
        <li>Auth: OAuth2, JWT, DPoP, PKCE, NTLM, AWS Sig v4</li>
        <li>Multi-script mode — one script per collection folder</li>
      </ul>
      <div class="tc-cta">
        <span class="tc-cta-text">Open Postman / Bruno Converter</span>
        <span class="tc-cta-arrow">→</span>
      </div>
    </div>

    <!-- Card 2: JMeter Converter -->
    <div class="tool-card tc-orange" id="tc-jmeter" role="button" tabindex="0"
         onclick="openConverterTab('jmx')"
         onkeydown="if(event.key==='Enter'||event.key===' ')openConverterTab('jmx')">
      <div class="tc-icon tc-icon-orange">♨</div>
      <span class="tc-tag tc-tag-orange">JMeter .jmx → VuGen</span>
      <div class="tc-title">JMeter Converter</div>
      <div class="tc-desc">Convert Apache JMeter test plans (.jmx) into VuGen scripts. Upload your .jmx, optional CSV data files and certificates — get a complete VuGen script with thread group structure preserved.</div>
      <ul class="tc-features">
        <li>JMeter .jmx — all thread group types supported</li>
        <li>CSV data files and certificate files included in output</li>
        <li>Generates Workload Model Excel (.xlsx) automatically</li>
        <li>Multi-script mode — one script per thread group</li>
      </ul>
      <div class="tc-cta">
        <span class="tc-cta-text">Open JMeter Converter</span>
        <span class="tc-cta-arrow">→</span>
      </div>
    </div>

    <!-- Card 3: Recorder -->
    <div class="tool-card tc-green" id="tc-recorder" role="button" tabindex="0"
         onclick="switchPortalTab('recorder')"
         onkeydown="if(event.key==='Enter'||event.key===' ')switchPortalTab('recorder')">
      <div class="tc-icon tc-icon-green">🎙</div>
      <span class="tc-tag tc-tag-green">Browser Recording → VuGen</span>
      <div class="tc-title">Recorder</div>
      <div class="tc-desc">VuGen recording does not work on many VCSE and corporate machines. Capture traffic using your browser instead — two methods available: the classic bookmarklet (zero install) or the PerfX Extension (hands-free side panel).</div>
      <ul class="tc-features">
        <li>Classic: bookmarklet + F12 DevTools — no install needed</li>
        <li>Extension: dedicated side panel, no DevTools required</li>
        <li>Filter domains and mark transaction boundaries visually</li>
        <li>Output: DevWeb (JavaScript) or Web HTTP/HTML (C)</li>
      </ul>
      <div class="tc-cta">
        <span class="tc-cta-text">Open Recorder</span>
        <span class="tc-cta-arrow">→</span>
      </div>
    </div>

    <!-- Card 4: Script Studio -->
    <div class="tool-card tc-purple" id="tc-studio" role="button" tabindex="0"
         onclick="switchPortalTab('studio')"
         onkeydown="if(event.key==='Enter'||event.key===' ')switchPortalTab('studio')">
      <div class="tc-icon tc-icon-purple">🧪</div>
      <span class="tc-tag tc-tag-purple">HAR → Correlated Script</span>
      <div class="tc-title">Script Studio</div>
      <div class="tc-desc">Upload one or two HAR files to get a correlated VuGen script. Two HARs (same journey recorded twice with different data) enables diff-based analysis — automatically finding every dynamic value for the most complete correlation possible.</div>
      <ul class="tc-features">
        <li>1 HAR — pattern-based correlation (quick start)</li>
        <li>2 HARs — diff analysis (deepest, most reliable correlation)</li>
        <li>Correlation Advisor — review and accept found correlations</li>
        <li>Paste &amp; Detect — manually add any extractor in one click</li>
      </ul>
      <div class="tc-cta">
        <span class="tc-cta-text">Open Script Studio</span>
        <span class="tc-cta-arrow">→</span>
      </div>
    </div>

  </div>

  <!-- ── PerfX Extension banner ──────────────────────────────────────────── -->
  <!-- Temporarily hidden: many corporate environments block "Load unpacked" via -->
  <!-- Group Policy, so the extension install path isn't usable for those users. -->
  <!-- Flip SHOW_EXT_BANNER back to true to bring it back — code left intact. -->
  <% const SHOW_EXT_BANNER = false; %>
  <% if (SHOW_EXT_BANNER) { %>
  <div class="ext-banner">
    <span class="ext-banner-badge">New</span>
    <div class="ext-banner-body">
      <div class="ext-banner-title">PerfX Recorder Extension — record without opening DevTools</div>
      <div class="ext-banner-sub">A dedicated Chrome side panel that captures your traffic, names transactions, and sends the HAR straight to Script Studio. <strong>No F12, no manual export.</strong> One-time install — 5 steps.</div>
    </div>
    <button class="ext-get-btn" onclick="openExtModal(event)">⬇ Get Extension</button>
  </div>
  <% } %>

  <!-- Which tool do I need? -->
  <div class="hw-section">
    <div class="hw-section-title">Which tool do I need?</div>
    <div class="decision-grid">

      <div class="decision-card">
        <div class="decision-q">I have a Postman or Bruno API collection (.json, .yml, .bru)</div>
        <div class="decision-arrow">↓</div>
        <div class="decision-a tc-blue-a">
          <span class="decision-tool">📂 Postman / Bruno Converter</span>
          <span class="decision-hint">Upload your collection (+ optional environment file), choose DevWeb or VuGen C output, download ZIP, open in VuGen.</span>
        </div>
      </div>

      <div class="decision-card">
        <div class="decision-q">I have an existing JMeter test plan (.jmx)</div>
        <div class="decision-arrow">↓</div>
        <div class="decision-a" style="background:rgba(240,136,62,0.08);border:1px solid rgba(240,136,62,0.20);border-radius:var(--r-md);display:flex;flex-direction:column;gap:7px;padding:14px 16px">
          <span class="decision-tool" style="color:var(--vugen)">♨ JMeter Converter</span>
          <span class="decision-hint">Upload your .jmx (+ optional CSV and certificate files). Get a VuGen script with all thread groups, extractors, and a Workload Model Excel.</span>
        </div>
      </div>

      <div class="decision-card">
        <div class="decision-q">I need to record a new user journey — VuGen recording doesn't work on my machine</div>
        <div class="decision-arrow">↓</div>
        <div class="decision-a tc-green-a">
          <span class="decision-tool">🎙 Recorder → then 🧪 Script Studio</span>
          <span class="decision-hint">Two recording options: <strong>Classic</strong> — F12 DevTools bookmarklet, no install. <strong>Extension</strong> — dedicated side panel, auto-exports HAR, one-time 5-step install. Both feed into Recorder, then Script Studio for correlation.</span>
        </div>
      </div>

      <div class="decision-card">
        <div class="decision-q">I already have a HAR file and want a script with automatic correlation</div>
        <div class="decision-arrow">↓</div>
        <div class="decision-a tc-purple-a">
          <span class="decision-tool">🧪 Script Studio</span>
          <span class="decision-hint">Upload 1 HAR for pattern-based correlation. Record the same journey twice and upload 2 HARs for diff-based analysis — the most complete correlation.</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Footer for home panel -->
  <footer>
    <div class="footer-links">
      <span>PerfX Studio · Performance Script Generation</span>
      <span class="footer-sep">·</span>
      <span>Files processed in-memory — nothing stored on server</span>
    </div>
  </footer>
</div><!-- /#portal-home -->

