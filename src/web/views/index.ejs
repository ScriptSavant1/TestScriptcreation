<!-- PORTAL: HELP PANEL                                                      -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div id="portal-help" style="display:none" class="portal-content-panel">
<div class="help-wrap">

  <!-- Page title -->
  <div class="help-page-title">
    <div class="home-hero-badge" style="margin-bottom:16px">📖 Documentation</div>
    <h1 class="help-h1">Help &amp; User Guide</h1>
    <p class="help-intro">Everything you need to use this toolkit — from first-time setup to advanced correlation. Designed for both technical and non-technical users.</p>
  </div>

  <!-- ── SECTION: What is this toolkit? ──────────────────────────────────── -->
  <section class="help-section">
    <h2 class="help-h2">What is this toolkit?</h2>
    <p class="help-p">This is a set of three browser-based tools that help performance engineers create LoadRunner VuGen scripts — without having to write code from scratch.</p>
    <p class="help-p">LoadRunner Enterprise (LRE) uses <strong>VuGen</strong> to simulate users. VuGen scripts are what describe the user journey — clicking buttons, submitting forms, making API calls. Writing these scripts manually is time-consuming. This toolkit generates them automatically from files you already have (API collections, browser recordings, or JMeter scripts).</p>
    <div class="help-callout help-callout-blue">
      <strong>No files are stored on the server.</strong> Everything you upload is processed in-memory and immediately discarded. The only thing that leaves the server is your downloaded ZIP file.
    </div>
  </section>

  <!-- ── SECTION: Output formats ─────────────────────────────────────────── -->
  <section class="help-section">
    <h2 class="help-h2">Output formats — which should I choose?</h2>
    <p class="help-p">All three tools can generate scripts in either of two formats:</p>
    <div class="help-formats">
      <div class="help-format-card help-format-blue">
        <div class="help-format-title">🟦 DevWeb · JavaScript</div>
        <p class="help-format-desc">The modern LoadRunner protocol. Scripts are written in JavaScript and run in a Node.js-like environment. Generates a <code>main.js</code> file.</p>
        <p class="help-format-rec"><strong>Choose this if:</strong> your team uses LRE 2021 or later, or you are comfortable with JavaScript.</p>
      </div>
      <div class="help-format-card help-format-orange">
        <div class="help-format-title">🟧 Web HTTP/HTML · C</div>
        <p class="help-format-desc">The classic VuGen protocol. Scripts are written in C and use familiar VuGen functions like <code>web_url()</code> and <code>web_custom_request()</code>. Generates an <code>Action.c</code> file.</p>
        <p class="help-format-rec"><strong>Choose this if:</strong> your team uses older LRE versions or prefers the traditional VuGen scripting style.</p>
      </div>
    </div>
    <p class="help-p">Not sure? Ask your LRE administrator which protocol your project uses. When in doubt, choose <strong>DevWeb</strong> — it is the current default for new projects.</p>
  </section>

  <!-- ── SECTION: Converter ──────────────────────────────────────────────── -->
  <section class="help-section">
    <div class="help-tool-badge help-badge-blue">⚡ Converter</div>
    <h2 class="help-h2">Converter — Collections &amp; JMX to VuGen</h2>
    <p class="help-p">Use this tool when you already have an API collection (Postman or Bruno) or an existing JMeter script (.jmx) and want to convert it into a VuGen script.</p>

    <h3 class="help-h3">Postman / Bruno Collections</h3>
    <p class="help-p"><strong>Supported file formats:</strong></p>
    <ul class="help-list">
      <li><strong>Postman v2.1</strong> — export from Postman as a Collection v2.1 JSON file</li>
      <li><strong>Bruno JSON</strong> — the <code>.json</code> export from Bruno</li>
      <li><strong>Bruno YAML</strong> — <code>.yml</code> or <code>.yaml</code> files</li>
      <li><strong>Bruno folder</strong> — a directory containing <code>.bru</code> files (export as zip then upload)</li>
      <li><strong>Single .bru file</strong> — a single Bruno request file</li>
    </ul>
    <p class="help-p">You can also upload an <strong>Environment file</strong> alongside your collection. This fills in variable values (like base URLs, API keys, usernames) in the generated script.</p>

    <h3 class="help-h3">JMeter Scripts (.jmx)</h3>
    <p class="help-p">Upload a JMeter <code>.jmx</code> file exported from Apache JMeter. You can also upload:</p>
    <ul class="help-list">
      <li><strong>CSV files</strong> — if your JMeter script uses CSVDataSet elements to read test data</li>
      <li><strong>Certificate files</strong> — if your script uses client certificates for authentication</li>
    </ul>

    <h3 class="help-h3">Step-by-step</h3>
    <ol class="help-steps-list">
      <li>Click <strong>Converter</strong> in the top navigation.</li>
      <li>Select the tab matching your input: <strong>Postman / Bruno</strong> or <strong>JMeter (.jmx)</strong>.</li>
      <li>Choose your output format: <strong>DevWeb</strong> or <strong>Web HTTP/HTML</strong>.</li>
      <li>Drag and drop your file into the upload area, or click to browse.</li>
      <li>Adjust options (transactions, correlation, parameterization, think time) as needed.</li>
      <li>Click <strong>Convert</strong>.</li>
      <li>When conversion completes, click <strong>Download ZIP</strong>.</li>
      <li>Extract the ZIP and open the <code>.usr</code> file in VuGen, or upload it directly to LoadRunner Enterprise.</li>
    </ol>

    <div class="help-callout help-callout-amber">
      <strong>Multi-script mode:</strong> If your collection has multiple folders (Postman) or thread groups (JMeter), enable <em>Multi-script mode</em> to generate one separate script per folder/group instead of one combined script.
    </div>
  </section>

  <!-- ── SECTION: Recorder ───────────────────────────────────────────────── -->
  <section class="help-section">
    <div class="help-tool-badge help-badge-green">🎙 Recorder</div>
    <h2 class="help-h2">Recorder — HAR File to VuGen Script</h2>
    <p class="help-p">On VCSE machines, VuGen's built-in recording does not work. The proxy cannot be installed and browser events do not get captured. The Recorder tool solves this by letting you record your user journey using only your browser — no VuGen installation needed for recording.</p>

    <h3 class="help-h3">What is a HAR file?</h3>
    <p class="help-p">A HAR (HTTP Archive) file is a recording of all the network requests your browser made during a session. Every modern browser's Developer Tools (F12) can export one. It contains all the URLs, request headers, request bodies, and responses for everything that happened during your recording.</p>

    <h3 class="help-h3">Step-by-step</h3>
    <ol class="help-steps-list">
      <li>Open the <strong>Recorder</strong> tab and follow the <em>Bookmarklet Setup</em> instructions to install the recording helper in your browser bookmarks bar. You only need to do this once.</li>
      <li>Open your browser and navigate to the application you want to test.</li>
      <li>Open <strong>DevTools</strong> (press F12) and go to the <strong>Network</strong> tab. Make sure recording is on (the red circle should be active).</li>
      <li>Perform your complete user journey — log in, navigate pages, submit forms — exactly as a real user would.</li>
      <li>When done, in DevTools Network tab click the <strong>Export HAR</strong> button (the download icon) and save the <code>.har</code> file.</li>
      <li>Come back to the Recorder tool and drag the <code>.har</code> file into the drop zone, or click to browse.</li>
      <li>Use the <strong>Domain Filter</strong> to uncheck domains you do not want in your script (e.g. analytics, CDNs, fonts).</li>
      <li>Drag request rows to group them into named <strong>transactions</strong> if needed.</li>
      <li>Choose your output format (<strong>DevWeb</strong> or <strong>Web HTTP/HTML</strong>) and click <strong>Generate Script</strong>.</li>
      <li>Download the ZIP and open it in VuGen.</li>
    </ol>

    <div class="help-callout help-callout-green">
      <strong>Tip:</strong> For deeper correlation (auto-detection of dynamic values like tokens and session IDs), take your HAR file into <strong>Script Studio</strong> after recording. Record the same journey twice and upload both HAR files to Script Studio for the most complete result.
    </div>
  </section>

  <!-- ── SECTION: Script Studio ──────────────────────────────────────────── -->
  <section class="help-section">
    <div class="help-tool-badge help-badge-purple">🧪 Script Studio</div>
    <h2 class="help-h2">Script Studio — HAR Correlation Engine</h2>
    <p class="help-p">Script Studio takes HAR files and generates VuGen scripts with <strong>correlation</strong> already built in. Correlation means the script automatically captures dynamic values (like login tokens, session IDs, CSRF tokens, and order IDs) from server responses and reuses them in later requests — just like a real user's browser does.</p>

    <h3 class="help-h3">What is correlation and why does it matter?</h3>
    <p class="help-p">When you log in to a web application, the server sends back a token or session ID. Every request after that must include this token. If your script has the token hard-coded from your recording session, it will fail when run again because the server issues a new token each time. Correlation solves this by extracting the token dynamically at runtime and passing it forward automatically.</p>
    <p class="help-p">Without correlation, your script will fail on replay. Script Studio generates the extraction and substitution code for you automatically.</p>

    <h3 class="help-h3">1 HAR vs 2 HARs — what is the difference?</h3>
    <div class="help-formats">
      <div class="help-format-card help-format-purple1">
        <div class="help-format-title">1 HAR file</div>
        <p class="help-format-desc">Script Studio uses pattern-based analysis to find values that look dynamic (UUIDs, tokens, long random strings, timestamps). This is fast and works well for simple applications.</p>
        <p class="help-format-rec"><strong>Use when:</strong> you have one recording and want a quick result. Some correlations may need manual adjustment.</p>
      </div>
      <div class="help-format-card help-format-purple2">
        <div class="help-format-title">2 HAR files (recommended)</div>
        <p class="help-format-desc">Record the exact same user journey twice with different data (e.g. two different logins). Script Studio compares both recordings and finds every value that changed between runs — these are guaranteed to be dynamic. This produces far more complete and accurate correlation.</p>
        <p class="help-format-rec"><strong>Use when:</strong> you want the most reliable script. This is the recommended approach for any application with login, tokens, or session management.</p>
      </div>
    </div>

    <h3 class="help-h3">Step-by-step</h3>
    <ol class="help-steps-list">
      <li>Use the <strong>Recorder</strong> tool (or browser DevTools directly) to create your HAR file(s).</li>
      <li>For 2-HAR mode: record the same journey twice using different test credentials or data.</li>
      <li>Open <strong>Script Studio</strong> from the navigation.</li>
      <li>Drag your first HAR file into the <strong>Recording 1</strong> drop zone. For 2-HAR mode, drag the second into the <strong>Recording 2</strong> drop zone.</li>
      <li>Choose your output format: <strong>DevWeb</strong>, <strong>Web HTTP/HTML</strong>, or <strong>Both</strong>.</li>
      <li>Click <strong>Analyze</strong>.</li>
      <li>Review the correlation and parameterization results shown.</li>
      <li>Click <strong>Download ZIP</strong> and open the script in VuGen.</li>
    </ol>
  </section>

  <!-- ── SECTION: Glossary ────────────────────────────────────────────────── -->
  <section class="help-section">
    <h2 class="help-h2">Glossary</h2>
    <dl class="help-glossary">
      <dt>VuGen</dt>
      <dd>Virtual User Generator — the tool in LoadRunner Enterprise used to create and edit performance test scripts that simulate real users.</dd>
      <dt>LRE / LoadRunner Enterprise</dt>
      <dd>The performance testing platform. Scripts created by this toolkit are designed to run on LRE.</dd>
      <dt>DevWeb</dt>
      <dd>A modern LoadRunner protocol where scripts are written in JavaScript. Scripts run as <code>main.js</code>.</dd>
      <dt>Web HTTP/HTML (C)</dt>
      <dd>The classic LoadRunner protocol where scripts are written in C. Scripts run as <code>Action.c</code>.</dd>
      <dt>HAR file</dt>
      <dd>HTTP Archive — a JSON file exported from your browser's Developer Tools that contains a complete recording of all network requests made during a session.</dd>
      <dt>Correlation</dt>
      <dd>The process of capturing a dynamic value (like a token or session ID) from a server response and automatically inserting it into later requests, so the script works correctly on every run.</dd>
      <dt>Parameterization</dt>
      <dd>Replacing a hard-coded value (like a username or password) in a script with a variable that reads from a data file, so different virtual users use different data.</dd>
      <dt>Transaction</dt>
      <dd>A named measurement boundary in a VuGen script. LoadRunner records response time for each transaction separately, so you can see performance for specific user actions (e.g. "Login", "Search", "Checkout").</dd>
      <dt>CSVDataSet (JMeter)</dt>
      <dd>A JMeter feature that reads test data from a CSV file at runtime. When converting a JMX file, upload any CSV files your script references alongside the .jmx.</dd>
    </dl>
  </section>

  <!-- ── SECTION: FAQ ─────────────────────────────────────────────────────── -->
  <section class="help-section">
    <h2 class="help-h2">Frequently Asked Questions</h2>

    <div class="help-faq">
      <div class="help-faq-item">
        <div class="help-faq-q">Which output format should I choose — DevWeb or Web HTTP/HTML?</div>
        <div class="help-faq-a">Ask your LRE administrator or project lead. If you are starting a new project on LRE 2021 or later, DevWeb (JavaScript) is recommended. For existing projects or older LRE versions, use Web HTTP/HTML (C).</div>
      </div>
      <div class="help-faq-item">
        <div class="help-faq-q">My download failed or the ZIP is empty. What happened?</div>
        <div class="help-faq-a">The download link is single-use and expires after 5 minutes. If you waited too long or clicked the link more than once, go back and run the conversion again — it only takes a few seconds.</div>
      </div>
      <div class="help-faq-item">
        <div class="help-faq-q">My script runs but fails with "invalid token" or "session expired" errors.</div>
        <div class="help-faq-a">This means the script has a hard-coded value that needs to be correlated. Use Script Studio with 2 HAR files (record the same journey twice) for the most complete correlation. The diff-based analysis will find the values causing the failure.</div>
      </div>
      <div class="help-faq-item">
        <div class="help-faq-q">Can I upload files from a shared drive or network path?</div>
        <div class="help-faq-a">Yes — the upload areas accept any file you can access from your machine. Just browse to the file location as normal.</div>
      </div>
      <div class="help-faq-item">
        <div class="help-faq-q">Are my files stored on the server?</div>
        <div class="help-faq-a">No. Files are processed entirely in memory and are never written to disk. Nothing persists on the server between requests. Your data is not accessible to anyone else.</div>
      </div>
      <div class="help-faq-item">
        <div class="help-faq-q">The conversion completed but the script doesn't look right. What should I check?</div>
        <div class="help-faq-a">Check that you uploaded the correct file format (e.g. Postman v2.1, not v2.0). For Bruno collections, make sure you exported from Bruno correctly. For JMeter, ensure the .jmx file is from a supported JMeter version and includes all referenced CSV files.</div>
      </div>
    </div>
  </section>

</div><!-- /.help-wrap -->
</div><!-- /#portal-help -->

<!-- ══════════════════════════════════════════════════════════════════════ -->
<script>
/* ── Theme toggle ────────────────────────────────────────────────────────── */
function toggleTheme() {
  const html = document.documentElement;
  const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  localStorage.setItem('lr-theme', next);
  // Sync theme to any loaded iframe tools
  ['recorder','studio'].forEach(function(t) {
    const f = document.getElementById('iframe-' + t);
    if (f && f.contentWindow && f.contentWindow.lreSetTheme) {
      f.contentWindow.lreSetTheme(next);
    }
  });
}

/* ── State ──────────────────────────────────────────────────────────────── */
const S  = { proto:'devweb', mode:'single', tt:1, ll:'info' };
const F  = { collection:null, environment:null };
const JX = { proto:'devweb', mode:'single', tt:1, wlm:true, file:null, csvFiles:[], certFiles:[] };

/* ── Portal tab switching ───────────────────────────────────────────────── */
const PORTAL_PANELS    = ['home','converter','recorder','studio','help'];
const PORTAL_IFRAMES   = { recorder: '/tools/recorder', studio: '/tools/studio' };
let   _iframeLoaded    = {};

function switchPortalTab(tab) {
  // Update tab button classes
  PORTAL_PANELS.forEach(t => {
    const btn = document.getElementById('ptab-' + t);
    if (btn) btn.className = 'ptab' + (t === tab ? ' ptab-active' : '');
  });

  // Show/hide panels
  const home      = document.getElementById('portal-home');
  const converter = document.getElementById('portal-converter');
  const recorder  = document.getElementById('portal-recorder');
  const studio    = document.getElementById('portal-studio');
  const help      = document.getElementById('portal-help');

  home.style.display      = tab === 'home'      ? 'flex'  : 'none';
  converter.style.display = tab === 'converter' ? 'flex'  : 'none';
  recorder.style.display  = tab === 'recorder'  ? 'flex'  : 'none';
  studio.style.display    = tab === 'studio'    ? 'flex'  : 'none';
  help.style.display      = tab === 'help'      ? 'flex'  : 'none';

  // Lazy-load iframes on first visit, then init portal theme
  if (PORTAL_IFRAMES[tab] && !_iframeLoaded[tab]) {
    _iframeLoaded[tab] = true;
    const iframeEl = document.getElementById('iframe-' + tab);
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    iframeEl.onload = function() {
      if (iframeEl.contentWindow && iframeEl.contentWindow.lrePortalInit) {
        iframeEl.contentWindow.lrePortalInit(currentTheme);
      }
    };
    iframeEl.src = PORTAL_IFRAMES[tab];
  }

  // Scroll to top when switching
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

// Initialise: show home, hide rest
(function initPortal() {
  document.getElementById('portal-converter').style.display = 'none';
  document.getElementById('portal-recorder').style.display  = 'none';
  document.getElementById('portal-studio').style.display    = 'none';
  document.getElementById('portal-help').style.display      = 'none';
})();

/* ── Converter tab switching ────────────────────────────────────────────── */
function switchTab(tab) {
  document.getElementById('panel-bruno').style.display = tab === 'bruno' ? '' : 'none';
  document.getElementById('panel-jmx').style.display   = tab === 'jmx'   ? '' : 'none';
  document.getElementById('tab-bruno').className = 'tab-btn' + (tab === 'bruno' ? ' active-bruno' : '');
  document.getElementById('tab-jmx').className   = 'tab-btn' + (tab === 'jmx'   ? ' active-jmx'   : '');
  hideResults();
}

/* ── Protocol selectors ─────────────────────────────────────────────────── */
function setProto(p) {
  S.proto = p;
  document.getElementById('pc-devweb').className = 'proto-card' + (p === 'devweb'   ? ' active-devweb' : '');
  document.getElementById('pc-vugen').className  = 'proto-card' + (p === 'web-http' ? ' active-vugen'  : '');
  const btn = document.getElementById('btn-cvt');
  btn.className = 'btn-convert ' + (p === 'devweb' ? 'devweb' : 'vugen');
  document.getElementById('btn-lbl').textContent = p === 'devweb'
    ? '⚡ Convert to DevWeb Script' : '⚙️  Convert to VuGen Web HTTP/HTML';
}

function setJmxProto(p) {
  JX.proto = p;
  document.getElementById('jpc-devweb').className = 'proto-card' + (p === 'devweb'   ? ' active-devweb' : '');
  document.getElementById('jpc-vugen').className  = 'proto-card' + (p === 'web-http' ? ' active-vugen'  : '');
  const btn = document.getElementById('btn-jmx');
  btn.className = 'btn-convert ' + (p === 'devweb' ? 'devweb' : 'vugen');
  document.getElementById('jbtn-lbl').textContent = p === 'devweb'
    ? '♨ Convert JMeter to DevWeb Script' : '♨ Convert JMeter to VuGen Web HTTP/HTML';
}

/* ── Option pickers ─────────────────────────────────────────────────────── */
function setMode(m) {
  S.mode = m;
  ['single','multi'].forEach(x =>
    document.getElementById('m-'+x).className = 'seg-btn' + (m === x ? ' active' : ''));
}
function setTT(t) {
  S.tt = t;
  [1,2,3,5].forEach(n =>
    document.getElementById('tt-'+n).className = 'seg-btn' + (n === t ? ' active' : ''));
}
function setLL(l) {
  S.ll = l;
  ['info','debug'].forEach(x =>
    document.getElementById('ll-'+x).className = 'seg-btn' + (l === x ? ' active' : ''));
}
function setJmxTT(t) {
  JX.tt = t;
  [1,2,3,5].forEach(n =>
    document.getElementById('jtt-'+n).className = 'seg-btn' + (n === t ? ' active' : ''));
}
function setJmxWlm(v) {
  JX.wlm = v;
  document.getElementById('jwlm-yes').className = 'seg-btn' + ( v ? ' active' : '');
  document.getElementById('jwlm-no').className  = 'seg-btn' + (!v ? ' active' : '');
}
function setJmxMode(m) {
  JX.mode = m;
  document.getElementById('jmode-single').className = 'seg-btn' + (m === 'single' ? ' active' : '');
  document.getElementById('jmode-multi').className  = 'seg-btn' + (m === 'multi'  ? ' active' : '');
}

/* ── Advanced toggle ────────────────────────────────────────────────────── */
function toggleAdv() {
  document.getElementById('adv-btn').classList.toggle('open');
  document.getElementById('adv-panel').classList.toggle('show');
}

/* ── Drag-and-drop ──────────────────────────────────────────────────────── */
function onDrag(e, id) { e.preventDefault(); document.getElementById(id).classList.add('drag-over'); }
function offDrag(id)   { document.getElementById(id).classList.remove('drag-over'); }

function onDrop(e, dzId, key) {
  e.preventDefault(); offDrag(dzId);
  const f = e.dataTransfer.files[0];
  if (f) attachFile(dzId, key, f);
}
function onPick(dzId, inputId, lblId, key) {
  const f = document.getElementById(inputId).files[0];
  if (f) attachFile(dzId, key, f);
}
function attachFile(dzId, key, f) {
  F[key] = f;
  const dz  = document.getElementById(dzId);
  const lbl = document.getElementById(key === 'collection' ? 'lbl-col' : 'lbl-env');
  dz.classList.add('loaded'); dz.classList.remove('drag-over');
  lbl.textContent = '✓ ' + f.name;
  if (!dz.querySelector('.dz-clear')) {
    const x = document.createElement('button');
    x.className = 'dz-clear'; x.title = 'Remove'; x.textContent = '×';
    x.onclick = ev => { ev.stopPropagation(); clearFile(dzId, key); };
    dz.appendChild(x);
  }
}
function clearFile(dzId, key) {
  F[key] = null;
  const dz  = document.getElementById(dzId);
  const lbl = document.getElementById(key === 'collection' ? 'lbl-col' : 'lbl-env');
  dz.classList.remove('loaded'); lbl.textContent = '';
  const x = dz.querySelector('.dz-clear'); if (x) x.remove();
  document.getElementById(key === 'collection' ? 'fi-col' : 'fi-env').value = '';
}

/* ── JMX file ───────────────────────────────────────────────────────────── */
function onPickJmx() {
  const f = document.getElementById('fi-jmx').files[0];
  if (f) attachJmxFile(f);
}
function onDropJmx(e) {
  e.preventDefault(); offDrag('dz-jmx');
  const f = e.dataTransfer.files[0];
  if (f) attachJmxFile(f);
}
function attachJmxFile(f) {
  JX.file = f;
  const dz = document.getElementById('dz-jmx');
  document.getElementById('lbl-jmx').textContent = '✓ ' + f.name;
  dz.classList.add('loaded'); dz.classList.remove('drag-over');
  if (!dz.querySelector('.dz-clear')) {
    const x = document.createElement('button');
    x.className = 'dz-clear'; x.title = 'Remove'; x.textContent = '×';
    x.onclick = ev => {
      ev.stopPropagation(); JX.file = null; dz.classList.remove('loaded');
      document.getElementById('lbl-jmx').textContent = ''; x.remove();
      document.getElementById('fi-jmx').value = '';
    };
    dz.appendChild(x);
  }
}

/* ── CSV supporting files ────────────────────────────────────────────────── */
function onPickCsv() {
  const files = Array.from(document.getElementById('fi-csv').files);
  if (files.length) attachCsvFiles(files);
}
function onDropCsv(e) {
  e.preventDefault(); offDrag('dz-csv');
  const files = Array.from(e.dataTransfer.files).filter(f => f.name.endsWith('.csv'));
  if (files.length) attachCsvFiles(files);
}
function attachCsvFiles(files) {
  JX.csvFiles = files;
  const dz = document.getElementById('dz-csv');
  document.getElementById('lbl-csv').textContent =
    files.length === 1 ? '✓ ' + files[0].name : `✓ ${files.length} CSV files`;
  dz.classList.add('loaded'); dz.classList.remove('drag-over');
  let x = dz.querySelector('.dz-clear');
  if (!x) {
    x = document.createElement('button');
    x.className = 'dz-clear'; x.title = 'Remove'; x.textContent = '×';
    dz.appendChild(x);
  }
  x.onclick = ev => {
    ev.stopPropagation(); JX.csvFiles = []; dz.classList.remove('loaded');
    document.getElementById('lbl-csv').textContent = ''; x.remove();
    document.getElementById('fi-csv').value = '';
  };
}

/* ── Cert / JAR supporting files ─────────────────────────────────────────── */
function onPickCert() {
  const files = Array.from(document.getElementById('fi-cert').files);
  if (files.length) attachCertFiles(files);
}
function onDropCert(e) {
  e.preventDefault(); offDrag('dz-cert');
  const files = Array.from(e.dataTransfer.files);
  if (files.length) attachCertFiles(files);
}
function attachCertFiles(files) {
  JX.certFiles = files;
  const dz = document.getElementById('dz-cert');
  document.getElementById('lbl-cert').textContent =
    files.length === 1 ? '✓ ' + files[0].name : `✓ ${files.length} file(s)`;
  dz.classList.add('loaded'); dz.classList.remove('drag-over');
  let x = dz.querySelector('.dz-clear');
  if (!x) {
    x = document.createElement('button');
    x.className = 'dz-clear'; x.title = 'Remove'; x.textContent = '×';
    dz.appendChild(x);
  }
  x.onclick = ev => {
    ev.stopPropagation(); JX.certFiles = []; dz.classList.remove('loaded');
    document.getElementById('lbl-cert').textContent = ''; x.remove();
    document.getElementById('fi-cert').value = '';
  };
}

/* ── Progress helper ────────────────────────────────────────────────────── */
function startProgress(wrapId, fillId) {
  const pw = document.getElementById(wrapId);
  const pf = document.getElementById(fillId);
  pw.style.display = 'block'; pf.style.width = '0%';
  let pct = 0;
  return {
    tick: setInterval(() => { pct = Math.min(pct + Math.random() * 14, 88); pf.style.width = pct + '%'; }, 300),
    fill: () => { pf.style.width = '100%'; },
    hide: () => { setTimeout(() => { pw.style.display = 'none'; }, 450); }
  };
}

/* ── Bruno/Postman convert ──────────────────────────────────────────────── */
async function doConvert() {
  if (!F.collection) { alert('Please upload a collection file first.'); return; }
  const btn  = document.getElementById('btn-cvt');
  const spin = document.getElementById('spinner');
  const lbl  = document.getElementById('btn-lbl');
  btn.disabled = true; spin.style.display = 'block'; lbl.textContent = 'Converting…';
  hideResults();
  const prog = startProgress('prog-wrap', 'prog-fill');

  const fd = new FormData();
  fd.append('collection', F.collection);
  if (F.environment) fd.append('environment', F.environment);
  fd.append('protocol',            S.proto);
  fd.append('mode',                S.mode);
  fd.append('thinkTime',           S.tt);
  fd.append('logLevel',            S.ll);
  fd.append('useCorrelation',      document.getElementById('opt-corr').checked);
  fd.append('useParameterization', document.getElementById('opt-param').checked);
  fd.append('useAuthentication',   document.getElementById('opt-auth').checked);
  fd.append('addComments',         document.getElementById('opt-cmt').checked);

  try {
    const r = await fetch('/convert', { method: 'POST', body: fd });
    const ct = r.headers.get('content-type') || '';
    const d = ct.includes('application/json')
      ? await r.json()
      : (await r.text(), { error: `Server error (${r.status}): ${r.statusText}. Check server logs for details.` });
    clearInterval(prog.tick); prog.fill(); prog.hide();
    resetBtn(); showResult(r.ok ? d : null, r.ok ? null : d.error);
  } catch(e) {
    clearInterval(prog.tick); prog.hide(); resetBtn(); showResult(null, e.message);
  }
}

function resetBtn() {
  document.getElementById('btn-cvt').disabled = false;
  document.getElementById('spinner').style.display = 'none';
  document.getElementById('btn-lbl').textContent = S.proto === 'devweb'
    ? '⚡ Convert to DevWeb Script' : '⚙️  Convert to VuGen Web HTTP/HTML';
}

/* ── JMeter convert ─────────────────────────────────────────────────────── */
async function doConvertJmx() {
  if (!JX.file) { alert('Please upload a JMX file first.'); return; }
  const btn  = document.getElementById('btn-jmx');
  const spin = document.getElementById('jspinner');
  const lbl  = document.getElementById('jbtn-lbl');
  btn.disabled = true; spin.style.display = 'block'; lbl.textContent = 'Converting…';
  hideResults();
  const prog = startProgress('jprog-wrap', 'jprog-fill');

  const fd = new FormData();
  fd.append('jmxFile',             JX.file);
  fd.append('protocol',            JX.proto);
  fd.append('thinkTime',           JX.tt);
  fd.append('generateWlmExcel',    JX.wlm);
  fd.append('mode',                JX.mode);
  fd.append('useTransactions',     'true');
  fd.append('useCorrelation',      'true');
  fd.append('useParameterization', 'true');
  fd.append('useAuthentication',   'true');
  fd.append('addComments',         'true');
  // Attach CSV and cert/JAR supporting files
  for (const f of JX.csvFiles)  fd.append('csvFiles',  f);
  for (const f of JX.certFiles) fd.append('certFiles', f);

  try {
    const r = await fetch('/convert-jmx', { method: 'POST', body: fd });
    const ct = r.headers.get('content-type') || '';
    const d = ct.includes('application/json')
      ? await r.json()
      : (await r.text(), { error: `Server error (${r.status}): ${r.statusText}. Check server logs for details.` });
    clearInterval(prog.tick); prog.fill(); prog.hide();
    resetJmxBtn(); showJmxResult(r.ok ? d : null, r.ok ? null : d.error);
  } catch(e) {
    clearInterval(prog.tick); prog.hide(); resetJmxBtn(); showJmxResult(null, e.message);
  }
}

function resetJmxBtn() {
  document.getElementById('btn-jmx').disabled = false;
  document.getElementById('jspinner').style.display = 'none';
  document.getElementById('jbtn-lbl').textContent = JX.proto === 'devweb'
    ? '♨ Convert JMeter to DevWeb Script' : '♨ Convert JMeter to VuGen Web HTTP/HTML';
}

/* ── Result renderers ───────────────────────────────────────────────────── */
function showResult(data, err) {
  if (err || !data) {
    document.getElementById('err-msg').textContent = err || 'Unknown error';
    document.getElementById('res-err').style.display = 'block';
    document.getElementById('res-err').scrollIntoView({ behavior: 'smooth', block: 'start' });
    return;
  }
  const a = data.analysis || {};
  const reqs   = a.requests?.total              ?? '—';
  const corrs  = a.correlations?.totalCorrelations ?? '—';
  const params = a.parameters?.totalParameters   ?? '—';
  document.getElementById('stats-row').innerHTML =
    stat(reqs,   'Requests')  +
    stat(corrs,  'Correlations') +
    stat(params, 'Parameters');
  const pl = data.protocol === 'web-http' ? 'VuGen Web HTTP/HTML (C)' : 'DevWeb (JavaScript)';
  const ml = data.mode === 'multi' ? 'Multi-Script' : 'Single Script';
  document.getElementById('res-sub').textContent = `${pl} · ${ml} · Ready for LoadRunner Enterprise`;
  document.getElementById('btn-dl').href = data.downloadUrl;
  document.getElementById('res-ok').style.display = 'block';
  document.getElementById('res-ok').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function showJmxResult(data, err) {
  if (err || !data) {
    document.getElementById('err-msg').textContent = err || 'Unknown error';
    document.getElementById('res-err').style.display = 'block';
    document.getElementById('res-err').scrollIntoView({ behavior: 'smooth', block: 'start' });
    return;
  }
  const a      = data.analysis || {};
  const tgArr  = data.threadGroups || [];
  const tgCount= tgArr.length;
  const reqs   = a.requests?.total              ?? data.metadata?.totalRequests ?? '—';
  const corrs  = a.correlations?.totalCorrelations ?? '—';
  const params = a.parameters?.totalParameters   ?? '—';

  document.getElementById('stats-row').innerHTML =
    stat(reqs,    'Requests')     +
    stat(corrs,   'Correlations') +
    stat(params,  'Parameters')   +
    stat(tgCount, 'Thread Groups');

  const pl   = data.protocol === 'web-http' ? 'VuGen Web HTTP/HTML (C)' : 'DevWeb (JavaScript)';
  const mode = data.multiScript ? 'Multi-Script (per thread group)' : 'Single Script';
  document.getElementById('res-sub').textContent =
    `JMeter → ${pl} · ${mode} · ${reqs} requests · ${tgCount} thread group(s)`;

  // ── Per-thread-group script list (multi mode only) ──────────────────
  const tgListEl = document.getElementById('res-tg-list');
  if (data.multiScript && data.scripts && data.scripts.length) {
    const typeIcon = { Standard:'🧵', SetUp:'▶', TearDown:'⏹', Stepping:'📈', Ultimate:'🚀', Concurrency:'⚡', Arrivals:'🌊' };
    let html = '<div style="font-size:0.78rem;font-weight:600;color:var(--text-2);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em">Generated Scripts</div>';
    html += '<div style="display:flex;flex-direction:column;gap:4px">';
    for (const s of data.scripts) {
      const icon = typeIcon[s.threadGroupType] || '🧵';
      html += `<div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;background:var(--glass);border:1px solid var(--glass-border);font-size:0.82rem">
        <span>${icon}</span>
        <span style="font-weight:500;color:var(--text)">${s.threadGroupName}</span>
        <span style="color:var(--text-3);margin-left:auto">${s.requestCount} requests</span>
        <span style="color:var(--text-3);font-family:'JetBrains Mono',monospace;font-size:0.72rem">${s.safeDirName}/</span>
      </div>`;
    }
    html += '</div>';
    tgListEl.innerHTML = html;
    tgListEl.style.display = 'block';
  } else {
    tgListEl.style.display = 'none';
  }

  // ── Dependency report ───────────────────────────────────────────────
  const depEl = document.getElementById('res-dep-report');
  const dep   = data.dependency;
  if (dep) {
    let html = '<div style="font-size:0.78rem;font-weight:600;color:var(--text-2);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em">Dependency Report</div>';
    if (dep.missing.length) {
      html += '<div style="margin-bottom:6px">';
      for (const m of dep.missing) {
        html += `<div style="display:flex;align-items:flex-start;gap:8px;padding:6px 10px;border-radius:6px;background:rgba(255,80,80,0.08);border:1px solid rgba(255,80,80,0.2);font-size:0.8rem;margin-bottom:4px">
          <span>⚠</span><span style="color:var(--text)">${m.message}</span></div>`;
      }
      html += '</div>';
    }
    if (dep.found.filter(f => f.type === 'csv').length) {
      html += '<div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;background:rgba(80,200,100,0.08);border:1px solid rgba(80,200,100,0.2);font-size:0.8rem">';
      html += `<span>✓</span><span>${dep.found.filter(f=>f.type==='csv').length} CSV file(s) uploaded — included in output ZIP</span></div>`;
    }
    if (dep.warnings.length) {
      html += '<div style="margin-top:6px">';
      for (const w of dep.warnings) {
        html += `<div style="padding:5px 10px;border-radius:5px;background:var(--glass);font-size:0.78rem;color:var(--text-2);margin-bottom:3px">ℹ ${w}</div>`;
      }
      html += '</div>';
    }
    if (dep.required.length === 0 && dep.warnings.length === 0) {
      html += '<div style="font-size:0.8rem;color:var(--text-3)">No external file dependencies detected.</div>';
    }
    depEl.innerHTML = html;
    depEl.style.display = 'block';
  } else {
    depEl.style.display = 'none';
  }

  document.getElementById('btn-dl').href = data.downloadUrl;
  document.getElementById('res-ok').style.display = 'block';
  document.getElementById('res-ok').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function stat(num, label) {
  return `<div class="stat"><span class="stat-num">${num}</span><span class="stat-lbl">${label}</span></div>`;
}

function hideResults() {
  document.getElementById('res-ok').style.display = 'none';
  document.getElementById('res-err').style.display = 'none';
}
function resetResult() { hideResults(); }
</script>
</body>
</html>
