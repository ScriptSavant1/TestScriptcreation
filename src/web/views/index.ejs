<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LR Script Converter · v<%= version %></title>
<script>/* prevent FOUC */(function(){const t=localStorage.getItem('lr-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
/* ── Dark tokens (default) ──────────────────────────────────────────────── */
:root {
  --bg:           #080c14;
  --bg2:          #0d1220;
  --nav-bg:       rgba(8,12,20,0.90);
  --glass:        rgba(255,255,255,0.04);
  --glass-border: rgba(255,255,255,0.08);
  --glass-hover:  rgba(255,255,255,0.07);
  --surface:      rgba(13,18,32,0.85);
  --text:         #e8edf5;
  --text-2:       #a8b3c8;
  --text-3:       #5a6a82;
  --primary:      #4f8ef7;
  --primary-glow: rgba(79,142,247,0.30);
  --primary-dim:  rgba(79,142,247,0.12);
  --accent:       #7c5cfc;
  --vugen:        #f0883e;
  --vugen-glow:   rgba(240,136,62,0.30);
  --vugen-dim:    rgba(240,136,62,0.12);
  --success:      #34d17a;
  --success-glow: rgba(52,209,122,0.25);
  --success-dim:  rgba(52,209,122,0.10);
  --danger:       #f06464;
  --warn:         #f0c040;
  --mono:         'JetBrains Mono', monospace;
  --sans:         'Inter', system-ui, -apple-system, sans-serif;
  --r-sm:  8px;  --r-md: 14px;  --r-lg: 20px;  --r-xl: 28px;
  --shadow:    0 8px 32px rgba(0,0,0,0.40);
  --shadow-lg: 0 24px 64px rgba(0,0,0,0.60);
  --tr: 0.2s cubic-bezier(0.4,0,0.2,1);
  --knob: var(--text-3);
}
/* ── Light tokens ───────────────────────────────────────────────────────── */
[data-theme="light"] {
  --bg:           #f0f4f9;
  --bg2:          #e4ecf6;
  --nav-bg:       rgba(255,255,255,0.92);
  --glass:        rgba(255,255,255,0.65);
  --glass-border: rgba(0,0,0,0.08);
  --glass-hover:  rgba(0,0,0,0.035);
  --surface:      rgba(255,255,255,0.90);
  --text:         #0d1220;
  --text-2:       #3d4a60;
  --text-3:       #8896ac;
  --primary-glow: rgba(79,142,247,0.18);
  --primary-dim:  rgba(79,142,247,0.09);
  --vugen-glow:   rgba(240,136,62,0.18);
  --vugen-dim:    rgba(240,136,62,0.09);
  --success-glow: rgba(52,209,122,0.15);
  --success-dim:  rgba(52,209,122,0.08);
  --shadow:    0 4px 20px rgba(0,0,0,0.08);
  --shadow-lg: 0 12px 40px rgba(0,0,0,0.14);
  --knob: #94a3b8;
}

/* ── Theme transitions ──────────────────────────────────────────────────── */
body, .topnav, .card, .tab-bar, .tab-btn, .hero,
.result-box, .stat, .jmx-features, .opt-group,
.drop-zone, .dz-icon-wrap, .feat-check,
.step, .chip, .fmt-chip, footer, .toggle-row,
.adv-panel, .adv-toggle, .btn-reset, .nav-ver,
.proto-card, .seg-btn, .slider, .dz-clear {
  transition: background-color 0.30s ease, background 0.30s ease,
              border-color 0.30s ease, color 0.30s ease !important;
}
/* Restore pointer/transform transitions for interactive elements */
.btn-convert, .btn-dl, .proto-card, .step, .tab-btn,
.btn-reset, .seg-btn, .dz-clear, .theme-btn {
  transition: background-color 0.30s ease, background 0.30s ease,
              border-color 0.30s ease, color 0.30s ease,
              transform var(--tr), filter var(--tr), box-shadow var(--tr) !important;
}

/* ── Reset & base ───────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--sans);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 54px 16px 48px;   /* 54px = nav height */
  position: relative;
  overflow-x: hidden;
}

/* ── Animated background mesh ───────────────────────────────────────────── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 60% at 10%  0%, rgba(79,142,247,0.12) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 90% 10%, rgba(124,92,252,0.10) 0%, transparent 55%),
    radial-gradient(ellipse 50% 40% at 50% 90%, rgba(240,136,62,0.07) 0%, transparent 60%);
  transition: background 0.40s ease;
}
[data-theme="light"] body::before {
  background:
    radial-gradient(ellipse 80% 60% at 10%  0%, rgba(79,142,247,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 60% 50% at 90% 10%, rgba(124,92,252,0.05) 0%, transparent 55%),
    radial-gradient(ellipse 50% 40% at 50% 90%, rgba(240,136,62,0.04) 0%, transparent 60%);
}
body > * { position: relative; z-index: 1; }

/* ── Top Navigation Bar ─────────────────────────────────────────────────── */
.topnav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  height: 54px;
  background: var(--nav-bg);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-bottom: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-inner {
  width: 100%;
  max-width: 932px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.nav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}
.nav-logo {
  width: 30px; height: 30px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  display: flex; align-items: center; justify-content: center;
  font-size: 15px;
  flex-shrink: 0;
  box-shadow: 0 2px 10px var(--primary-glow);
}
.nav-title {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: -0.3px;
  color: var(--text);
}
.nav-ver {
  font-size: 10.5px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 99px;
  background: var(--primary-dim);
  color: var(--primary);
  border: 1px solid rgba(79,142,247,0.2);
  font-family: var(--mono);
}
.nav-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.nav-status {
  display: flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 600;
  color: var(--success);
  padding: 4px 10px;
  border-radius: 99px;
  background: rgba(52,209,122,0.08);
  border: 1px solid rgba(52,209,122,0.2);
}
.nav-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: currentColor;
  animation: pulse 2s ease-in-out infinite;
}
.theme-btn {
  width: 34px; height: 34px;
  border-radius: 10px;
  border: 1px solid var(--glass-border);
  background: var(--glass);
  color: var(--text-2);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.theme-btn:hover {
  background: var(--primary-dim);
  border-color: rgba(79,142,247,0.35);
  color: var(--primary);
}
.theme-btn svg { width: 15px; height: 15px; transition: transform 0.3s ease; pointer-events: none; }
.theme-btn:hover svg { transform: rotate(20deg); }
[data-theme="dark"]  .icon-moon { display: none; }
[data-theme="light"] .icon-sun  { display: none; }

/* ── Hero / Page header ─────────────────────────────────────────────────── */
.hero {
  width: 100%;
  max-width: 900px;
  text-align: center;
  padding: 40px 0 28px;
}
.hero-sub {
  font-size: 15px;
  color: var(--text-2);
  line-height: 1.6;
  max-width: 500px;
  margin: 0 auto 16px;
}
.hero-badges {
  display: flex; align-items: center; justify-content: center;
  gap: 8px; flex-wrap: wrap;
}
.chip {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 12px;
  border-radius: 99px;
  font-size: 11.5px; font-weight: 600;
  border: 1px solid var(--glass-border);
  background: var(--glass);
  color: var(--text-2);
  backdrop-filter: blur(8px);
}
.chip-live { background: rgba(52,209,122,0.08); border-color: rgba(52,209,122,0.20); color: var(--success); }
.chip-dot  { width: 6px; height: 6px; border-radius: 50%; background: currentColor; animation: pulse 2s ease-in-out infinite; }
@keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }

/* ── Tabs ───────────────────────────────────────────────────────────────── */
.tab-bar {
  display: flex;
  width: 100%;
  max-width: 900px;
  background: var(--glass);
  border: 1px solid var(--glass-border);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 6px;
  gap: 4px;
  backdrop-filter: blur(16px);
  margin-bottom: -1px;
  position: relative;
  z-index: 2;
}
.tab-btn {
  flex: 1;
  padding: 10px 20px;
  border: none;
  border-radius: var(--r-md);
  background: transparent;
  color: var(--text-3);
  font-family: var(--sans);
  font-size: 13.5px; font-weight: 600;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.tab-btn:hover { color: var(--text-2); background: var(--glass-hover); }
.tab-btn.active-bruno {
  background: linear-gradient(135deg, rgba(79,142,247,0.20), rgba(124,92,252,0.15));
  color: var(--text);
  border: 1px solid rgba(79,142,247,0.30);
  box-shadow: 0 2px 12px rgba(79,142,247,0.15);
}
.tab-btn.active-jmx {
  background: linear-gradient(135deg, rgba(240,136,62,0.20), rgba(240,100,62,0.10));
  color: var(--text);
  border: 1px solid rgba(240,136,62,0.30);
  box-shadow: 0 2px 12px rgba(240,136,62,0.15);
}
.tab-icon { font-size: 16px; }

/* ── Card ───────────────────────────────────────────────────────────────── */
.card {
  width: 100%;
  max-width: 900px;
  background: var(--surface);
  border: 1px solid var(--glass-border);
  border-radius: 0 0 var(--r-xl) var(--r-xl);
  padding: 32px;
  backdrop-filter: blur(20px);
  margin-bottom: 16px;
}
.card.standalone { border-radius: var(--r-xl); margin-top: 16px; }

.section-label {
  display: flex; align-items: center; gap: 10px;
  font-size: 11px; font-weight: 700;
  color: var(--text-3);
  text-transform: uppercase; letter-spacing: 1.2px;
  margin-bottom: 16px;
}
.section-label::before {
  content: '';
  width: 3px; height: 16px;
  border-radius: 2px;
  background: linear-gradient(to bottom, var(--primary), var(--accent));
  flex-shrink: 0;
}
.section-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 20px; height: 20px;
  border-radius: 6px;
  background: var(--primary-dim); color: var(--primary);
  font-size: 10px; font-weight: 800;
}

/* ── Protocol selector ──────────────────────────────────────────────────── */
.proto-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  margin-bottom: 28px;
}
@media (max-width: 560px) { .proto-grid { grid-template-columns: 1fr; } }

.proto-card {
  border: 1.5px solid var(--glass-border);
  border-radius: var(--r-lg);
  padding: 18px 20px;
  cursor: pointer;
  display: flex; gap: 14px; align-items: flex-start;
  user-select: none;
  background: var(--glass);
  position: relative; overflow: hidden;
}
.proto-card:hover { border-color: rgba(79,142,247,0.30); transform: translateY(-1px); }
[data-theme="light"] .proto-card:hover { border-color: rgba(79,142,247,0.40); }
.proto-card.active-devweb {
  border-color: var(--primary);
  background: var(--primary-dim);
  box-shadow: 0 0 0 1px rgba(79,142,247,0.20), 0 8px 24px rgba(79,142,247,0.12);
}
.proto-card.active-vugen {
  border-color: var(--vugen);
  background: var(--vugen-dim);
  box-shadow: 0 0 0 1px rgba(240,136,62,0.20), 0 8px 24px rgba(240,136,62,0.12);
}
.proto-icon {
  width: 42px; height: 42px;
  border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; flex-shrink: 0;
}
.proto-icon-blue   { background: linear-gradient(135deg, #1a4f9e, #2d6cd4); }
.proto-icon-orange { background: linear-gradient(135deg, #7a3b0a, #c4671a); }
.proto-name { font-size: 14.5px; font-weight: 700; margin-bottom: 4px; }
.proto-desc { font-size: 12px; color: var(--text-2); line-height: 1.55; }
.proto-tag {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10px; font-weight: 700;
  padding: 3px 8px; border-radius: 6px;
  margin-top: 8px; font-family: var(--mono);
}
.tag-js { background: rgba(79,142,247,0.15); color: #7eb3ff; border: 1px solid rgba(79,142,247,0.30); }
.tag-c  { background: rgba(240,136,62,0.15);  color: #ffa96a; border: 1px solid rgba(240,136,62,0.30); }

/* ── Upload zones ───────────────────────────────────────────────────────── */
.upload-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  margin-bottom: 28px;
}
@media (max-width: 560px) { .upload-grid { grid-template-columns: 1fr; } }

.drop-zone {
  border: 1.5px dashed var(--glass-border);
  border-radius: var(--r-lg);
  padding: 28px 20px;
  text-align: center;
  cursor: pointer;
  position: relative;
  background: var(--glass);
  overflow: hidden;
}
/* Compact secondary drop zones (CSV / cert files) */
.dz-secondary {
  padding: 14px 14px;
}
.dz-secondary .dz-icon-wrap {
  width: 34px; height: 34px; border-radius: 9px; font-size: 16px; margin-bottom: 8px;
}
.drop-zone:hover        { border-color: rgba(79,142,247,0.40); background: var(--primary-dim); }
.drop-zone.drag-over    { border-color: var(--primary); border-style: solid; background: rgba(79,142,247,0.08); }
.drop-zone.loaded       { border-color: var(--success); border-style: solid; background: var(--success-dim); }
.drop-zone input[type=file] {
  position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
}
.dz-icon-wrap {
  width: 44px; height: 44px; border-radius: 12px;
  background: var(--glass); border: 1px solid var(--glass-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; margin: 0 auto 12px;
}
.drop-zone:hover .dz-icon-wrap { border-color: rgba(79,142,247,0.40); background: rgba(79,142,247,0.10); }
.drop-zone.loaded .dz-icon-wrap { border-color: rgba(52,209,122,0.40); background: var(--success-dim); }
.dz-label    { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
.dz-sub      { font-size: 11px; color: var(--text-3); line-height: 1.5; }
.dz-opt      { font-size: 10.5px; color: var(--warn); margin-top: 6px; display: block; }
.dz-name     { font-size: 11.5px; color: var(--success); font-weight: 600; word-break: break-all; margin-top: 8px; }
.dz-required { color: var(--danger); }
.dz-clear {
  position: absolute; top: 10px; right: 12px;
  background: var(--glass); border: 1px solid var(--glass-border);
  color: var(--text-3); cursor: pointer;
  font-size: 14px; line-height: 1;
  width: 24px; height: 24px; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  z-index: 10;
}
.dz-clear:hover { color: var(--danger); border-color: rgba(240,100,100,0.40); background: rgba(240,100,100,0.10); }

/* ── Options ────────────────────────────────────────────────────────────── */
.options-grid {
  display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px;
}
.opt-group {
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: var(--r-md); padding: 14px 16px;
  flex: 1; min-width: 140px;
}
.opt-label {
  font-size: 10.5px; color: var(--text-3); display: block;
  margin-bottom: 10px; text-transform: uppercase; letter-spacing: 0.7px; font-weight: 700;
}
.seg-btns { display: flex; gap: 4px; }
.seg-btn {
  flex: 1; padding: 7px 10px;
  border: 1px solid var(--glass-border);
  background: transparent; color: var(--text-3);
  border-radius: var(--r-sm); font-size: 12px;
  font-family: var(--sans); cursor: pointer;
  white-space: nowrap; font-weight: 500;
}
.seg-btn:hover { border-color: rgba(79,142,247,0.40); color: var(--primary); }
.seg-btn.active {
  background: var(--primary-dim); border-color: var(--primary);
  color: var(--primary); font-weight: 700;
}

/* ── Advanced panel ─────────────────────────────────────────────────────── */
.adv-toggle {
  background: none; border: 1px solid transparent;
  color: var(--text-3); cursor: pointer;
  font-size: 12.5px; font-family: var(--sans);
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 12px; margin-bottom: 12px;
  border-radius: var(--r-sm); font-weight: 500;
}
.adv-toggle:hover { color: var(--text-2); background: var(--glass); border-color: var(--glass-border); }
.arrow { transition: transform var(--tr); font-size: 10px; display: inline-block; }
.adv-toggle.open .arrow { transform: rotate(90deg); }
.adv-panel {
  display: none; background: var(--glass);
  border: 1px solid var(--glass-border);
  border-radius: var(--r-md); padding: 4px 0;
  margin-bottom: 18px; overflow: hidden;
}
.adv-panel.show { display: block; }
.toggle-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 13px 18px;
  border-bottom: 1px solid var(--glass-border);
}
.toggle-row:last-child { border-bottom: none; }
.toggle-row:hover { background: var(--glass-hover); }
.tgl-label { font-size: 13px; font-weight: 500; }
.tgl-sub   { font-size: 11px; color: var(--text-3); margin-top: 3px; line-height: 1.4; }

/* Toggle switch */
.switch { position: relative; width: 42px; height: 24px; flex-shrink: 0; }
.switch input { opacity: 0; width: 0; height: 0; }
.slider {
  position: absolute; inset: 0;
  background: rgba(255,255,255,0.10); border: 1px solid var(--glass-border);
  border-radius: 24px; cursor: pointer;
}
[data-theme="light"] .slider { background: rgba(0,0,0,0.10); }
.slider::before {
  content: ''; position: absolute;
  width: 16px; height: 16px; left: 3px; top: 3px;
  background: var(--knob); border-radius: 50%;
  transition: var(--tr);
}
.switch input:checked + .slider { background: var(--primary); border-color: var(--primary); box-shadow: 0 0 8px var(--primary-glow); }
.switch input:checked + .slider::before { transform: translateX(18px); background: #fff; }

/* ── Convert button ─────────────────────────────────────────────────────── */
.divider { height: 1px; background: var(--glass-border); margin: 20px 0; }

.btn-convert {
  width: 100%; padding: 15px;
  font-size: 14.5px; font-weight: 700; font-family: var(--sans);
  border: none; border-radius: var(--r-md); cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  letter-spacing: 0.2px; position: relative; overflow: hidden;
}
.btn-convert::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
  transform: translateX(-100%); transition: transform 0.5s ease;
}
.btn-convert:hover::before { transform: translateX(100%); }
.btn-convert.devweb {
  background: linear-gradient(135deg, #1a4fb5, #3d7ef0, #5a9fff);
  color: #fff; box-shadow: 0 4px 20px rgba(60,120,240,0.40), 0 1px 0 rgba(255,255,255,0.10) inset;
}
.btn-convert.vugen {
  background: linear-gradient(135deg, #8a3500, #d4620e, #f0883e);
  color: #fff; box-shadow: 0 4px 20px rgba(200,90,20,0.40), 0 1px 0 rgba(255,255,255,0.10) inset;
}
.btn-convert:hover:not(:disabled) { transform: translateY(-2px); filter: brightness(1.08); }
.btn-convert:active:not(:disabled) { transform: translateY(0); filter: brightness(0.96); }
.btn-convert:disabled { opacity: 0.45; cursor: not-allowed; transform: none !important; filter: none !important; }

/* Spinner */
.spinner {
  width: 18px; height: 18px;
  border: 2px solid rgba(255,255,255,0.25);
  border-top-color: #fff; border-radius: 50%;
  animation: spin 0.65s linear infinite;
  display: none; flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* Progress bar */
.prog-wrap {
  height: 3px; background: var(--glass-border); border-radius: 3px;
  overflow: hidden; margin: 16px 0; display: none;
}
.prog-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--accent), var(--success));
  background-size: 200%; width: 0%;
  transition: width 0.4s ease;
  animation: shimmer 2s linear infinite;
}
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* ── Result box ─────────────────────────────────────────────────────────── */
.result-box {
  width: 100%; max-width: 900px;
  border-radius: var(--r-xl); padding: 28px;
  backdrop-filter: blur(20px); margin-top: 16px;
}
.result-ok  {
  background: linear-gradient(135deg, rgba(52,209,122,0.08), rgba(52,209,122,0.04));
  border: 1px solid rgba(52,209,122,0.25);
  box-shadow: 0 0 40px rgba(52,209,122,0.08); display: none;
}
.result-err {
  background: linear-gradient(135deg, rgba(240,100,100,0.08), rgba(240,100,100,0.04));
  border: 1px solid rgba(240,100,100,0.25); display: none;
}
.res-head   { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px; }
.res-icon   { width: 48px; height: 48px; border-radius: var(--r-md); display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
.res-icon-ok  { background: var(--success-dim); border: 1px solid rgba(52,209,122,0.30); }
.res-icon-err { background: rgba(240,100,100,0.10); border: 1px solid rgba(240,100,100,0.30); }
.res-title  { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
.res-sub    { font-size: 12.5px; color: var(--text-2); line-height: 1.5; }
.stats-grid { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
.stat {
  flex: 1; min-width: 80px;
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: var(--r-md); padding: 14px 16px; text-align: center;
}
.stat-num {
  display: block; font-size: 28px; font-weight: 800; font-family: var(--mono);
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; line-height: 1.1; margin-bottom: 4px;
}
.stat-lbl { font-size: 10px; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; }
.res-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.btn-dl {
  display: inline-flex; align-items: center; gap: 8px;
  background: linear-gradient(135deg, #0d7a3e, #1aad58, #34d17a);
  color: #fff; border: none; border-radius: var(--r-md);
  padding: 13px 24px; font-size: 14px; font-family: var(--sans);
  font-weight: 700; cursor: pointer; text-decoration: none;
  box-shadow: 0 4px 16px rgba(52,209,122,0.30);
}
.btn-dl:hover { transform: translateY(-2px); filter: brightness(1.10); }
.btn-reset {
  background: var(--glass); border: 1px solid var(--glass-border);
  color: var(--text-2); border-radius: var(--r-md);
  padding: 12px 20px; font-size: 13px; font-family: var(--sans);
  cursor: pointer; font-weight: 500;
}
.btn-reset:hover { border-color: rgba(79,142,247,0.40); color: var(--primary); }

/* ── JMX feature list ───────────────────────────────────────────────────── */
.jmx-features {
  display: flex; flex-direction: column; gap: 8px;
  padding: 18px; background: var(--glass);
  border: 1px solid var(--glass-border);
  border-radius: var(--r-lg); height: 100%;
}
.jmx-feat-title {
  font-size: 10.5px; font-weight: 700; color: var(--text-3);
  text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 6px;
}
.feat-item {
  display: flex; align-items: center; gap: 10px;
  font-size: 12.5px; color: var(--text-2);
  padding: 6px 0; border-bottom: 1px solid var(--glass-border);
}
.feat-item:last-child { border-bottom: none; }
.feat-check {
  width: 18px; height: 18px; border-radius: 5px;
  background: var(--success-dim); border: 1px solid rgba(52,209,122,0.30);
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; color: var(--success); flex-shrink: 0;
}

/* ── How it works ───────────────────────────────────────────────────────── */
.steps-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr)); gap: 10px;
}
.step {
  padding: 20px 16px; text-align: center;
  border: 1px solid var(--glass-border);
  border-radius: var(--r-lg); background: var(--glass);
  position: relative; overflow: hidden;
}
.step::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg, var(--primary-dim), transparent);
  opacity: 0; transition: opacity var(--tr);
}
.step:hover { border-color: rgba(79,142,247,0.30); transform: translateY(-2px); }
.step:hover::before { opacity: 1; }
.step-icon {
  width: 44px; height: 44px; border-radius: 12px;
  background: linear-gradient(135deg, var(--primary-dim), rgba(124,92,252,0.10));
  border: 1px solid rgba(79,142,247,0.20);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; margin: 0 auto 12px;
}
.step-ttl { font-size: 13px; font-weight: 700; margin-bottom: 6px; }
.step-txt { font-size: 11.5px; color: var(--text-3); line-height: 1.55; }

/* ── Formats bar ────────────────────────────────────────────────────────── */
.formats-bar {
  display: flex; gap: 8px; flex-wrap: wrap;
  justify-content: center; margin: 20px 0 0;
}
.fmt-chip {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: 99px;
  border: 1px solid var(--glass-border); background: var(--glass);
  font-size: 11.5px; font-weight: 600; color: var(--text-2);
  backdrop-filter: blur(8px);
}

/* ── Footer ─────────────────────────────────────────────────────────────── */
footer {
  color: var(--text-3); font-size: 11.5px;
  text-align: center; margin-top: 24px; padding-bottom: 8px;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
}
.footer-links { display: flex; gap: 16px; flex-wrap: wrap; justify-content: center; }
.footer-sep   { color: var(--text-3); }
</style>
</head>

<body>

<!-- ── Fixed Navigation ─────────────────────────────────────────────────── -->
<nav class="topnav">
  <div class="nav-inner">
    <div class="nav-brand">
      <div class="nav-logo">⚡</div>
      <span class="nav-title">LR Script Converter</span>
      <span class="nav-ver">v<%= version %></span>
    </div>
    <div class="nav-actions">
      <span class="nav-status"><span class="nav-dot"></span>Live</span>
      <button class="theme-btn" onclick="toggleTheme()" title="Toggle light / dark mode" aria-label="Toggle theme">
        <!-- sun — shown in dark mode -->
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <!-- moon — shown in light mode -->
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
    </div>
  </div>
</nav>

<!-- ── Hero ────────────────────────────────────────────────────────────────-->
<header class="hero">
  <p class="hero-sub">Convert Postman, Bruno &amp; JMeter test scripts into production-ready LoadRunner Enterprise scripts — in seconds.</p>
  <div class="hero-badges">
    <span class="chip">🟦 DevWeb JS</span>
    <span class="chip">🟧 VuGen C</span>
    <span class="chip">🔒 Files never stored</span>
  </div>
</header>

<!-- ── Tab bar ─────────────────────────────────────────────────────────── -->
<div class="tab-bar">
  <button class="tab-btn active-bruno" id="tab-bruno" onclick="switchTab('bruno')">
    <span class="tab-icon">📂</span> Postman / Bruno
  </button>
  <button class="tab-btn" id="tab-jmx" onclick="switchTab('jmx')">
    <span class="tab-icon">♨</span> JMeter (.jmx)
  </button>
</div>

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- Panel: Postman / Bruno                                                 -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div class="card" id="panel-bruno">

  <!-- 1 · Protocol -->
  <div class="section-label"><span class="section-num">1</span>Choose Output Protocol</div>
  <div class="proto-grid">
    <div class="proto-card active-devweb" id="pc-devweb" onclick="setProto('devweb')">
      <div class="proto-icon proto-icon-blue">🟦</div>
      <div>
        <div class="proto-name">DevWeb · JavaScript</div>
        <div class="proto-desc">Modern JS protocol for LRE. Generates <strong>main.js</strong> with per-request transactions, correlations, JWT helper &amp; full config files.</div>
        <span class="proto-tag tag-js">⚡ main.js</span>
      </div>
    </div>
    <div class="proto-card" id="pc-vugen" onclick="setProto('web-http')">
      <div class="proto-icon proto-icon-orange">🟧</div>
      <div>
        <div class="proto-name">VuGen · Web HTTP/HTML (C)</div>
        <div class="proto-desc">Classic C-based VuGen protocol. Generates <strong>Action.c</strong> with web_custom_request, NTLM/Kerberos, jsrsasign &amp; all VuGen config.</div>
        <span class="proto-tag tag-c">⚙ Action.c</span>
      </div>
    </div>
  </div>

  <!-- 2 · Upload -->
  <div class="section-label"><span class="section-num">2</span>Upload Files</div>
  <div class="upload-grid">
    <div class="drop-zone" id="dz-col"
         ondragover="onDrag(event,'dz-col')" ondragleave="offDrag('dz-col')"
         ondrop="onDrop(event,'dz-col','collection')">
      <input type="file" id="fi-col" accept=".json,.yml,.yaml,.bru"
             onchange="onPick('dz-col','fi-col','lbl-col','collection')">
      <div class="dz-icon-wrap">📂</div>
      <div class="dz-label">Collection File <span class="dz-required">*</span></div>
      <div class="dz-sub">Postman v2.1 JSON &nbsp;·&nbsp; Bruno JSON / YAML &nbsp;·&nbsp; .bru</div>
      <div id="lbl-col" class="dz-name"></div>
    </div>
    <div class="drop-zone" id="dz-env"
         ondragover="onDrag(event,'dz-env')" ondragleave="offDrag('dz-env')"
         ondrop="onDrop(event,'dz-env','environment')">
      <input type="file" id="fi-env" accept=".json,.bru"
             onchange="onPick('dz-env','fi-env','lbl-env','environment')">
      <div class="dz-icon-wrap">🔑</div>
      <div class="dz-label">Environment File</div>
      <div class="dz-sub">Postman environment JSON &nbsp;·&nbsp; Bruno .bru vars</div>
      <span class="dz-opt">Optional — provides variable values</span>
      <div id="lbl-env" class="dz-name"></div>
    </div>
  </div>

  <!-- 3 · Options -->
  <div class="section-label"><span class="section-num">3</span>Configure Options</div>
  <div class="options-grid">
    <div class="opt-group">
      <span class="opt-label">Script Mode</span>
      <div class="seg-btns">
        <button class="seg-btn active" id="m-single" onclick="setMode('single')">Single</button>
        <button class="seg-btn"        id="m-multi"  onclick="setMode('multi')">Multi-Script</button>
      </div>
    </div>
    <div class="opt-group">
      <span class="opt-label">Think Time</span>
      <div class="seg-btns">
        <button class="seg-btn active" id="tt-1" onclick="setTT(1)">1s</button>
        <button class="seg-btn"        id="tt-2" onclick="setTT(2)">2s</button>
        <button class="seg-btn"        id="tt-3" onclick="setTT(3)">3s</button>
        <button class="seg-btn"        id="tt-5" onclick="setTT(5)">5s</button>
      </div>
    </div>
    <div class="opt-group">
      <span class="opt-label">Log Level</span>
      <div class="seg-btns">
        <button class="seg-btn active" id="ll-info"  onclick="setLL('info')">Info</button>
        <button class="seg-btn"        id="ll-debug" onclick="setLL('debug')">Debug</button>
      </div>
    </div>
  </div>

  <!-- Advanced -->
  <button class="adv-toggle" id="adv-btn" onclick="toggleAdv()">
    <span class="arrow">▶</span> Advanced settings
  </button>
  <div class="adv-panel" id="adv-panel">
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Correlation Detection</div>
        <div class="tgl-sub">Extract dynamic values from API responses — access_token, userId, sessionId, CSRF tokens</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-corr" checked><span class="slider"></span></label>
    </div>
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Parameterization</div>
        <div class="tgl-sub">Convert static variables into CSV parameters — baseUrl, clientId, API keys</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-param" checked><span class="slider"></span></label>
    </div>
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Authentication Handling</div>
        <div class="tgl-sub">OAuth2, Bearer (dynamic-aware), Basic, API Key, JWT (PS256 / RS256 / HS256), AWS Sig v4</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-auth" checked><span class="slider"></span></label>
    </div>
    <div class="toggle-row">
      <div>
        <div class="tgl-label">Add Code Comments</div>
        <div class="tgl-sub">Inline explanatory comments in the generated script to guide manual review</div>
      </div>
      <label class="switch"><input type="checkbox" id="opt-cmt" checked><span class="slider"></span></label>
    </div>
  </div>

  <div class="divider"></div>
  <div class="prog-wrap" id="prog-wrap"><div class="prog-fill" id="prog-fill"></div></div>
  <button class="btn-convert devweb" id="btn-cvt" onclick="doConvert()">
    <div class="spinner" id="spinner"></div>
    <span id="btn-lbl">⚡ Convert to DevWeb Script</span>
  </button>
</div>

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- Panel: JMeter                                                          -->
<!-- ══════════════════════════════════════════════════════════════════════ -->
<div class="card" id="panel-jmx" style="display:none">

  <!-- 1 · Protocol -->
  <div class="section-label"><span class="section-num">1</span>Choose Output Protocol</div>
  <div class="proto-grid">
    <div class="proto-card active-devweb" id="jpc-devweb" onclick="setJmxProto('devweb')">
      <div class="proto-icon proto-icon-blue">🟦</div>
      <div>
        <div class="proto-name">DevWeb · JavaScript</div>
        <div class="proto-desc">Generates <strong>main.js</strong> with transactions, correlations, auth &amp; Workload Model Excel.</div>
        <span class="proto-tag tag-js">⚡ main.js</span>
      </div>
    </div>
    <div class="proto-card" id="jpc-vugen" onclick="setJmxProto('web-http')">
      <div class="proto-icon proto-icon-orange">🟧</div>
      <div>
        <div class="proto-name">VuGen · Web HTTP/HTML (C)</div>
        <div class="proto-desc">Generates <strong>Action.c</strong> with web_reg_save_param, NTLM/Kerberos auth &amp; Workload Model Excel.</div>
        <span class="proto-tag tag-c">⚙ Action.c</span>
      </div>
    </div>
  </div>

  <!-- 2 · Upload -->
  <div class="section-label"><span class="section-num">2</span>Upload JMeter Script</div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px">
    <div class="drop-zone" id="dz-jmx"
         ondragover="onDrag(event,'dz-jmx')" ondragleave="offDrag('dz-jmx')"
         ondrop="onDropJmx(event)">
      <input type="file" id="fi-jmx" accept=".jmx" onchange="onPickJmx()">
      <div class="dz-icon-wrap">♨</div>
      <div class="dz-label">JMeter Script <span class="dz-required">*</span></div>
      <div class="dz-sub">.jmx file — JMeter Test Plan</div>
      <div id="lbl-jmx" class="dz-name"></div>
    </div>
    <div class="jmx-features">
      <div class="jmx-feat-title">What gets generated</div>
      <div class="feat-item"><span class="feat-check">✓</span>DevWeb JS or VuGen C script per thread group</div>
      <div class="feat-item"><span class="feat-check">✓</span>Regex / JSON / Boundary / XPath / CSS extractors</div>
      <div class="feat-item"><span class="feat-check">✓</span>Global + per-request headers correctly scoped</div>
      <div class="feat-item"><span class="feat-check">✓</span>Loop / If / ForEach controller context preserved</div>
      <div class="feat-item"><span class="feat-check">✓</span>CSV parameter files + dependency report</div>
      <div class="feat-item"><span class="feat-check">✓</span><strong>Workload Model Excel (.xlsx)</strong></div>
    </div>
  </div>

  <!-- Supporting files -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:28px">
    <div class="drop-zone dz-secondary" id="dz-csv"
         ondragover="onDrag(event,'dz-csv')" ondragleave="offDrag('dz-csv')"
         ondrop="onDropCsv(event)">
      <input type="file" id="fi-csv" accept=".csv" multiple onchange="onPickCsv()">
      <div class="dz-icon-wrap" style="font-size:1.1rem">📄</div>
      <div class="dz-label" style="font-size:0.82rem">CSV Data Files <span style="color:var(--text-3);font-weight:400">(optional)</span></div>
      <div class="dz-sub">Multiple .csv files — added to output ZIP</div>
      <div id="lbl-csv" class="dz-name"></div>
    </div>
    <div class="drop-zone dz-secondary" id="dz-cert"
         ondragover="onDrag(event,'dz-cert')" ondragleave="offDrag('dz-cert')"
         ondrop="onDropCert(event)">
      <input type="file" id="fi-cert" accept=".jks,.p12,.cer,.crt,.key,.pem,.pfx" multiple onchange="onPickCert()">
      <div class="dz-icon-wrap" style="font-size:1.1rem">🔒</div>
      <div class="dz-label" style="font-size:0.82rem">Certificate Files <span style="color:var(--text-3);font-weight:400">(optional)</span></div>
      <div class="dz-sub">.jks .p12 .cer .crt .key .pem .pfx</div>
      <div id="lbl-cert" class="dz-name"></div>
    </div>
  </div>

  <!-- 3 · Options -->
  <div class="section-label"><span class="section-num">3</span>Configure Options</div>
  <div class="options-grid">
    <div class="opt-group">
      <span class="opt-label">Script Generation Mode</span>
      <div class="seg-btns">
        <button class="seg-btn active" id="jmode-single" onclick="setJmxMode('single')">Single Script</button>
        <button class="seg-btn"        id="jmode-multi"  onclick="setJmxMode('multi')">Per Thread Group</button>
      </div>
    </div>
    <div class="opt-group">
      <span class="opt-label">Think Time</span>
      <div class="seg-btns">
        <button class="seg-btn active" id="jtt-1" onclick="setJmxTT(1)">1s</button>
        <button class="seg-btn"        id="jtt-2" onclick="setJmxTT(2)">2s</button>
        <button class="seg-btn"        id="jtt-3" onclick="setJmxTT(3)">3s</button>
        <button class="seg-btn"        id="jtt-5" onclick="setJmxTT(5)">5s</button>
      </div>
    </div>
    <div class="opt-group">
      <span class="opt-label">Workload Model Excel</span>
      <div class="seg-btns">
        <button class="seg-btn active" id="jwlm-yes" onclick="setJmxWlm(true)">Include</button>
        <button class="seg-btn"        id="jwlm-no"  onclick="setJmxWlm(false)">Skip</button>
      </div>
    </div>
  </div>

  <div class="divider"></div>
  <div class="prog-wrap" id="jprog-wrap"><div class="prog-fill" id="jprog-fill"></div></div>
  <button class="btn-convert devweb" id="btn-jmx" onclick="doConvertJmx()">
    <div class="spinner" id="jspinner"></div>
    <span id="jbtn-lbl">♨ Convert JMeter to DevWeb Script</span>
  </button>
</div>

<!-- ── Results ─────────────────────────────────────────────────────────── -->
<div class="result-box result-ok" id="res-ok">
  <div class="res-head">
    <div class="res-icon res-icon-ok">✅</div>
    <div>
      <div class="res-title">Script Generated Successfully</div>
      <div class="res-sub" id="res-sub"></div>
    </div>
  </div>
  <div class="stats-grid" id="stats-row"></div>
  <!-- Multi-script thread group list (hidden in single mode) -->
  <div id="res-tg-list" style="display:none;margin:12px 0 4px"></div>
  <!-- Dependency report (shown when CSV files are referenced) -->
  <div id="res-dep-report" style="display:none;margin:12px 0 4px"></div>
  <div class="res-actions">
    <a id="btn-dl" class="btn-dl" href="#" download>⬇ Download Script (.zip)</a>
    <button class="btn-reset" onclick="resetResult()">↩ Convert Another</button>
  </div>
</div>

<div class="result-box result-err" id="res-err">
  <div class="res-head">
    <div class="res-icon res-icon-err">❌</div>
    <div>
      <div class="res-title">Conversion Failed</div>
      <div class="res-sub" id="err-msg"></div>
    </div>
  </div>
  <button class="btn-reset" onclick="resetResult()">↩ Try Again</button>
</div>

<!-- ── How it works ────────────────────────────────────────────────────── -->
<div class="card standalone">
  <div class="section-label">How It Works</div>
  <div class="steps-grid">
    <div class="step">
      <div class="step-icon">📤</div>
      <div class="step-ttl">Upload</div>
      <div class="step-txt">Drop your Postman, Bruno or JMeter file. Add an environment file for variable values.</div>
    </div>
    <div class="step">
      <div class="step-icon">🔬</div>
      <div class="step-ttl">Analyze</div>
      <div class="step-txt">Detects correlations, JWT, auth, proxy, headers and classifies all variables into 3 tiers.</div>
    </div>
    <div class="step">
      <div class="step-icon">⚙️</div>
      <div class="step-ttl">Generate</div>
      <div class="step-txt">Creates a complete LR script with all config files — per-request transactions included.</div>
    </div>
    <div class="step">
      <div class="step-icon">⬇️</div>
      <div class="step-ttl">Download</div>
      <div class="step-txt">Get a .zip. Open the .usr in VuGen or upload directly to LoadRunner Enterprise.</div>
    </div>
  </div>
  <div class="formats-bar">
    <span class="fmt-chip">📂 Postman v2.1 JSON</span>
    <span class="fmt-chip">📂 Bruno JSON / YAML / .bru</span>
    <span class="fmt-chip">♨ JMeter .jmx</span>
    <span class="fmt-chip">🟦 DevWeb JS output</span>
    <span class="fmt-chip">🟧 VuGen C output</span>
  </div>
</div>

<!-- ── Footer ──────────────────────────────────────────────────────────── -->
<footer>
  <div class="footer-links">
    <span>Performance Engineering Toolkit</span>
    <span class="footer-sep">·</span>
    <span>v<%= version %></span>
    <span class="footer-sep">·</span>
    <span>Files processed in-memory — nothing stored on server</span>
  </div>
</footer>

<!-- ══════════════════════════════════════════════════════════════════════ -->
<script>
/* ── Theme toggle ────────────────────────────────────────────────────────── */
function toggleTheme() {
  const html = document.documentElement;
  const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
  html.setAttribute('data-theme', next);
  localStorage.setItem('lr-theme', next);
}

/* ── State ──────────────────────────────────────────────────────────────── */
const S  = { proto:'devweb', mode:'single', tt:1, ll:'info' };
const F  = { collection:null, environment:null };
const JX = { proto:'devweb', mode:'single', tt:1, wlm:true, file:null, csvFiles:[], certFiles:[] };

/* ── Tab switching ──────────────────────────────────────────────────────── */
function switchTab(tab) {
  document.getElementById('panel-bruno').style.display = tab === 'bruno' ? '' : 'none';
  document.getElementById('panel-jmx').style.display   = tab === 'jmx'   ? '' : 'none';
  document.getElementById('tab-bruno').className = 'tab-btn' + (tab === 'bruno' ? ' active-bruno' : '');
  document.getElementById('tab-jmx').className   = 'tab-btn' + (tab === 'jmx'   ? ' active-jmx'   : '');
  hideResults();
}

/* ── Protocol selectors ─────────────────────────────────────────────────── */
function setProto(p) {
  S.proto = p;
  document.getElementById('pc-devweb').className = 'proto-card' + (p === 'devweb'   ? ' active-devweb' : '');
  document.getElementById('pc-vugen').className  = 'proto-card' + (p === 'web-http' ? ' active-vugen'  : '');
  const btn = document.getElementById('btn-cvt');
  btn.className = 'btn-convert ' + (p === 'devweb' ? 'devweb' : 'vugen');
  document.getElementById('btn-lbl').textContent = p === 'devweb'
    ? '⚡ Convert to DevWeb Script' : '⚙️  Convert to VuGen Web HTTP/HTML';
}

function setJmxProto(p) {
  JX.proto = p;
  document.getElementById('jpc-devweb').className = 'proto-card' + (p === 'devweb'   ? ' active-devweb' : '');
  document.getElementById('jpc-vugen').className  = 'proto-card' + (p === 'web-http' ? ' active-vugen'  : '');
  const btn = document.getElementById('btn-jmx');
  btn.className = 'btn-convert ' + (p === 'devweb' ? 'devweb' : 'vugen');
  document.getElementById('jbtn-lbl').textContent = p === 'devweb'
    ? '♨ Convert JMeter to DevWeb Script' : '♨ Convert JMeter to VuGen Web HTTP/HTML';
}

/* ── Option pickers ─────────────────────────────────────────────────────── */
function setMode(m) {
  S.mode = m;
  ['single','multi'].forEach(x =>
    document.getElementById('m-'+x).className = 'seg-btn' + (m === x ? ' active' : ''));
}
function setTT(t) {
  S.tt = t;
  [1,2,3,5].forEach(n =>
    document.getElementById('tt-'+n).className = 'seg-btn' + (n === t ? ' active' : ''));
}
function setLL(l) {
  S.ll = l;
  ['info','debug'].forEach(x =>
    document.getElementById('ll-'+x).className = 'seg-btn' + (l === x ? ' active' : ''));
}
function setJmxTT(t) {
  JX.tt = t;
  [1,2,3,5].forEach(n =>
    document.getElementById('jtt-'+n).className = 'seg-btn' + (n === t ? ' active' : ''));
}
function setJmxWlm(v) {
  JX.wlm = v;
  document.getElementById('jwlm-yes').className = 'seg-btn' + ( v ? ' active' : '');
  document.getElementById('jwlm-no').className  = 'seg-btn' + (!v ? ' active' : '');
}
function setJmxMode(m) {
  JX.mode = m;
  document.getElementById('jmode-single').className = 'seg-btn' + (m === 'single' ? ' active' : '');
  document.getElementById('jmode-multi').className  = 'seg-btn' + (m === 'multi'  ? ' active' : '');
}

/* ── Advanced toggle ────────────────────────────────────────────────────── */
function toggleAdv() {
  document.getElementById('adv-btn').classList.toggle('open');
  document.getElementById('adv-panel').classList.toggle('show');
}

/* ── Drag-and-drop ──────────────────────────────────────────────────────── */
function onDrag(e, id) { e.preventDefault(); document.getElementById(id).classList.add('drag-over'); }
function offDrag(id)   { document.getElementById(id).classList.remove('drag-over'); }

function onDrop(e, dzId, key) {
  e.preventDefault(); offDrag(dzId);
  const f = e.dataTransfer.files[0];
  if (f) attachFile(dzId, key, f);
}
function onPick(dzId, inputId, lblId, key) {
  const f = document.getElementById(inputId).files[0];
  if (f) attachFile(dzId, key, f);
}
function attachFile(dzId, key, f) {
  F[key] = f;
  const dz  = document.getElementById(dzId);
  const lbl = document.getElementById(key === 'collection' ? 'lbl-col' : 'lbl-env');
  dz.classList.add('loaded'); dz.classList.remove('drag-over');
  lbl.textContent = '✓ ' + f.name;
  if (!dz.querySelector('.dz-clear')) {
    const x = document.createElement('button');
    x.className = 'dz-clear'; x.title = 'Remove'; x.textContent = '×';
    x.onclick = ev => { ev.stopPropagation(); clearFile(dzId, key); };
    dz.appendChild(x);
  }
}
function clearFile(dzId, key) {
  F[key] = null;
  const dz  = document.getElementById(dzId);
  const lbl = document.getElementById(key === 'collection' ? 'lbl-col' : 'lbl-env');
  dz.classList.remove('loaded'); lbl.textContent = '';
  const x = dz.querySelector('.dz-clear'); if (x) x.remove();
  document.getElementById(key === 'collection' ? 'fi-col' : 'fi-env').value = '';
}

/* ── JMX file ───────────────────────────────────────────────────────────── */
function onPickJmx() {
  const f = document.getElementById('fi-jmx').files[0];
  if (f) attachJmxFile(f);
}
function onDropJmx(e) {
  e.preventDefault(); offDrag('dz-jmx');
  const f = e.dataTransfer.files[0];
  if (f) attachJmxFile(f);
}
function attachJmxFile(f) {
  JX.file = f;
  const dz = document.getElementById('dz-jmx');
  document.getElementById('lbl-jmx').textContent = '✓ ' + f.name;
  dz.classList.add('loaded'); dz.classList.remove('drag-over');
  if (!dz.querySelector('.dz-clear')) {
    const x = document.createElement('button');
    x.className = 'dz-clear'; x.title = 'Remove'; x.textContent = '×';
    x.onclick = ev => {
      ev.stopPropagation(); JX.file = null; dz.classList.remove('loaded');
      document.getElementById('lbl-jmx').textContent = ''; x.remove();
      document.getElementById('fi-jmx').value = '';
    };
    dz.appendChild(x);
  }
}

/* ── CSV supporting files ────────────────────────────────────────────────── */
function onPickCsv() {
  const files = Array.from(document.getElementById('fi-csv').files);
  if (files.length) attachCsvFiles(files);
}
function onDropCsv(e) {
  e.preventDefault(); offDrag('dz-csv');
  const files = Array.from(e.dataTransfer.files).filter(f => f.name.endsWith('.csv'));
  if (files.length) attachCsvFiles(files);
}
function attachCsvFiles(files) {
  JX.csvFiles = files;
  const dz = document.getElementById('dz-csv');
  document.getElementById('lbl-csv').textContent =
    files.length === 1 ? '✓ ' + files[0].name : `✓ ${files.length} CSV files`;
  dz.classList.add('loaded'); dz.classList.remove('drag-over');
  let x = dz.querySelector('.dz-clear');
  if (!x) {
    x = document.createElement('button');
    x.className = 'dz-clear'; x.title = 'Remove'; x.textContent = '×';
    dz.appendChild(x);
  }
  x.onclick = ev => {
    ev.stopPropagation(); JX.csvFiles = []; dz.classList.remove('loaded');
    document.getElementById('lbl-csv').textContent = ''; x.remove();
    document.getElementById('fi-csv').value = '';
  };
}

/* ── Cert / JAR supporting files ─────────────────────────────────────────── */
function onPickCert() {
  const files = Array.from(document.getElementById('fi-cert').files);
  if (files.length) attachCertFiles(files);
}
function onDropCert(e) {
  e.preventDefault(); offDrag('dz-cert');
  const files = Array.from(e.dataTransfer.files);
  if (files.length) attachCertFiles(files);
}
function attachCertFiles(files) {
  JX.certFiles = files;
  const dz = document.getElementById('dz-cert');
  document.getElementById('lbl-cert').textContent =
    files.length === 1 ? '✓ ' + files[0].name : `✓ ${files.length} file(s)`;
  dz.classList.add('loaded'); dz.classList.remove('drag-over');
  let x = dz.querySelector('.dz-clear');
  if (!x) {
    x = document.createElement('button');
    x.className = 'dz-clear'; x.title = 'Remove'; x.textContent = '×';
    dz.appendChild(x);
  }
  x.onclick = ev => {
    ev.stopPropagation(); JX.certFiles = []; dz.classList.remove('loaded');
    document.getElementById('lbl-cert').textContent = ''; x.remove();
    document.getElementById('fi-cert').value = '';
  };
}

/* ── Progress helper ────────────────────────────────────────────────────── */
function startProgress(wrapId, fillId) {
  const pw = document.getElementById(wrapId);
  const pf = document.getElementById(fillId);
  pw.style.display = 'block'; pf.style.width = '0%';
  let pct = 0;
  return {
    tick: setInterval(() => { pct = Math.min(pct + Math.random() * 14, 88); pf.style.width = pct + '%'; }, 300),
    fill: () => { pf.style.width = '100%'; },
    hide: () => { setTimeout(() => { pw.style.display = 'none'; }, 450); }
  };
}

/* ── Bruno/Postman convert ──────────────────────────────────────────────── */
async function doConvert() {
  if (!F.collection) { alert('Please upload a collection file first.'); return; }
  const btn  = document.getElementById('btn-cvt');
  const spin = document.getElementById('spinner');
  const lbl  = document.getElementById('btn-lbl');
  btn.disabled = true; spin.style.display = 'block'; lbl.textContent = 'Converting…';
  hideResults();
  const prog = startProgress('prog-wrap', 'prog-fill');

  const fd = new FormData();
  fd.append('collection', F.collection);
  if (F.environment) fd.append('environment', F.environment);
  fd.append('protocol',            S.proto);
  fd.append('mode',                S.mode);
  fd.append('thinkTime',           S.tt);
  fd.append('logLevel',            S.ll);
  fd.append('useCorrelation',      document.getElementById('opt-corr').checked);
  fd.append('useParameterization', document.getElementById('opt-param').checked);
  fd.append('useAuthentication',   document.getElementById('opt-auth').checked);
  fd.append('addComments',         document.getElementById('opt-cmt').checked);

  try {
    const r = await fetch('convert', { method: 'POST', body: fd });
    const d = await r.json();
    clearInterval(prog.tick); prog.fill(); prog.hide();
    resetBtn(); showResult(r.ok ? d : null, r.ok ? null : d.error);
  } catch(e) {
    clearInterval(prog.tick); prog.hide(); resetBtn(); showResult(null, e.message);
  }
}

function resetBtn() {
  document.getElementById('btn-cvt').disabled = false;
  document.getElementById('spinner').style.display = 'none';
  document.getElementById('btn-lbl').textContent = S.proto === 'devweb'
    ? '⚡ Convert to DevWeb Script' : '⚙️  Convert to VuGen Web HTTP/HTML';
}

/* ── JMeter convert ─────────────────────────────────────────────────────── */
async function doConvertJmx() {
  if (!JX.file) { alert('Please upload a JMX file first.'); return; }
  const btn  = document.getElementById('btn-jmx');
  const spin = document.getElementById('jspinner');
  const lbl  = document.getElementById('jbtn-lbl');
  btn.disabled = true; spin.style.display = 'block'; lbl.textContent = 'Converting…';
  hideResults();
  const prog = startProgress('jprog-wrap', 'jprog-fill');

  const fd = new FormData();
  fd.append('jmxFile',             JX.file);
  fd.append('protocol',            JX.proto);
  fd.append('thinkTime',           JX.tt);
  fd.append('generateWlmExcel',    JX.wlm);
  fd.append('mode',                JX.mode);
  fd.append('useTransactions',     'true');
  fd.append('useCorrelation',      'true');
  fd.append('useParameterization', 'true');
  fd.append('useAuthentication',   'true');
  fd.append('addComments',         'true');
  // Attach CSV and cert/JAR supporting files
  for (const f of JX.csvFiles)  fd.append('csvFiles',  f);
  for (const f of JX.certFiles) fd.append('certFiles', f);

  try {
    const r = await fetch('convert-jmx', { method: 'POST', body: fd });
    const d = await r.json();
    clearInterval(prog.tick); prog.fill(); prog.hide();
    resetJmxBtn(); showJmxResult(r.ok ? d : null, r.ok ? null : d.error);
  } catch(e) {
    clearInterval(prog.tick); prog.hide(); resetJmxBtn(); showJmxResult(null, e.message);
  }
}

function resetJmxBtn() {
  document.getElementById('btn-jmx').disabled = false;
  document.getElementById('jspinner').style.display = 'none';
  document.getElementById('jbtn-lbl').textContent = JX.proto === 'devweb'
    ? '♨ Convert JMeter to DevWeb Script' : '♨ Convert JMeter to VuGen Web HTTP/HTML';
}

/* ── Result renderers ───────────────────────────────────────────────────── */
function showResult(data, err) {
  if (err || !data) {
    document.getElementById('err-msg').textContent = err || 'Unknown error';
    document.getElementById('res-err').style.display = 'block';
    document.getElementById('res-err').scrollIntoView({ behavior: 'smooth', block: 'start' });
    return;
  }
  const a = data.analysis || {};
  const reqs   = a.requests?.total              ?? '—';
  const corrs  = a.correlations?.totalCorrelations ?? '—';
  const params = a.parameters?.totalParameters   ?? '—';
  document.getElementById('stats-row').innerHTML =
    stat(reqs,   'Requests')  +
    stat(corrs,  'Correlations') +
    stat(params, 'Parameters');
  const pl = data.protocol === 'web-http' ? 'VuGen Web HTTP/HTML (C)' : 'DevWeb (JavaScript)';
  const ml = data.mode === 'multi' ? 'Multi-Script' : 'Single Script';
  document.getElementById('res-sub').textContent = `${pl} · ${ml} · Ready for LoadRunner Enterprise`;
  document.getElementById('btn-dl').href = data.downloadUrl;
  document.getElementById('res-ok').style.display = 'block';
  document.getElementById('res-ok').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function showJmxResult(data, err) {
  if (err || !data) {
    document.getElementById('err-msg').textContent = err || 'Unknown error';
    document.getElementById('res-err').style.display = 'block';
    document.getElementById('res-err').scrollIntoView({ behavior: 'smooth', block: 'start' });
    return;
  }
  const a      = data.analysis || {};
  const tgArr  = data.threadGroups || [];
  const tgCount= tgArr.length;
  const reqs   = a.requests?.total              ?? data.metadata?.totalRequests ?? '—';
  const corrs  = a.correlations?.totalCorrelations ?? '—';
  const params = a.parameters?.totalParameters   ?? '—';

  document.getElementById('stats-row').innerHTML =
    stat(reqs,    'Requests')     +
    stat(corrs,   'Correlations') +
    stat(params,  'Parameters')   +
    stat(tgCount, 'Thread Groups');

  const pl   = data.protocol === 'web-http' ? 'VuGen Web HTTP/HTML (C)' : 'DevWeb (JavaScript)';
  const mode = data.multiScript ? 'Multi-Script (per thread group)' : 'Single Script';
  document.getElementById('res-sub').textContent =
    `JMeter → ${pl} · ${mode} · ${reqs} requests · ${tgCount} thread group(s)`;

  // ── Per-thread-group script list (multi mode only) ──────────────────
  const tgListEl = document.getElementById('res-tg-list');
  if (data.multiScript && data.scripts && data.scripts.length) {
    const typeIcon = { Standard:'🧵', SetUp:'▶', TearDown:'⏹', Stepping:'📈', Ultimate:'🚀', Concurrency:'⚡', Arrivals:'🌊' };
    let html = '<div style="font-size:0.78rem;font-weight:600;color:var(--text-2);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em">Generated Scripts</div>';
    html += '<div style="display:flex;flex-direction:column;gap:4px">';
    for (const s of data.scripts) {
      const icon = typeIcon[s.threadGroupType] || '🧵';
      html += `<div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;background:var(--glass);border:1px solid var(--glass-border);font-size:0.82rem">
        <span>${icon}</span>
        <span style="font-weight:500;color:var(--text)">${s.threadGroupName}</span>
        <span style="color:var(--text-3);margin-left:auto">${s.requestCount} requests</span>
        <span style="color:var(--text-3);font-family:'JetBrains Mono',monospace;font-size:0.72rem">${s.safeDirName}/</span>
      </div>`;
    }
    html += '</div>';
    tgListEl.innerHTML = html;
    tgListEl.style.display = 'block';
  } else {
    tgListEl.style.display = 'none';
  }

  // ── Dependency report ───────────────────────────────────────────────
  const depEl = document.getElementById('res-dep-report');
  const dep   = data.dependency;
  if (dep) {
    let html = '<div style="font-size:0.78rem;font-weight:600;color:var(--text-2);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em">Dependency Report</div>';
    if (dep.missing.length) {
      html += '<div style="margin-bottom:6px">';
      for (const m of dep.missing) {
        html += `<div style="display:flex;align-items:flex-start;gap:8px;padding:6px 10px;border-radius:6px;background:rgba(255,80,80,0.08);border:1px solid rgba(255,80,80,0.2);font-size:0.8rem;margin-bottom:4px">
          <span>⚠</span><span style="color:var(--text)">${m.message}</span></div>`;
      }
      html += '</div>';
    }
    if (dep.found.filter(f => f.type === 'csv').length) {
      html += '<div style="display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;background:rgba(80,200,100,0.08);border:1px solid rgba(80,200,100,0.2);font-size:0.8rem">';
      html += `<span>✓</span><span>${dep.found.filter(f=>f.type==='csv').length} CSV file(s) uploaded — included in output ZIP</span></div>`;
    }
    if (dep.warnings.length) {
      html += '<div style="margin-top:6px">';
      for (const w of dep.warnings) {
        html += `<div style="padding:5px 10px;border-radius:5px;background:var(--glass);font-size:0.78rem;color:var(--text-2);margin-bottom:3px">ℹ ${w}</div>`;
      }
      html += '</div>';
    }
    if (dep.required.length === 0 && dep.warnings.length === 0) {
      html += '<div style="font-size:0.8rem;color:var(--text-3)">No external file dependencies detected.</div>';
    }
    depEl.innerHTML = html;
    depEl.style.display = 'block';
  } else {
    depEl.style.display = 'none';
  }

  document.getElementById('btn-dl').href = data.downloadUrl;
  document.getElementById('res-ok').style.display = 'block';
  document.getElementById('res-ok').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function stat(num, label) {
  return `<div class="stat"><span class="stat-num">${num}</span><span class="stat-lbl">${label}</span></div>`;
}

function hideResults() {
  document.getElementById('res-ok').style.display = 'none';
  document.getElementById('res-err').style.display = 'none';
}
function resetResult() { hideResults(); }
</script>
</body>
</html>
