.help-format-blue   { background: var(--primary-dim); border-color: rgba(79,142,247,0.22); }
.help-format-orange { background: rgba(240,136,62,0.08); border-color: rgba(240,136,62,0.22); }
.help-format-purple1{ background: rgba(124,92,252,0.08); border-color: rgba(124,92,252,0.20); }
