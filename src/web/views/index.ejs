<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>LRE Toolkit — Performance Engineering · v<%= version %></title>
<script>/* prevent FOUC */(function(){const t=localStorage.getItem('lr-theme');if(t)document.documentElement.setAttribute('data-theme',t);})();</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
/* ── Dark tokens (default) ──────────────────────────────────────────────── */
:root {
  /* backgrounds */
  --bg:           #060b15;
  --bg2:          #0b1221;
  --nav-bg:       rgba(6,11,21,0.92);
  /* glass surfaces */
  --glass:        rgba(255,255,255,0.045);
  --glass-border: rgba(255,255,255,0.09);
  --glass-hover:  rgba(255,255,255,0.07);
  --surface:      rgba(11,18,33,0.88);
  /* text */
  --text:         #eaf0fb;
  --text-2:       #8fa3c0;
  --text-3:       #4a5a72;
  /* brand colours */
  --primary:      #4f8ef7;
  --primary-glow: rgba(79,142,247,0.28);
  --primary-dim:  rgba(79,142,247,0.11);
  --accent:       #7c5cfc;
  --accent-glow:  rgba(124,92,252,0.25);
  /* protocol colours */
  --vugen:        #f0883e;
  --vugen-glow:   rgba(240,136,62,0.28);
  --vugen-dim:    rgba(240,136,62,0.11);
  /* status */
  --success:      #34d17a;
  --success-glow: rgba(52,209,122,0.22);
  --success-dim:  rgba(52,209,122,0.09);
  --danger:       #f06464;
  --danger-dim:   rgba(240,100,100,0.10);
  --warn:         #f0c040;
  /* typography */
  --mono: 'JetBrains Mono', 'Cascadia Code', 'Fira Code', Consolas, monospace;
  --sans: 'Inter', system-ui, -apple-system, sans-serif;
  /* shape */
  --r-xs: 5px; --r-sm: 8px; --r-md: 12px; --r-lg: 18px; --r-xl: 24px; --r-2xl: 32px;
  /* elevation */
  --shadow-sm: 0 2px 8px rgba(0,0,0,0.30);
  --shadow:    0 8px 32px rgba(0,0,0,0.45);
  --shadow-lg: 0 24px 64px rgba(0,0,0,0.65);
  /* timing */
  --tr: 0.2s cubic-bezier(0.4,0,0.2,1);
  --tr-spring: 0.3s cubic-bezier(0.34,1.56,0.64,1);
  /* misc */
  --knob: var(--text-3);
}
/* ── Light tokens ───────────────────────────────────────────────────────── */
[data-theme="light"] {
  --bg:           #f0f4fa;
  --bg2:          #e2eaf6;
  --nav-bg:       rgba(255,255,255,0.94);
  --glass:        rgba(255,255,255,0.70);
  --glass-border: rgba(0,0,0,0.08);
  --glass-hover:  rgba(0,0,0,0.04);
  --surface:      rgba(255,255,255,0.92);
  --text:         #0b1221;
  --text-2:       #334560;
  --text-3:       #7a90ab;
  --primary-glow: rgba(79,142,247,0.16);
  --primary-dim:  rgba(79,142,247,0.09);
  --accent-glow:  rgba(124,92,252,0.14);
  --vugen-glow:   rgba(240,136,62,0.16);
  --vugen-dim:    rgba(240,136,62,0.09);
  --success-glow: rgba(52,209,122,0.14);
  --success-dim:  rgba(52,209,122,0.08);
  --danger-dim:   rgba(220,38,38,0.08);
  --shadow-sm: 0 1px 4px rgba(0,0,0,0.07);
  --shadow:    0 4px 20px rgba(0,0,0,0.09);
  --shadow-lg: 0 12px 40px rgba(0,0,0,0.13);
  --knob: #94a3b8;
}

/* ── Theme transitions ──────────────────────────────────────────────────── */
body, .topnav, .card, .tab-bar, .tab-btn, .hero,
.result-box, .stat, .jmx-features, .opt-group,
.drop-zone, .dz-icon-wrap, .feat-check,
.step, .chip, .fmt-chip, footer, .toggle-row,
.adv-panel, .adv-toggle, .btn-reset, .nav-ver,
.proto-card, .seg-btn, .slider, .dz-clear {
  transition: background-color 0.30s ease, background 0.30s ease,
              border-color 0.30s ease, color 0.30s ease !important;
}
/* Restore pointer/transform transitions for interactive elements */
.btn-convert, .btn-dl, .proto-card, .step, .tab-btn,
.btn-reset, .seg-btn, .dz-clear, .theme-btn {
  transition: background-color 0.30s ease, background 0.30s ease,
              border-color 0.30s ease, color 0.30s ease,
              transform var(--tr), filter var(--tr), box-shadow var(--tr) !important;
}

/* ── Reset & base ───────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

body {
  font-family: var(--sans);
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58px 20px 60px;   /* 58px = nav height + gap */
  position: relative;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* ── Animated background mesh ───────────────────────────────────────────── */
body::before {
  content: '';
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 70% 55% at  8%  5%, rgba(79,142,247,0.13) 0%, transparent 60%),
    radial-gradient(ellipse 55% 45% at 92% 12%, rgba(124,92,252,0.11) 0%, transparent 55%),
    radial-gradient(ellipse 45% 35% at 50% 95%, rgba(240,136,62,0.07) 0%, transparent 60%),
    radial-gradient(ellipse 40% 30% at 85% 75%, rgba(52,209,122,0.05) 0%, transparent 55%);
  transition: background 0.5s ease;
}
[data-theme="light"] body::before {
  background:
    radial-gradient(ellipse 70% 55% at  8%  5%, rgba(79,142,247,0.07) 0%, transparent 60%),
    radial-gradient(ellipse 55% 45% at 92% 12%, rgba(124,92,252,0.05) 0%, transparent 55%),
    radial-gradient(ellipse 45% 35% at 50% 95%, rgba(240,136,62,0.04) 0%, transparent 60%);
}
body > * { position: relative; z-index: 1; }

/* ── Top Navigation Bar ─────────────────────────────────────────────────── */
.topnav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  height: 58px;
  background: var(--nav-bg);
  backdrop-filter: blur(24px) saturate(1.6);
  -webkit-backdrop-filter: blur(24px) saturate(1.6);
  border-bottom: 1px solid var(--glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 0 var(--glass-border), var(--shadow-sm);
}
.nav-inner {
  width: 100%;
  max-width: 1100px;
  padding: 0 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}
.nav-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  text-decoration: none;
  color: inherit;
}
.nav-brand:hover .nav-title { color: var(--primary); }
.nav-brand:hover .nav-logo  { box-shadow: 0 4px 20px var(--primary-glow); transform: scale(1.05); }
.nav-logo { transition: box-shadow var(--tr), transform var(--tr-spring); }
.nav-title { transition: color var(--tr); }
.nav-subtitle {
  font-size: 9.5px; font-weight: 500; color: var(--text-3);
  letter-spacing: .04em; line-height: 1;
}
.nav-logo {
  width: 30px; height: 30px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  display: flex; align-items: center; justify-content: center;
  font-size: 15px;
  flex-shrink: 0;
  box-shadow: 0 2px 10px var(--primary-glow);
}
.nav-title {
  font-size: 14px;
  font-weight: 700;
  letter-spacing: -0.3px;
  color: var(--text);
}
.nav-ver {
  font-size: 10.5px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 99px;
  background: var(--primary-dim);
  color: var(--primary);
  border: 1px solid rgba(79,142,247,0.2);
  font-family: var(--mono);
}
.nav-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}
.nav-status {
  display: flex; align-items: center; gap: 6px;
  font-size: 11px; font-weight: 600;
  color: var(--success);
  padding: 4px 10px;
  border-radius: 99px;
  background: rgba(52,209,122,0.08);
  border: 1px solid rgba(52,209,122,0.2);
}
.nav-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: currentColor;
  animation: pulse 2s ease-in-out infinite;
}
.theme-btn {
  width: 34px; height: 34px;
  border-radius: 10px;
  border: 1px solid var(--glass-border);
  background: var(--glass);
  color: var(--text-2);
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.theme-btn:hover {
  background: var(--primary-dim);
  border-color: rgba(79,142,247,0.35);
  color: var(--primary);
}
.theme-btn svg { width: 15px; height: 15px; transition: transform 0.3s ease; pointer-events: none; }
.theme-btn:hover svg { transform: rotate(20deg); }
[data-theme="dark"]  .icon-moon { display: none; }
[data-theme="light"] .icon-sun  { display: none; }

/* ── Hero / Page header ─────────────────────────────────────────────────── */
.hero {
  width: 100%;
  max-width: 900px;
  text-align: center;
  padding: 40px 0 28px;
}
.hero-sub {
  font-size: 15px;
  color: var(--text-2);
  line-height: 1.6;
  max-width: 500px;
  margin: 0 auto 16px;
}
.hero-badges {
  display: flex; align-items: center; justify-content: center;
  gap: 8px; flex-wrap: wrap;
}
.chip {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 12px;
  border-radius: 99px;
  font-size: 11.5px; font-weight: 600;
  border: 1px solid var(--glass-border);
  background: var(--glass);
  color: var(--text-2);
  backdrop-filter: blur(8px);
}
.chip-live { background: rgba(52,209,122,0.08); border-color: rgba(52,209,122,0.20); color: var(--success); }
.chip-dot  { width: 6px; height: 6px; border-radius: 50%; background: currentColor; animation: pulse 2s ease-in-out infinite; }
@keyframes pulse { 0%,100% { opacity:1; } 50% { opacity:0.4; } }

/* ── Tabs ───────────────────────────────────────────────────────────────── */
.tab-bar {
  display: flex;
  width: 100%;
  max-width: 900px;
  background: var(--glass);
  border: 1px solid var(--glass-border);
  border-radius: var(--r-lg) var(--r-lg) 0 0;
  padding: 6px;
  gap: 4px;
  backdrop-filter: blur(16px);
  margin-bottom: -1px;
  position: relative;
  z-index: 2;
}
.tab-btn {
  flex: 1;
  padding: 10px 20px;
  border: none;
  border-radius: var(--r-md);
  background: transparent;
  color: var(--text-3);
  font-family: var(--sans);
  font-size: 13.5px; font-weight: 600;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.tab-btn:hover { color: var(--text-2); background: var(--glass-hover); }
.tab-btn.active-bruno {
  background: linear-gradient(135deg, rgba(79,142,247,0.20), rgba(124,92,252,0.15));
  color: var(--text);
  border: 1px solid rgba(79,142,247,0.30);
  box-shadow: 0 2px 12px rgba(79,142,247,0.15);
}
.tab-btn.active-jmx {
  background: linear-gradient(135deg, rgba(240,136,62,0.20), rgba(240,100,62,0.10));
  color: var(--text);
  border: 1px solid rgba(240,136,62,0.30);
  box-shadow: 0 2px 12px rgba(240,136,62,0.15);
}
.tab-icon { font-size: 16px; }

/* ── Card ───────────────────────────────────────────────────────────────── */
.card {
  width: 100%;
  max-width: 900px;
  background: var(--surface);
  border: 1px solid var(--glass-border);
  border-radius: 0 0 var(--r-xl) var(--r-xl);
  padding: 28px 32px 32px;
  backdrop-filter: blur(24px);
  margin-bottom: 16px;
  box-shadow: var(--shadow-sm);
}
.card.standalone {
  border-radius: var(--r-xl); margin-top: 16px;
  border-top: 1px solid var(--glass-border);
}

.section-label {
  display: flex; align-items: center; gap: 10px;
  font-size: 10.5px; font-weight: 700;
  color: var(--text-3);
  text-transform: uppercase; letter-spacing: 1.4px;
  margin-bottom: 18px;
}
.section-label::before {
  content: '';
  width: 3px; height: 14px;
  border-radius: 2px;
  background: linear-gradient(to bottom, var(--primary), var(--accent));
  flex-shrink: 0;
}
.section-num {
  display: inline-flex; align-items: center; justify-content: center;
  width: 22px; height: 22px;
  border-radius: 7px;
  background: linear-gradient(135deg, var(--primary-dim), rgba(124,92,252,0.10));
  color: var(--primary);
  font-size: 10px; font-weight: 800;
  border: 1px solid rgba(79,142,247,0.18);
}

/* ── Protocol selector ──────────────────────────────────────────────────── */
.proto-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
  margin-bottom: 28px;
}
@media (max-width: 560px) { .proto-grid { grid-template-columns: 1fr; } }

.proto-card {
  border: 1.5px solid var(--glass-border);
  border-radius: var(--r-lg);
  padding: 18px 20px;
  cursor: pointer;
  display: flex; gap: 14px; align-items: flex-start;
  user-select: none;
  background: var(--glass);
  position: relative; overflow: hidden;
  transition: border-color var(--tr), box-shadow var(--tr), transform var(--tr-spring);
}
.proto-card:hover { transform: translateY(-2px); }
.proto-card:hover { border-color: rgba(79,142,247,0.30); transform: translateY(-1px); }
[data-theme="light"] .proto-card:hover { border-color: rgba(79,142,247,0.40); }
.proto-card.active-devweb {
  border-color: var(--primary);
  background: var(--primary-dim);
  box-shadow: 0 0 0 1px rgba(79,142,247,0.20), 0 8px 24px rgba(79,142,247,0.12);
}
.proto-card.active-vugen {
  border-color: var(--vugen);
  background: var(--vugen-dim);
  box-shadow: 0 0 0 1px rgba(240,136,62,0.20), 0 8px 24px rgba(240,136,62,0.12);
}
.proto-icon {
  width: 42px; height: 42px;
  border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; flex-shrink: 0;
}
.proto-icon-blue   { background: linear-gradient(135deg, #1a4f9e, #2d6cd4); }
.proto-icon-orange { background: linear-gradient(135deg, #7a3b0a, #c4671a); }
.proto-name { font-size: 14.5px; font-weight: 700; margin-bottom: 4px; }
.proto-desc { font-size: 12px; color: var(--text-2); line-height: 1.55; }
.proto-tag {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10px; font-weight: 700;
  padding: 3px 8px; border-radius: 6px;
  margin-top: 8px; font-family: var(--mono);
}
.tag-js { background: rgba(79,142,247,0.15); color: #7eb3ff; border: 1px solid rgba(79,142,247,0.30); }
.tag-c  { background: rgba(240,136,62,0.15);  color: #ffa96a; border: 1px solid rgba(240,136,62,0.30); }

/* ── Upload zones ───────────────────────────────────────────────────────── */
.upload-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  margin-bottom: 28px;
}
@media (max-width: 560px) { .upload-grid { grid-template-columns: 1fr; } }

.drop-zone {
  border: 1.5px dashed var(--glass-border);
  border-radius: var(--r-lg);
  padding: 28px 20px;
  text-align: center;
  cursor: pointer;
  position: relative;
  background: var(--glass);
  overflow: hidden;
}
/* Compact secondary drop zones (CSV / cert files) */
.dz-secondary {
  padding: 14px 14px;
}
.dz-secondary .dz-icon-wrap {
  width: 34px; height: 34px; border-radius: 9px; font-size: 16px; margin-bottom: 8px;
}
.drop-zone:hover        { border-color: rgba(79,142,247,0.40); background: var(--primary-dim); }
.drop-zone.drag-over    { border-color: var(--primary); border-style: solid; background: rgba(79,142,247,0.08); }
.drop-zone.loaded       { border-color: var(--success); border-style: solid; background: var(--success-dim); }
.drop-zone input[type=file] {
  position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
}
.dz-icon-wrap {
  width: 44px; height: 44px; border-radius: 12px;
  background: var(--glass); border: 1px solid var(--glass-border);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; margin: 0 auto 12px;
}
.drop-zone:hover .dz-icon-wrap { border-color: rgba(79,142,247,0.40); background: rgba(79,142,247,0.10); }
.drop-zone.loaded .dz-icon-wrap { border-color: rgba(52,209,122,0.40); background: var(--success-dim); }
.dz-label    { font-size: 13px; font-weight: 600; margin-bottom: 4px; }
.dz-sub      { font-size: 11px; color: var(--text-3); line-height: 1.5; }
.dz-opt      { font-size: 10.5px; color: var(--warn); margin-top: 6px; display: block; }
.dz-name     { font-size: 11.5px; color: var(--success); font-weight: 600; word-break: break-all; margin-top: 8px; }
.dz-required { color: var(--danger); }
.dz-clear {
  position: absolute; top: 10px; right: 12px;
  background: var(--glass); border: 1px solid var(--glass-border);
  color: var(--text-3); cursor: pointer;
  font-size: 14px; line-height: 1;
  width: 24px; height: 24px; border-radius: 6px;
  display: flex; align-items: center; justify-content: center;
  z-index: 10;
}
.dz-clear:hover { color: var(--danger); border-color: rgba(240,100,100,0.40); background: rgba(240,100,100,0.10); }

/* ── Options ────────────────────────────────────────────────────────────── */
.options-grid {
  display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 20px;
}
.opt-group {
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: var(--r-md); padding: 14px 16px;
  flex: 1; min-width: 150px;
}
.opt-label {
  font-size: 10px; color: var(--text-3); display: block;
  margin-bottom: 11px; text-transform: uppercase; letter-spacing: 1px; font-weight: 700;
}
.seg-btns { display: flex; gap: 3px; }
.seg-btn {
  flex: 1; padding: 7px 10px;
  border: 1px solid var(--glass-border);
  background: transparent; color: var(--text-3);
  border-radius: var(--r-xs); font-size: 12px;
  font-family: var(--sans); cursor: pointer;
  white-space: nowrap; font-weight: 500;
  transition: background var(--tr), border-color var(--tr), color var(--tr);
}
.seg-btn:hover { border-color: rgba(79,142,247,0.35); color: var(--text-2); }
.seg-btn.active {
  background: var(--primary-dim); border-color: rgba(79,142,247,0.40);
  color: var(--primary); font-weight: 700;
  box-shadow: 0 0 0 1px rgba(79,142,247,0.12) inset;
}

/* ── Advanced panel ─────────────────────────────────────────────────────── */
.adv-toggle {
  background: none; border: 1px solid transparent;
  color: var(--text-3); cursor: pointer;
  font-size: 12.5px; font-family: var(--sans);
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 12px; margin-bottom: 12px;
  border-radius: var(--r-sm); font-weight: 500;
}
.adv-toggle:hover { color: var(--text-2); background: var(--glass); border-color: var(--glass-border); }
.arrow { transition: transform var(--tr); font-size: 10px; display: inline-block; }
.adv-toggle.open .arrow { transform: rotate(90deg); }
.adv-panel {
  display: none; background: var(--glass);
  border: 1px solid var(--glass-border);
  border-radius: var(--r-md); padding: 4px 0;
  margin-bottom: 18px; overflow: hidden;
}
.adv-panel.show { display: block; }
.toggle-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 13px 18px;
  border-bottom: 1px solid var(--glass-border);
}
.toggle-row:last-child { border-bottom: none; }
.toggle-row:hover { background: var(--glass-hover); }
.tgl-label { font-size: 13px; font-weight: 500; }
.tgl-sub   { font-size: 11px; color: var(--text-3); margin-top: 3px; line-height: 1.4; }

/* Toggle switch */
.switch { position: relative; width: 42px; height: 24px; flex-shrink: 0; }
.switch input { opacity: 0; width: 0; height: 0; }
.slider {
  position: absolute; inset: 0;
  background: rgba(255,255,255,0.10); border: 1px solid var(--glass-border);
  border-radius: 24px; cursor: pointer;
}
[data-theme="light"] .slider { background: rgba(0,0,0,0.10); }
.slider::before {
  content: ''; position: absolute;
  width: 16px; height: 16px; left: 3px; top: 3px;
  background: var(--knob); border-radius: 50%;
  transition: var(--tr);
}
.switch input:checked + .slider { background: var(--primary); border-color: var(--primary); box-shadow: 0 0 8px var(--primary-glow); }
.switch input:checked + .slider::before { transform: translateX(18px); background: #fff; }

/* ── Convert button ─────────────────────────────────────────────────────── */
.divider { height: 1px; background: var(--glass-border); margin: 20px 0; }

.btn-convert {
  width: 100%; padding: 15px;
  font-size: 14.5px; font-weight: 700; font-family: var(--sans);
  border: none; border-radius: var(--r-md); cursor: pointer;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  letter-spacing: 0.2px; position: relative; overflow: hidden;
}
.btn-convert::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
  transform: translateX(-100%); transition: transform 0.5s ease;
}
.btn-convert:hover::before { transform: translateX(100%); }
.btn-convert.devweb {
  background: linear-gradient(135deg, #1a4fb5, #3d7ef0, #5a9fff);
  color: #fff; box-shadow: 0 4px 20px rgba(60,120,240,0.40), 0 1px 0 rgba(255,255,255,0.10) inset;
}
.btn-convert.vugen {
  background: linear-gradient(135deg, #8a3500, #d4620e, #f0883e);
  color: #fff; box-shadow: 0 4px 20px rgba(200,90,20,0.40), 0 1px 0 rgba(255,255,255,0.10) inset;
}
.btn-convert:hover:not(:disabled) { transform: translateY(-2px); filter: brightness(1.08); }
.btn-convert:active:not(:disabled) { transform: translateY(0); filter: brightness(0.96); }
.btn-convert:disabled { opacity: 0.45; cursor: not-allowed; transform: none !important; filter: none !important; }

/* Spinner */
.spinner {
  width: 18px; height: 18px;
  border: 2px solid rgba(255,255,255,0.25);
  border-top-color: #fff; border-radius: 50%;
  animation: spin 0.65s linear infinite;
  display: none; flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* Progress bar */
.prog-wrap {
  height: 3px; background: var(--glass-border); border-radius: 3px;
  overflow: hidden; margin: 16px 0; display: none;
}
.prog-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary), var(--accent), var(--success));
  background-size: 200%; width: 0%;
  transition: width 0.4s ease;
  animation: shimmer 2s linear infinite;
}
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* ── Result box ─────────────────────────────────────────────────────────── */
.result-box {
  width: 100%; max-width: 900px;
  border-radius: var(--r-xl); padding: 28px;
  backdrop-filter: blur(20px); margin-top: 16px;
}
.result-ok  {
  background: linear-gradient(135deg, rgba(52,209,122,0.08), rgba(52,209,122,0.04));
  border: 1px solid rgba(52,209,122,0.25);
  box-shadow: 0 0 40px rgba(52,209,122,0.08); display: none;
}
.result-err {
  background: linear-gradient(135deg, rgba(240,100,100,0.08), rgba(240,100,100,0.04));
  border: 1px solid rgba(240,100,100,0.25); display: none;
}
.res-head   { display: flex; align-items: flex-start; gap: 16px; margin-bottom: 20px; }
.res-icon   { width: 48px; height: 48px; border-radius: var(--r-md); display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; }
.res-icon-ok  { background: var(--success-dim); border: 1px solid rgba(52,209,122,0.30); }
.res-icon-err { background: rgba(240,100,100,0.10); border: 1px solid rgba(240,100,100,0.30); }
.res-title  { font-size: 18px; font-weight: 700; margin-bottom: 4px; }
.res-sub    { font-size: 12.5px; color: var(--text-2); line-height: 1.5; }
.stats-grid { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 22px; }
.stat {
  flex: 1; min-width: 80px;
  background: var(--glass); border: 1px solid var(--glass-border);
  border-radius: var(--r-md); padding: 14px 16px; text-align: center;
}
.stat-num {
  display: block; font-size: 28px; font-weight: 800; font-family: var(--mono);
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text; line-height: 1.1; margin-bottom: 4px;
}
.stat-lbl { font-size: 10px; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; }
.res-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.btn-dl {
  display: inline-flex; align-items: center; gap: 8px;
  background: linear-gradient(135deg, #0d7a3e, #1aad58, #34d17a);
  color: #fff; border: none; border-radius: var(--r-md);
  padding: 13px 24px; font-size: 14px; font-family: var(--sans);
  font-weight: 700; cursor: pointer; text-decoration: none;
  box-shadow: 0 4px 16px rgba(52,209,122,0.30);
}
.btn-dl:hover { transform: translateY(-2px); filter: brightness(1.10); }
.btn-reset {
  background: var(--glass); border: 1px solid var(--glass-border);
  color: var(--text-2); border-radius: var(--r-md);
  padding: 12px 20px; font-size: 13px; font-family: var(--sans);
  cursor: pointer; font-weight: 500;
}
.btn-reset:hover { border-color: rgba(79,142,247,0.40); color: var(--primary); }

/* ── JMX feature list ───────────────────────────────────────────────────── */
.jmx-features {
  display: flex; flex-direction: column; gap: 8px;
  padding: 18px; background: var(--glass);
  border: 1px solid var(--glass-border);
  border-radius: var(--r-lg); height: 100%;
}
.jmx-feat-title {
  font-size: 10.5px; font-weight: 700; color: var(--text-3);
  text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 6px;
}
.feat-item {
  display: flex; align-items: center; gap: 10px;
  font-size: 12.5px; color: var(--text-2);
  padding: 6px 0; border-bottom: 1px solid var(--glass-border);
}
.feat-item:last-child { border-bottom: none; }
.feat-check {
  width: 18px; height: 18px; border-radius: 5px;
  background: var(--success-dim); border: 1px solid rgba(52,209,122,0.30);
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; color: var(--success); flex-shrink: 0;
}

/* ── How it works ───────────────────────────────────────────────────────── */
.steps-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(150px,1fr)); gap: 10px;
}
.step {
  padding: 20px 16px; text-align: center;
  border: 1px solid var(--glass-border);
  border-radius: var(--r-lg); background: var(--glass);
  position: relative; overflow: hidden;
}
.step::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg, var(--primary-dim), transparent);
  opacity: 0; transition: opacity var(--tr);
}
.step:hover { border-color: rgba(79,142,247,0.30); transform: translateY(-2px); }
.step:hover::before { opacity: 1; }
.step-icon {
  width: 44px; height: 44px; border-radius: 12px;
  background: linear-gradient(135deg, var(--primary-dim), rgba(124,92,252,0.10));
  border: 1px solid rgba(79,142,247,0.20);
  display: flex; align-items: center; justify-content: center;
  font-size: 20px; margin: 0 auto 12px;
}
.step-ttl { font-size: 13px; font-weight: 700; margin-bottom: 6px; }
.step-txt { font-size: 11.5px; color: var(--text-3); line-height: 1.55; }

/* ── Formats bar ────────────────────────────────────────────────────────── */
.formats-bar {
  display: flex; gap: 8px; flex-wrap: wrap;
  justify-content: center; margin: 20px 0 0;
}
.fmt-chip {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: 99px;
  border: 1px solid var(--glass-border); background: var(--glass);
  font-size: 11.5px; font-weight: 600; color: var(--text-2);
  backdrop-filter: blur(8px);
}

/* ── Footer ─────────────────────────────────────────────────────────────── */
footer {
  color: var(--text-3); font-size: 11px;
  text-align: center; margin-top: 32px; padding-bottom: 16px;
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  width: 100%;
  border-top: 1px solid var(--glass-border);
  padding-top: 20px;
}
.footer-links {
  display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;
  letter-spacing: 0.02em;
}
.footer-sep { color: var(--glass-border); }

/* ══ Portal Nav Tabs — centered underline style ═══════════════════════════ */
.portal-tabs {
  position: absolute; left: 50%; transform: translateX(-50%);
  display: flex; align-items: stretch; gap: 0;
  height: 58px;
}
.ptab {
  padding: 0 22px; border: none; border-radius: 0;
  background: transparent; color: var(--text-3);
  font-family: var(--sans); font-size: 13px; font-weight: 600;
  cursor: pointer; white-space: nowrap;
  display: flex; align-items: center; gap: 8px;
  position: relative;
  transition: color 0.18s ease;
  letter-spacing: -0.1px;
}
/* underline bar — slides in from centre */
.ptab::after {
  content: ''; position: absolute;
  bottom: 0; left: 50%; right: 50%; height: 2px;
  background: linear-gradient(90deg, var(--primary), var(--accent));
  border-radius: 2px 2px 0 0;
  transition: left 0.24s cubic-bezier(0.4,0,0.2,1),
              right 0.24s cubic-bezier(0.4,0,0.2,1);
}
.ptab:hover { color: var(--text-2); }
.ptab.ptab-active { color: var(--text); font-weight: 700; }
.ptab.ptab-active::after { left: 8px; right: 8px; }

/* subtitles on tabs */
.ptab-sub {
  font-size: 9.5px; font-weight: 500; color: inherit;
  opacity: 0.50; letter-spacing: .02em; line-height: 1;
}
.ptab-label { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }

/* ══ Converter / content panel — centers all children ═══════════════════ */
.portal-content-panel {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}
/* Ensure hero inside converter is constrained */
.portal-content-panel .hero {
  width: 100%;
  max-width: 900px;
}

/* ══ Iframe panels (Recorder / Studio) ═══════════════════════════════════ */
.portal-iframe-panel {
  display: none; position: fixed;
  top: 58px; left: 0; right: 0; bottom: 0;
  z-index: 150; background: var(--bg);
  flex-direction: column;
}
.portal-iframe-panel iframe {
  flex: 1; width: 100%; border: none; min-height: 0;
}
/* Chrome bar that sits above each iframe tool */
.iframe-chrome {
  height: 42px; flex-shrink: 0;
  background: var(--surface);
  border-bottom: 1px solid var(--glass-border);
  backdrop-filter: blur(16px);
  display: flex; align-items: center; gap: 10px;
  padding: 0 16px;
}
.iframe-back-btn {
  display: flex; align-items: center; gap: 6px;
  padding: 5px 12px; border-radius: var(--r-sm);
  border: 1px solid var(--glass-border);
  background: var(--glass); color: var(--text-2);
  font-family: var(--sans); font-size: 12px; font-weight: 600;
  cursor: pointer;
  transition: background var(--tr), border-color var(--tr), color var(--tr);
}
.iframe-back-btn:hover { background: var(--primary-dim); border-color: rgba(79,142,247,0.35); color: var(--primary); }
.iframe-tool-title {
  font-size: 13px; font-weight: 700; color: var(--text); flex: 1;
}
.iframe-tool-badge {
  font-size: 10px; font-weight: 600; padding: 2px 9px; border-radius: 99px;
  border: 1px solid var(--glass-border); background: var(--glass); color: var(--text-3);
}

/* ══ Home Panel ══════════════════════════════════════════════════════════ */
#portal-home {
  width: 100%; max-width: 1040px;
  display: flex; flex-direction: column; align-items: center;
  padding-bottom: 60px;
}

/* Hero */
.home-hero {
  text-align: center; padding: 52px 0 40px; width: 100%;
}
.home-hero-badge {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 6px 16px; border-radius: 99px; margin-bottom: 22px;
  background: var(--primary-dim); border: 1px solid rgba(79,142,247,0.30);
  color: var(--primary); font-size: 11.5px; font-weight: 700;
  letter-spacing: .06em; text-transform: uppercase;
  animation: fadeDown 0.5s cubic-bezier(0.4,0,0.2,1) both;
}
.home-hero h1 {
  font-size: clamp(28px, 4vw, 44px); font-weight: 800;
  letter-spacing: -1px; line-height: 1.12;
  margin-bottom: 18px;
  background: linear-gradient(135deg, var(--text) 0%, var(--primary) 55%, var(--accent) 100%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: fadeDown 0.5s cubic-bezier(0.4,0,0.2,1) 0.08s both;
}
.home-hero-sub {
  font-size: 15.5px; color: var(--text-2); line-height: 1.7;
  max-width: 600px; margin: 0 auto 28px;
  animation: fadeDown 0.5s cubic-bezier(0.4,0,0.2,1) 0.14s both;
}
@keyframes fadeDown {
  from { opacity:0; transform: translateY(-14px); }
  to   { opacity:1; transform: translateY(0); }
}

/* Stats row */
.home-stats {
  display: flex; align-items: stretch; justify-content: center;
  gap: 0; flex-wrap: wrap;
  background: var(--surface); border: 1px solid var(--glass-border);
  border-radius: var(--r-lg); backdrop-filter: blur(20px);
  margin-bottom: 44px; overflow: hidden; width: 100%; max-width: 760px;
  animation: fadeUp 0.5s cubic-bezier(0.4,0,0.2,1) 0.2s both;
  box-shadow: var(--shadow);
}
.home-stat {
  flex: 1; min-width: 130px;
  padding: 22px 16px; text-align: center;
  border-right: 1px solid var(--glass-border);
  transition: background var(--tr);
}
.home-stat:last-child { border-right: none; }
.home-stat:hover { background: var(--glass-hover); }
.home-stat-num {
  font-size: 34px; font-weight: 800; letter-spacing: -1.5px;
  line-height: 1; margin-bottom: 5px;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
}
.home-stat-lbl {
  font-size: 10.5px; font-weight: 600; color: var(--text-3);
  text-transform: uppercase; letter-spacing: .08em;
}
@keyframes fadeUp {
  from { opacity:0; transform: translateY(16px); }
  to   { opacity:1; transform: translateY(0); }
}

/* ── Tool cards — FULLY CLICKABLE ───────────────────────────────────────── */
.tool-cards {
  display: grid; grid-template-columns: repeat(3,1fr);
  gap: 20px; width: 100%; margin-bottom: 52px;
}
@media (max-width: 740px)  { .tool-cards { grid-template-columns: 1fr; } }
@media (max-width: 1000px) and (min-width: 741px) { .tool-cards { grid-template-columns: repeat(2,1fr); } }

.tool-card {
  background: var(--surface); border: 1px solid var(--glass-border);
  border-radius: var(--r-xl); padding: 28px 24px 22px;
  display: flex; flex-direction: column;
  backdrop-filter: blur(20px);
  position: relative; overflow: hidden;
  cursor: pointer; user-select: none; outline: none;
  /* smooth all transitions */
  transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1),
              box-shadow 0.22s ease,
              border-color 0.22s ease;
}
/* coloured top accent — always visible at 3px */
.tool-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  border-radius: var(--r-xl) var(--r-xl) 0 0;
}
.tool-card.tc-blue::before  { background: linear-gradient(90deg, var(--primary), var(--accent)); }
.tool-card.tc-green::before { background: linear-gradient(90deg, #34d17a, #22b5c0); }
.tool-card.tc-purple::before{ background: linear-gradient(90deg, var(--accent), #e040fb); }

/* glow on hover — colour-matched per card */
.tool-card.tc-blue:hover  {
  transform: translateY(-8px) scale(1.012);
  border-color: rgba(79,142,247,0.55);
  box-shadow: 0 20px 60px rgba(79,142,247,0.18), 0 8px 24px rgba(0,0,0,0.45);
}
.tool-card.tc-green:hover {
  transform: translateY(-8px) scale(1.012);
  border-color: rgba(52,209,122,0.55);
  box-shadow: 0 20px 60px rgba(52,209,122,0.15), 0 8px 24px rgba(0,0,0,0.45);
}
.tool-card.tc-purple:hover {
  transform: translateY(-8px) scale(1.012);
  border-color: rgba(124,92,252,0.55);
  box-shadow: 0 20px 60px rgba(124,92,252,0.18), 0 8px 24px rgba(0,0,0,0.45);
}
/* press/active feedback */
.tool-card:active {
  transform: translateY(-2px) scale(0.99) !important;
  box-shadow: 0 4px 16px rgba(0,0,0,0.35) !important;
  transition-duration: 0.08s !important;
}
/* staggered entrance */
@keyframes cardIn {
  from { opacity:0; transform: translateY(28px); }
  to   { opacity:1; transform: translateY(0); }
}
.tool-card:nth-child(1) { animation: cardIn 0.45s cubic-bezier(0.4,0,0.2,1) 0.25s both; }
.tool-card:nth-child(2) { animation: cardIn 0.45s cubic-bezier(0.4,0,0.2,1) 0.35s both; }
.tool-card:nth-child(3) { animation: cardIn 0.45s cubic-bezier(0.4,0,0.2,1) 0.45s both; }

/* icon */
.tc-icon {
  width: 52px; height: 52px; border-radius: 15px;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px; margin-bottom: 16px; flex-shrink: 0;
  transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1);
}
.tool-card:hover .tc-icon { transform: scale(1.12); }
.tc-icon-blue  { background: linear-gradient(135deg, rgba(79,142,247,0.22), rgba(124,92,252,0.16)); border: 1px solid rgba(79,142,247,0.28); }
.tc-icon-green { background: linear-gradient(135deg, rgba(52,209,122,0.18), rgba(34,181,192,0.12)); border: 1px solid rgba(52,209,122,0.24); }
.tc-icon-purple{ background: linear-gradient(135deg, rgba(124,92,252,0.20), rgba(224,64,251,0.12)); border: 1px solid rgba(124,92,252,0.24); }

/* badge tag */
.tc-tag {
  display: inline-flex; align-items: center;
  padding: 3px 10px; border-radius: 99px; margin-bottom: 10px;
  font-size: 9.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
}
.tc-tag-blue   { background: var(--primary-dim); color: var(--primary); border: 1px solid rgba(79,142,247,0.22); }
.tc-tag-green  { background: rgba(52,209,122,0.09); color: var(--success); border: 1px solid rgba(52,209,122,0.18); }
.tc-tag-purple { background: rgba(124,92,252,0.11); color: #b39dfa; border: 1px solid rgba(124,92,252,0.20); }

.tc-title {
  font-size: 17px; font-weight: 700; color: var(--text);
  margin-bottom: 9px; letter-spacing: -0.3px;
}
.tc-desc {
  font-size: 13px; color: var(--text-2); line-height: 1.62;
  margin-bottom: 18px;
}
.tc-features {
  list-style: none; display: flex; flex-direction: column; gap: 8px;
  margin-bottom: 20px; flex: 1;
}
.tc-features li {
  font-size: 12.5px; color: var(--text-2);
  display: flex; align-items: flex-start; gap: 9px; line-height: 1.45;
}
.tc-features li::before {
  content: '✓'; font-size: 10.5px; font-weight: 800;
  flex-shrink: 0; margin-top: 2px;
}
.tool-card.tc-blue   .tc-features li::before { color: var(--primary); }
.tool-card.tc-green  .tc-features li::before { color: var(--success); }
.tool-card.tc-purple .tc-features li::before { color: #b39dfa; }

/* CTA footer inside card */
.tc-cta {
  display: flex; align-items: center; justify-content: space-between;
  padding-top: 18px; margin-top: auto;
  border-top: 1px solid var(--glass-border);
}
.tc-cta-text {
  font-size: 13px; font-weight: 700;
  transition: color 0.18s ease;
}
.tool-card.tc-blue   .tc-cta-text { color: var(--primary); }
.tool-card.tc-green  .tc-cta-text { color: var(--success); }
.tool-card.tc-purple .tc-cta-text { color: #b39dfa; }

.tc-cta-arrow {
  width: 30px; height: 30px; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 700;
  transition: transform 0.22s cubic-bezier(0.34,1.56,0.64,1), background 0.18s ease;
}
.tool-card.tc-blue   .tc-cta-arrow { background: var(--primary-dim); color: var(--primary); }
.tool-card.tc-green  .tc-cta-arrow { background: rgba(52,209,122,0.10); color: var(--success); }
.tool-card.tc-purple .tc-cta-arrow { background: rgba(124,92,252,0.10); color: #b39dfa; }
.tool-card:hover .tc-cta-arrow { transform: translateX(5px); }

/* ── How it works ─────────────────────────────────────────────────────── */
.hw-section { width: 100%; margin-bottom: 52px; }
.hw-section-title {
  font-size: 24px; font-weight: 800; letter-spacing: -0.5px;
  text-align: center; margin-bottom: 32px; color: var(--text);
}
.hw-steps {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
}
@media (max-width: 700px) { .hw-steps { grid-template-columns: repeat(2, 1fr); } }
.hw-step {
  background: var(--surface); border: 1px solid var(--glass-border);
  border-radius: var(--r-lg); padding: 24px 18px 22px;
  text-align: center; backdrop-filter: blur(16px);
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}
.hw-step:hover { border-color: rgba(79,142,247,0.25); box-shadow: var(--shadow); transform: translateY(-3px); }
.hw-step-num {
  width: 34px; height: 34px; border-radius: 50%;
  background: linear-gradient(135deg, var(--primary), var(--accent));
  color: #fff; font-size: 13px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 14px; box-shadow: 0 3px 10px var(--primary-glow);
}
.hw-step-icon { font-size: 28px; margin-bottom: 12px; }
.hw-step-ttl { font-size: 14px; font-weight: 700; color: var(--text); margin-bottom: 8px; }
.hw-step-txt { font-size: 12px; color: var(--text-2); line-height: 1.6; }

/* ── Decision guide ──────────────────────────────────────────────────── */
.decision-grid {
  display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; width: 100%;
}
@media (max-width: 740px) { .decision-grid { grid-template-columns: 1fr; } }
.decision-card {
  background: var(--surface); border: 1px solid var(--glass-border);
  border-radius: var(--r-lg); padding: 24px 20px 22px;
  display: flex; flex-direction: column; gap: 12px;
  backdrop-filter: blur(16px);
  transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}
.decision-card:hover { border-color: rgba(79,142,247,0.25); box-shadow: var(--shadow); transform: translateY(-3px); }
.decision-q {
  font-size: 13.5px; font-weight: 600; color: var(--text); line-height: 1.5;
  min-height: 52px;
}
.decision-arrow {
  font-size: 20px; color: var(--text-3); text-align: center; line-height: 1;
}
.decision-a {
  display: flex; flex-direction: column; gap: 7px;
  padding: 14px 16px; border-radius: var(--r-md); border: 1px solid transparent;
}
.tc-blue-a   { background: var(--primary-dim); border-color: rgba(79,142,247,0.20); }
.tc-green-a  { background: rgba(52,209,122,0.08); border-color: rgba(52,209,122,0.18); }
.tc-purple-a { background: rgba(124,92,252,0.09); border-color: rgba(124,92,252,0.18); }
.decision-tool {
  font-size: 13px; font-weight: 700; letter-spacing: -.1px;
}
.tc-blue-a   .decision-tool { color: var(--primary); }
.tc-green-a  .decision-tool { color: var(--success); }
.tc-purple-a .decision-tool { color: #b39dfa; }
.decision-hint {
  font-size: 12px; color: var(--text-2); line-height: 1.55;
}

/* ── Comparison table ─────────────────────────────────────────────────── */
.cmp-section { width: 100%; margin-bottom: 44px; }
.cmp-table {
  width: 100%; border-collapse: collapse;
  background: var(--surface); border: 1px solid var(--glass-border);
  border-radius: var(--r-lg); overflow: hidden; backdrop-filter: blur(16px);
  font-size: 13px; box-shadow: var(--shadow);
}
.cmp-table th {
  padding: 15px 18px; text-align: center;
  font-size: 11.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
  border-bottom: 1px solid var(--glass-border);
  background: rgba(255,255,255,0.03);
}
.cmp-table th:first-child { text-align: left; color: var(--text-3); }
.cmp-table td {
  padding: 13px 18px; text-align: center;
  border-bottom: 1px solid rgba(255,255,255,0.04); color: var(--text-2);
}
.cmp-table td:first-child { text-align: left; color: var(--text); font-weight: 500; }
.cmp-table tr:last-child td { border-bottom: none; }
.cmp-table tr:hover td { background: var(--glass-hover); }
.cmp-best   { color: var(--primary); font-weight: 700; }
.cmp-ok     { color: var(--success); font-weight: 600; }
.cmp-manual { color: var(--warn); font-weight: 600; }
.cmp-none   { color: var(--text-3); }
.cmp-th-blue   { color: var(--primary) !important; }
.cmp-th-green  { color: var(--success) !important; }
.cmp-th-purple { color: #b39dfa !important; }

