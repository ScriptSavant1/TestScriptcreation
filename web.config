<?xml version="1.0" encoding="utf-8"?>
<!--
  LRE Toolkit — IIS + iisnode configuration
  Physical path  : D:\MSINetData\WWW\converter
  Node entry     : app.js  (thin wrapper → src/web/server.js)
  Requires       : iisnode, URL Rewrite Module 2.1
-->
<configuration>
  <system.webServer>

    <!-- ═══════════════════════════════════════════════════════════════
         iisnode handler — REQUIRED. Registers iisnode to intercept
         all requests matched by the rewrite rules below.
    ═══════════════════════════════════════════════════════════════ -->
    <handlers>
      <add name="iisnode"
           path="app.js"
           verb="*"
           modules="iisnode" />
    </handlers>

    <!-- ═══════════════════════════════════════════════════════════════
         URL Rewrite — route all requests through app.js (Node.js).
         Express handles its own static file serving from /public/.
    ═══════════════════════════════════════════════════════════════ -->
    <rewrite>
      <rules>
        <!-- Route everything to the Node.js entry point.
             Conditions ensure physical files/directories are not
             accidentally rewritten (e.g. if IIS serves any statics). -->
        <rule name="NodeApp" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile"      negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory"  negate="true" />
          </conditions>
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- ═══════════════════════════════════════════════════════════════
         iisnode settings

         nodeProcessCountPerApplication="1"
           CRITICAL — must stay at 1.  The app stores download tokens
           in an in-memory Map (pendingDownloads).  With multiple
           processes a Convert request could land on process 1 but the
           Download request on process 2, which has no such token
           ("Download link expired").  Node.js async/await handles
           concurrent users within a single process.

         devErrorsEnabled="false"
           Never expose Node.js stack traces in production responses.

         gracefulShutdownTimeOut="60000"
           Give in-flight conversions 60 s to complete before the
           worker is recycled (e.g. on web.config change).
    ═══════════════════════════════════════════════════════════════ -->
    <iisnode
      node_env="production"
      nodeProcessCommandLine="node.exe"
      nodeProcessCountPerApplication="1"
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"
      maxNamedPipeConnectionPoolSize="512"
      maxNamedPipePooledConnectionAge="30000"
      asyncCompletionThreadCount="0"
      initialRequestBufferSize="4096"
      maxRequestBufferSize="65536"
      loggingEnabled="true"
      logDirectory="logs"
      maxLogFileSizeInKB="2048"
      maxTotalLogFileSizeInKB="20480"
      maxLogFiles="10"
      devErrorsEnabled="false"
      watchedFiles="web.config"
      gracefulShutdownTimeOut="60000"
    />

    <!-- ═══════════════════════════════════════════════════════════════
         Pass Node.js HTTP responses through unchanged.
         Without this, IIS replaces 4xx/5xx responses with its own
         HTML error pages — breaking the JSON error format the browser
         expects from the /convert and /convert-jmx API endpoints.
    ═══════════════════════════════════════════════════════════════ -->
    <httpErrors existingResponse="PassThrough" />

    <!-- ═══════════════════════════════════════════════════════════════
         Upload size limit — IIS-level gate (before Node.js / multer).
         104857600 = 100 MB.  Covers large HAR files, JMX test plans,
         and collections with many CSV/certificate attachments.
         If IIS rejects a request here it returns HTTP 404.13 before
         Node.js even sees the request.
    ═══════════════════════════════════════════════════════════════ -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="logs" />
          <add segment="test" />
          <add segment="uploads" />
          <add segment="output" />
          <add segment="devweb-prompts" />
          <add segment="collection-examples" />
          <add segment="examples" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
